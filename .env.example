# ============================================================
# FreeX 环境变量模板
# 复制为 .env.local 并填入真实值
# .env.local 不会被提交到 GitHub
# ============================================================

# ---------- Supabase（必填，用于动态数据） ----------
# 在 Supabase Dashboard → Project Settings → API 中获取
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key（仅服务端使用，禁止暴露给浏览器）
# 如需服务端管理操作（如数据导入脚本），在此配置
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- 站点配置（可选） ----------
# 站点 URL（用于 sitemap / RSS / OG）
SITE_URL=https://www.52798.xyz

# ---------- 已废弃（管理员面板已撤销，保留为空即可） ----------
GITHUB_TOKEN=
ADMIN_PASSWORD=
