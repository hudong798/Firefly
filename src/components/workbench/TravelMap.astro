---
// 中国旅行星图 / China Travel Observatory
import { travelPoints, travelStats, travelYears, statsForYear, type TravelPoint } from "@/data/travelPoints";
import { CHINA_MAP_PATH } from "@/data/chinaMapPath";

// ===== 校准后的投影参数（等积圆锥投影近似，依据 china_outline.svg 大陆四至，19 城验证）=====
const VIEW_W = 980;
const VIEW_H = 1125;
const P_X0 = 26.0, P_SX = 15.065;  // x = P_X0 + (lng - 73.5) * P_SX
const P_Y0 = 26.0, P_SY = 23.244;  // y = P_Y0 + (53.6 - lat) * P_SY
const LNG_WEST = 73.5, LAT_NORTH = 53.6;

function project(lng: number, lat: number) {
	return {
		x: P_X0 + (lng - LNG_WEST) * P_SX,
		y: P_Y0 + (LAT_NORTH - lat) * P_SY,
	};
}

const domesticPoints = travelPoints.filter(p => p.isDomestic);
const foreignPoints = travelPoints.filter(p => !p.isDomestic);

// 预计算国内点坐标；同一篇文章的首个点作为「重点星」
const articleFirstPoint = new Map<string, string>();
domesticPoints.forEach(p => {
	if (p.articleSlug && !articleFirstPoint.has(p.articleSlug)) {
		articleFirstPoint.set(p.articleSlug, p.id);
	}
});

// 按文章分组轨迹线（国内）
const articleGroups = new Map<string, TravelPoint[]>();
domesticPoints.forEach(p => {
	if (!p.articleSlug) return;
	const arr = articleGroups.get(p.articleSlug) || [];
	arr.push(p);
	articleGroups.set(p.articleSlug, arr);
});

---

<div class="tmap" id="travel-map">
	<!-- 左侧信息栏 -->
	<aside class="tmap-sidebar">
		<div class="tmap-sidebar-label">
			<span class="tmap-sidebar-dot"></span>
			TRAVEL OBSERVATORY
		</div>
		<h2 class="tmap-sidebar-title">MY JOURNEY</h2>
		<p class="tmap-sidebar-sub">走过的地方，<br/>最终都会成为记忆的一部分。</p>

		<!-- 统计（随年份联动） -->
		<div class="tmap-sidebar-stats" id="tmap-stats">
			<div class="tmap-stat">
				<span class="tmap-stat-num" id="stat-journeys">{String(travelStats.journeys).padStart(2, "0")}</span>
				<span class="tmap-stat-label">JOURNEYS</span>
			</div>
			<div class="tmap-stat">
				<span class="tmap-stat-num" id="stat-cities">{String(travelStats.cities).padStart(2, "0")}</span>
				<span class="tmap-stat-label">DESTINATIONS</span>
			</div>
			<div class="tmap-stat">
				<span class="tmap-stat-num" id="stat-provinces">{String(travelStats.provinces).padStart(2, "0")}</span>
				<span class="tmap-stat-label">PROVINCES</span>
			</div>
			<div class="tmap-stat">
				<span class="tmap-stat-num">{travelStats.yearRange}</span>
				<span class="tmap-stat-label">ACTIVE YEARS</span>
			</div>
		</div>

		<!-- 年份过滤器 -->
		<div class="tmap-filter">
			<div class="tmap-filter-label">FILTER BY YEAR</div>
			<div class="tmap-filter-btns">
				<button class="tmap-filter-btn active" data-year="all">ALL</button>
				{travelYears.map(y => (
					<button class="tmap-filter-btn" data-year={y}>{y}</button>
				))}
			</div>
		</div>

		<!-- 国外地点 -->
		<div class="tmap-foreign" data-foreign>
			<div class="tmap-foreign-title">INTERNATIONAL</div>
			{foreignPoints.map(p => (
				<button class="tmap-foreign-item" data-point={p.id} data-year={p.date?.split(".")[0]}>
					<span class="tmap-foreign-dot"></span>
					<span class="tmap-foreign-name">{p.name}</span>
					<span class="tmap-foreign-country">{p.country}</span>
				</button>
			))}
		</div>
	</aside>

	<!-- 地图区域 -->
	<div class="tmap-stage" id="tmap-stage">
		<!-- 左上角观测信息 -->
		<div class="tmap-obs">
			<div>FIELD / CN</div>
			<div>LAT 35°N · LNG 105°E</div>
			<div>SECTOR 04 · SIGNAL ACTIVE</div>
		</div>

		<!-- 右上角缩放控制 -->
		<div class="tmap-zoom">
			<button class="tmap-zoom-btn" id="tmap-zoom-in" aria-label="放大">+</button>
			<button class="tmap-zoom-btn" id="tmap-zoom-out" aria-label="缩小">−</button>
			<button class="tmap-zoom-btn" id="tmap-zoom-reset" aria-label="重置视图">⌂</button>
		</div>

		<svg class="tmap-svg" id="tmap-svg" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="xMidYMid meet">
			<defs>
				<radialGradient id="tmap-glow" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#9B8CFF" stop-opacity="0.55" />
					<stop offset="55%" stop-color="#9B8CFF" stop-opacity="0.14" />
					<stop offset="100%" stop-color="#9B8CFF" stop-opacity="0" />
				</radialGradient>
				<radialGradient id="tmap-glow-cyan" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="#63D8FF" stop-opacity="0.5" />
					<stop offset="100%" stop-color="#63D8FF" stop-opacity="0" />
				</radialGradient>
			</defs>

			<!-- 中国省级地图（完整轮廓） -->
			<path d={CHINA_MAP_PATH} class="tmap-china" />

			<!-- 轨迹线（同一次旅行的城市相连） -->
			{
				Array.from(articleGroups.entries()).map(([slug, points]) => {
					if (points.length < 2) return null;
					const coords = points.map(p => project(p.lng, p.lat));
					let d = `M ${coords[0].x.toFixed(1)},${coords[0].y.toFixed(1)}`;
					for (let i = 1; i < coords.length; i++) {
						const prev = coords[i - 1];
						const curr = coords[i];
						const mx = (prev.x + curr.x) / 2;
						const my = (prev.y + curr.y) / 2 - 14;
						d += ` Q ${mx.toFixed(1)},${my.toFixed(1)} ${curr.x.toFixed(1)},${curr.y.toFixed(1)}`;
					}
					const year = points[0].date?.split(".")[0] || "";
					return <path d={d} class="tmap-route" data-article={slug} data-year={year} />;
				})
			}

			<!-- 国内坐标星点 -->
			{
				domesticPoints.map((p, i) => {
					const { x, y } = project(p.lng, p.lat);
					const year = p.date?.split(".")[0] || "";
					const isMajor = articleFirstPoint.get(p.articleSlug || "") === p.id;
					return (
						<g
							class:list={["tmap-point", { "is-major": isMajor }]}
							data-point={p.id}
							data-year={year}
							style={`animation-delay:${(0.25 + i * 0.12).toFixed(2)}s`}
						>
							<circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={isMajor ? 20 : 14} fill="url(#tmap-glow)" class="tmap-point-halo" />
							<circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="9" fill="none" stroke="#9B8CFF" stroke-width="0.6" opacity="0" class="tmap-point-ring" />
							<circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={isMajor ? 3.4 : 2.4} fill="#E8E4FF" class="tmap-point-core" />
							<text x={(x + 11).toFixed(1)} y={(y + 3.5).toFixed(1)} class="tmap-point-name">{p.name}</text>
						</g>
					);
				})
			}
		</svg>

		<!-- 空状态 -->
		<div class="tmap-empty" id="tmap-empty" hidden>
			<div class="tmap-empty-dot"></div>
			<div class="tmap-empty-en">NO JOURNEY RECORDED</div>
			<div class="tmap-empty-cn">这一年还没有留下轨迹</div>
		</div>

		<!-- Hover 观测数据面板 -->
		<div class="tmap-hover" id="tmap-hover" hidden>
			<div class="tmap-hover-header">
				<span class="tmap-hover-en" id="th-en"></span>
				<span class="tmap-hover-coord" id="th-coord"></span>
			</div>
			<div class="tmap-hover-name" id="th-name"></div>
			<div class="tmap-hover-date" id="th-date"></div>
			<div class="tmap-hover-article" id="th-article"></div>
			<div class="tmap-hover-hint">CLICK TO FOCUS →</div>
		</div>

		<!-- 详情面板（桌面右侧滑出 / 移动底部 Sheet） -->
		<div class="tmap-detail" id="tmap-detail" hidden>
			<div class="tmap-detail-head">
				<div>
					<div class="tmap-detail-en" id="td-en"></div>
					<div class="tmap-detail-city" id="td-city"></div>
					<div class="tmap-detail-coord" id="td-coord"></div>
				</div>
				<button class="tmap-detail-close" id="td-close" aria-label="关闭">×</button>
			</div>
			<div class="tmap-detail-date" id="td-date"></div>
			<div class="tmap-detail-cover" id="td-cover-wrap" hidden>
				<img id="td-cover" src="" alt="" loading="lazy" />
			</div>
			<div class="tmap-detail-title" id="td-title"></div>
			<div class="tmap-detail-summary" id="td-summary"></div>
			<div class="tmap-detail-tags" id="td-tags"></div>
			<a class="tmap-detail-btn" id="td-link" href="#">VIEW JOURNEY →</a>
		</div>
	</div>
</div>

<script is:inline define:vars={{ travelPoints, VIEW_W, VIEW_H, P_X0, P_SX, P_Y0, P_SY, LNG_WEST, LAT_NORTH }}>
(function () {
	const svg = document.getElementById("tmap-svg");
	const stage = document.getElementById("tmap-stage");
	const hoverEl = document.getElementById("tmap-hover");
	const detailEl = document.getElementById("tmap-detail");
	const emptyEl = document.getElementById("tmap-empty");
	if (!svg || !stage) return;

	// 客户端投影（与服务端一致）
	function project(lng, lat) {
		return {
			x: P_X0 + (lng - LNG_WEST) * P_SX,
			y: P_Y0 + (LAT_NORTH - lat) * P_SY,
		};
	}

	// ===== 视图状态（viewBox） =====
	const MIN_K = 0.9, MAX_K = 6;                 // 缩放倍数范围
	let k = 1;                                     // 当前缩放
	let vb = { x: 0, y: 0, w: VIEW_W, h: VIEW_H }; // 当前 viewBox
	let selectedId = null;
	let currentYear = "all";
	let rafId = null;

	function clampView() {
		// 完整视图时居中铺满；放大后限制不拖出地图
		vb.w = VIEW_W / k;
		vb.h = VIEW_H / k;
		vb.x = Math.max(0, Math.min(VIEW_W - vb.w, vb.x));
		vb.y = Math.max(0, Math.min(VIEW_H - vb.h, vb.y));
	}
	function applyView(animate) {
		clampView();
		if (animate) {
			svg.style.transition = "viewBox 0.55s cubic-bezier(0.16,1,0.3,1)";
			setTimeout(() => { svg.style.transition = ""; }, 600);
		}
		svg.setAttribute("viewBox", `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
	}
	function scheduleView() {
		if (rafId) return;
		rafId = requestAnimationFrame(() => { rafId = null; applyView(false); });
	}
	function resetView(animate) {
		k = 1;
		vb = { x: 0, y: 0, w: VIEW_W, h: VIEW_H };
		applyView(animate !== false);
	}
	function zoomAt(factor, cx, cy) {
		const newK = Math.max(MIN_K, Math.min(MAX_K, k * factor));
		if (newK === k) return;
		// 以 (cx,cy) 世界坐标为锚点缩放
		const wx = vb.x + (cx) * vb.w;
		const wy = vb.y + (cy) * vb.h;
		k = newK;
		vb.w = VIEW_W / k; vb.h = VIEW_H / k;
		vb.x = wx - cx * vb.w;
		vb.y = wy - cy * vb.h;
		applyView(false);
	}

	// ===== 年份筛选（联动点/路线/国外列表/统计） =====
	const statsAll = (function () {
		const d = travelPoints.filter(p => p.isDomestic);
		return {
			journeys: new Set(travelPoints.map(p => p.articleSlug).filter(Boolean)).size,
			cities: travelPoints.length,
			provinces: new Set(d.map(p => p.province)).size,
		};
	})();
	function calcStats(year) {
		const list = year === "all" ? travelPoints : travelPoints.filter(p => (p.date || "").startsWith(year));
		const d = list.filter(p => p.isDomestic);
		return {
			journeys: new Set(list.map(p => p.articleSlug).filter(Boolean)).size,
			cities: list.length,
			provinces: new Set(d.map(p => p.province)).size,
		};
	}
	function setStat(id, val) {
		const el = document.getElementById(id);
		if (el) el.textContent = typeof val === "number" ? String(val).padStart(2, "0") : val;
	}
	function applyFilter(year) {
		currentYear = year;
		document.querySelectorAll(".tmap-filter-btn").forEach(b => {
			b.classList.toggle("active", b.getAttribute("data-year") === year);
		});
		let visibleDomestic = 0;
		document.querySelectorAll(".tmap-point").forEach(g => {
			const show = year === "all" || g.getAttribute("data-year") === year;
			g.classList.toggle("tmap-hidden", !show);
			if (show) visibleDomestic++;
		});
		document.querySelectorAll(".tmap-route").forEach(r => {
			const show = year === "all" || r.getAttribute("data-year") === year;
			r.classList.toggle("tmap-hidden", !show);
			r.classList.remove("route-active");
		});
		document.querySelectorAll(".tmap-foreign-item").forEach(it => {
			const show = year === "all" || it.getAttribute("data-year") === year;
			it.style.display = show ? "" : "none";
		});
		// 联动统计
		const s = year === "all" ? statsAll : calcStats(year);
		setStat("stat-journeys", s.journeys);
		setStat("stat-cities", s.cities);
		setStat("stat-provinces", s.provinces);
		// 空状态（国内无点且国外无可见项）
		const foreignVisible = Array.from(document.querySelectorAll(".tmap-foreign-item"))
			.some(it => it.style.display !== "none");
		if (emptyEl) emptyEl.hidden = (visibleDomestic > 0 || foreignVisible);
		// 清除选中
		clearSelection();
		resetView(true);
	}

	// ===== Hover 面板 =====
	function showHover(point, clientX, clientY) {
		if (!hoverEl) return;
		document.getElementById("th-en").textContent = (point.name || "").toUpperCase();
		document.getElementById("th-coord").textContent = `${point.lat.toFixed(2)}°N ${point.lng.toFixed(2)}°E`;
		document.getElementById("th-name").textContent = point.name;
		document.getElementById("th-date").textContent = point.date || "";
		document.getElementById("th-article").textContent = point.articleTitle || "";
		hoverEl.hidden = false;
		const rect = stage.getBoundingClientRect();
		const px = clientX - rect.left, py = clientY - rect.top;
		const w = 190;
		hoverEl.style.left = Math.min(px + 16, rect.width - w - 8) + "px";
		hoverEl.style.top = Math.max(Math.min(py - 50, rect.height - 150), 8) + "px";
	}
	function hideHover() { if (hoverEl) hoverEl.hidden = true; }

	// ===== 选中聚焦 + 详情 =====
	function clearSelection() {
		selectedId = null;
		document.querySelectorAll(".tmap-point").forEach(g => {
			g.classList.remove("is-selected");
			g.style.opacity = "";
		});
		if (detailEl) detailEl.hidden = true;
		document.querySelectorAll(".tmap-route").forEach(r => r.classList.remove("route-active"));
	}
	function focusOn(point) {
		selectedId = point.id;
		if (point.isDomestic) {
			const { x, y } = project(point.lng, point.lat);
			const targetK = Math.max(k, 2.4);
			k = targetK;
			vb.w = VIEW_W / k; vb.h = VIEW_H / k;
			vb.x = x - vb.w / 2; vb.y = y - vb.h / 2;
			applyView(true);
			document.querySelectorAll(".tmap-point").forEach(g => {
				const match = g.getAttribute("data-point") === point.id;
				g.classList.toggle("is-selected", match);
				g.style.opacity = match ? "" : "0.25";
			});
			if (point.articleSlug) {
				document.querySelectorAll(".tmap-route").forEach(r => {
					if (r.getAttribute("data-article") === point.articleSlug) {
						setTimeout(() => r.classList.add("route-active"), 250);
					}
				});
			}
		}
		showDetail(point);
	}
	function showDetail(point) {
		if (!detailEl) return;
		document.getElementById("td-en").textContent = `${(point.name||"").toUpperCase()} · ${(point.province||"").toUpperCase()}`;
		document.getElementById("td-city").textContent = point.name;
		document.getElementById("td-coord").textContent = `${point.lat.toFixed(4)}° N · ${point.lng.toFixed(4)}° E`;
		document.getElementById("td-date").textContent = point.date || "";
		document.getElementById("td-title").textContent = point.articleTitle || "";
		document.getElementById("td-summary").textContent = point.summary || "";
		const coverWrap = document.getElementById("td-cover-wrap");
		const cover = document.getElementById("td-cover");
		if (point.cover) { cover.src = point.cover; coverWrap.hidden = false; }
		else { coverWrap.hidden = true; }
		document.getElementById("td-tags").innerHTML = (point.tags || [])
			.map(t => `<span class="tmap-detail-tag">#${t}</span>`).join("");
		const link = document.getElementById("td-link");
		if (point.articleSlug) {
			link.href = `/travel/${point.articleSlug}/`;
			link.style.display = "";
		} else { link.style.display = "none"; }
		detailEl.hidden = false;
	}

	// ===== 鼠标：拖拽平移 + 滚轮缩放 =====
	let dragging = false, moved = false, startX = 0, startY = 0, startVbX = 0, startVbY = 0;
	function clientToSvgRatio(e) {
		const r = svg.getBoundingClientRect();
		// preserveAspectRatio meet：计算实际地图显示区域
		const scale = Math.min(r.width / VIEW_W, r.height / VIEW_H);
		const dispW = VIEW_W * scale, dispH = VIEW_H * scale;
		const offX = (r.width - dispW) / 2, offY = (r.height - dispH) / 2;
		const px = (e.clientX - r.left - offX) / dispW;
		const py = (e.clientY - r.top - offY) / dispH;
		return { px: Math.max(0, Math.min(1, px)), py: Math.max(0, Math.min(1, py)) };
	}
	stage.addEventListener("mousedown", (e) => {
		if (e.target.closest(".tmap-point") || e.target.closest(".tmap-zoom-btn") ||
			e.target.closest(".tmap-detail") || e.target.closest(".tmap-foreign-item")) return;
		dragging = true; moved = false;
		startX = e.clientX; startY = e.clientY;
		startVbX = vb.x; startVbY = vb.y;
		stage.style.cursor = "grabbing";
	});
	window.addEventListener("mousemove", (e) => {
		if (dragging) {
			const dx = e.clientX - startX, dy = e.clientY - startY;
			if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
			const r = svg.getBoundingClientRect();
			const scale = Math.min(r.width / VIEW_W, r.height / VIEW_H);
			const dispW = VIEW_W * scale;
			vb.x = startVbX - (dx / dispW) * vb.w;
			vb.y = startVbY - (dy / (VIEW_H * scale)) * vb.h;
			scheduleView();
		}
	});
	window.addEventListener("mouseup", () => {
		if (dragging) { dragging = false; stage.style.cursor = ""; }
	});
	// 滚轮缩放（以光标为锚点）
	stage.addEventListener("wheel", (e) => {
		if (e.target.closest(".tmap-detail")) return;
		e.preventDefault();
		const { px, py } = clientToSvgRatio(e);
		zoomAt(e.deltaY < 0 ? 1.18 : 1 / 1.18, px, py);
	}, { passive: false });

	// ===== 触摸：单指拖动 + 双指缩放 =====
	let touches = [], pinchDist = 0;
	stage.addEventListener("touchstart", (e) => {
		touches = Array.from(e.touches);
		if (touches.length === 2) pinchDist = Math.hypot(
			touches[0].clientX - touches[1].clientX, touches[0].clientY - touches[1].clientY);
	}, { passive: true });
	stage.addEventListener("touchmove", (e) => {
		if (e.touches.length === 1 && !e.target.closest(".tmap-detail")) {
			const t = e.touches[0], s = touches[0];
			if (s) {
				const r = svg.getBoundingClientRect();
				const scale = Math.min(r.width / VIEW_W, r.height / VIEW_H);
				vb.x -= ((t.clientX - s.clientX) / (VIEW_W * scale)) * vb.w;
				vb.y -= ((t.clientY - s.clientY) / (VIEW_H * scale)) * vb.h;
				scheduleView();
			}
			touches = Array.from(e.touches);
		} else if (e.touches.length === 2) {
			const d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,
				e.touches[0].clientY - e.touches[1].clientY);
			if (pinchDist) {
				const mid = { clientX: (e.touches[0].clientX + e.touches[1].clientX) / 2,
					clientY: (e.touches[0].clientY + e.touches[1].clientY) / 2 };
				const { px, py } = clientToSvgRatio(mid);
				zoomAt(d / pinchDist, px, py);
			}
			pinchDist = d;
		}
	}, { passive: true });
	stage.addEventListener("touchend", (e) => { touches = Array.from(e.touches); pinchDist = 0; }, { passive: true });

	// ===== 事件委托：点击 / hover =====
	stage.addEventListener("click", (e) => {
		if (moved) { moved = false; return; }
		const g = e.target.closest(".tmap-point");
		if (g && !g.classList.contains("tmap-hidden")) {
			const p = travelPoints.find(x => x.id === g.getAttribute("data-point"));
			if (p) focusOn(p);
			return;
		}
		if (e.target.closest("#td-close")) { clearSelection(); resetView(true); return; }
		if (e.target.closest("#tmap-zoom-in")) { zoomAt(1.3, 0.5, 0.5); return; }
		if (e.target.closest("#tmap-zoom-out")) { zoomAt(1 / 1.3, 0.5, 0.5); return; }
		if (e.target.closest("#tmap-zoom-reset")) { clearSelection(); resetView(true); return; }
		// 点击地图空白处取消选中
		if (e.target === svg || e.target.classList.contains("tmap-china")) {
			clearSelection(); resetView(true);
		}
	});
	// 侧边栏（在 stage 外）单独委托
	document.getElementById("travel-map").addEventListener("click", (e) => {
		const btn = e.target.closest(".tmap-filter-btn");
		if (btn) { applyFilter(btn.getAttribute("data-year") || "all"); return; }
		const fi = e.target.closest(".tmap-foreign-item");
		if (fi) {
			const p = travelPoints.find(x => x.id === fi.getAttribute("data-point"));
			if (p) showDetail(p);
		}
	});
	stage.addEventListener("mousemove", (e) => {
		const g = e.target.closest(".tmap-point");
		if (g && !g.classList.contains("tmap-hidden")) {
			const p = travelPoints.find(x => x.id === g.getAttribute("data-point"));
			if (p) { stage.style.cursor = "pointer"; showHover(p, e.clientX, e.clientY); return; }
		}
		if (!dragging) { stage.style.cursor = ""; hideHover(); }
	});
	stage.addEventListener("mouseleave", hideHover);

	// 初始化
	resetView(false);
})();
</script>

