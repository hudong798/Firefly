---
// 行式链接列表：图标 + 名称 + 描述 + 分类徽章 + 箭头（一排一排展示）
import { Icon } from "astro-icon/components";

interface LinkItem {
	name: string;
	icon: string;
	desc?: string;
	cat?: string;
	url: string;
}

interface Props {
	items: LinkItem[];
}

const { items } = Astro.props;
---

<div class="link-rows card-base rounded-[var(--radius-large)] overflow-hidden">
	{
		items.map((item) => (
			<a
				class="link-row"
				href={item.url}
				target="_blank"
				rel="noopener noreferrer"
			>
				<span class="link-icon">{item.icon}</span>
				<span class="link-main">
					<span class="link-title">
						{item.name}
						{item.cat && <span class="link-cat">{item.cat}</span>}
					</span>
					{item.desc && <span class="link-desc">{item.desc}</span>}
				</span>
				<span class="link-arrow">
					<Icon name="material-symbols:chevron-right-rounded" />
				</span>
			</a>
		))
	}
</div>

<style>
	.link-rows {
		display: flex;
		flex-direction: column;
	}

	.link-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 1.5rem;
		text-decoration: none;
		color: inherit;
		transition: background 0.2s ease;
		position: relative;
	}

	/* 行间分隔线 */
	.link-row:not(:last-child)::after {
		content: "";
		position: absolute;
		left: 1.5rem;
		right: 1.5rem;
		bottom: 0;
		height: 1px;
		background: var(--line-divider);
		opacity: 0.6;
	}

	.link-row:hover {
		background: var(--btn-plain-bg-hover);
	}

	.link-row:active {
		background: var(--btn-plain-bg-active);
	}

	.link-icon {
		flex-shrink: 0;
		width: 2.4rem;
		height: 2.4rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
		border-radius: 0.7rem;
		background: var(--btn-regular-bg);
	}

	.link-main {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.link-title {
		font-weight: 700;
		font-size: 0.98rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		transition: color 0.2s ease;
	}

	.link-row:hover .link-title {
		color: var(--primary);
	}

	.link-cat {
		font-size: 0.68rem;
		font-weight: 500;
		padding: 0.08rem 0.5rem;
		border-radius: 999px;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 14%, transparent);
	}

	.link-desc {
		font-size: 0.8rem;
		color: var(--content-meta);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.link-arrow {
		flex-shrink: 0;
		color: var(--content-meta);
		font-size: 1.6rem;
		display: flex;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.link-row:hover .link-arrow {
		color: var(--primary);
		transform: translateX(2px);
	}

	@media (max-width: 768px) {
		.link-row {
			padding: 0.8rem 1rem;
			gap: 0.75rem;
		}

		.link-row:not(:last-child)::after {
			left: 1rem;
			right: 1rem;
		}
	}
</style>
