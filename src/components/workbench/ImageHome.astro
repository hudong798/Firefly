---
// 首页舞台：黑蓝深海液态玻璃背景（已下架壁纸）
// 背景由 glass-theme.css 中的 wb-shell 液态玻璃渐变 + 动态光斑提供，
// 这里叠加 ASCII 原子像素装饰与中央弹出文字。
import { profileConfig } from "@/config";

// ASCII 原子像素装饰元素（前景点缀）
const asciiAtoms = [
	{ glyph: "◌", x: "8%", y: "22%", size: "2.4rem", delay: "0s" },
	{ glyph: "✦", x: "90%", y: "18%", size: "1.8rem", delay: "0.6s" },
	{ glyph: "◍", x: "82%", y: "74%", size: "2.8rem", delay: "1.2s" },
	{ glyph: "⚛", x: "14%", y: "78%", size: "2.2rem", delay: "1.8s" },
	{ glyph: "▪", x: "55%", y: "12%", size: "1.4rem", delay: "0.9s" },
	{ glyph: "▚", x: "68%", y: "88%", size: "1.6rem", delay: "1.5s" },
	{ glyph: "+", x: "30%", y: "88%", size: "1.4rem", delay: "0.3s" },
	{ glyph: "◦", x: "44%", y: "10%", size: "1.6rem", delay: "2.1s" },
];
---

<!-- 全屏首页舞台：液态玻璃背景 + ASCII 原子像素装饰 + 中央弹出文字 -->
<div class="wb-home-stage">
	<!-- ASCII 原子像素点缀层 -->
	<div class="wb-ascii-layer" aria-hidden="true">
		{asciiAtoms.map((a) => (
			<span
				class="wb-ascii-atom"
				style={`left:${a.x}; top:${a.y}; font-size:${a.size}; animation-delay:${a.delay};`}
			>
				{a.glyph}
			</span>
		))}
	</div>

	<!-- 网格/像素纹理层 -->
	<div class="wb-pixel-grid" aria-hidden="true"></div>

	<!-- 中央艺术字：流动光效引言 + 署名 -->
	<div class="wb-home-hero">
		<p class="quote-light">{profileConfig.bio}</p>
		<div class="quote-author">———史铁生</div>
	</div>
</div>

<style>
	/* 首页：聊天容器全宽无内边距，并消除移动端硬件加速 transform/动画 */
	:global(.wb-chat:has(.wb-home-stage)) {
		max-width: none;
		margin: 0;
		padding: 0;
		height: 100%;
		opacity: 1 !important;
		transform: none !important;
		will-change: auto !important;
		animation: none !important;
	}

	/* 外壳作为背景的定位基准（铺满整个界面，含侧边栏与顶栏区域） */
	:global(.wb-shell:has(.wb-home-stage)) {
		position: relative;
	}

	/* 主区域中和移动端硬件加速 transform */
	:global(.wb-main:has(.wb-home-stage)) {
		overflow: hidden;
		transform: none !important;
		will-change: auto !important;
	}

	/* 首页隐藏底部状态栏，让背景真正占满整屏 */
	:global(.wb-shell:has(.wb-home-stage) .wb-statusbar) {
		display: none;
	}

	/* 首页禁止页面级滚动，避免滚动条挤压右侧产生间隙 */
	:global(html:has(.wb-home-stage)),
	:global(body:has(.wb-home-stage)) {
		overflow: hidden;
	}

	/* 首页舞台：铺满整个工作台外壳，液态玻璃背景在最底层 */
	.wb-home-stage {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		background: transparent;
		overflow: hidden;
	}

	/* ---------- ASCII 原子像素点缀层 ---------- */
	.wb-ascii-layer {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}
	.wb-ascii-atom {
		position: absolute;
		color: rgb(150 200 255 / 0.5);
		text-shadow: 0 0 18px rgb(90 180 255 / 0.6);
		animation: wb-ascii-float 7s ease-in-out infinite alternate;
		transform: translateY(0);
		-webkit-user-select: none;
		user-select: none;
	}
	@keyframes wb-ascii-float {
		0% {
			transform: translateY(0) translateX(0);
			opacity: 0.4;
		}
		50% {
			transform: translateY(-1.2rem) translateX(0.6rem);
			opacity: 1;
		}
		100% {
			transform: translateY(0.6rem) translateX(-0.4rem);
			opacity: 0.5;
		}
	}

	/* ---------- 像素网格/扫描线纹理（科技感） ---------- */
	.wb-pixel-grid {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background-image:
			linear-gradient(rgb(120 180 255 / 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgb(120 180 255 / 0.06) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: radial-gradient(ellipse at center, black 30%, transparent 78%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 78%);
		animation: wb-pixel-scan 8s linear infinite;
	}
	@keyframes wb-pixel-scan {
		0% {
			background-position: 0 0;
		}
		100% {
			background-position: 0 44px;
		}
	}

	/* ---------- 中央艺术字：流动光效引言 ---------- */
	.wb-home-hero {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: none;
		padding: 0 1.5rem;
	}

	/* 流动光效艺术字：光带沿文字扫过 + 呼吸式辉光 */
	.quote-light {
		margin: 0;
		max-width: 20em;
		font-family: "Georgia", "Songti SC", "STSong", serif;
		font-size: clamp(1.25rem, 3.2vw, 2.5rem);
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.02em;
		line-height: 1.6;
		background: linear-gradient(
			105deg,
			rgb(165 210 255 / 0.7) 0%,
			rgb(255 255 255 / 1) 18%,
			rgb(205 235 255 / 0.95) 36%,
			rgb(255 255 255 / 1) 52%,
			rgb(150 205 255 / 0.65) 70%,
			rgb(255 255 255 / 0.98) 86%,
			rgb(165 210 255 / 0.7) 100%
		);
		background-size: 260% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation:
			quote-rise 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both,
			quote-shimmer 7s linear infinite,
			quote-glow 4.8s ease-in-out infinite;
	}

	/* 署名：史铁生（低调收尾，带微光） */
	.quote-author {
		margin-top: 1.8rem;
		font-family: "Songti SC", "STSong", serif;
		font-size: clamp(0.95rem, 2vw, 1.25rem);
		font-weight: 500;
		letter-spacing: 0.35em;
		text-indent: 0.35em;
		color: rgb(205 230 255 / 0.92);
		text-shadow: 0 0 14px rgb(120 190 255 / 0.55);
		animation: quote-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.9s both;
	}

	/* 文字上浮入场 */
	@keyframes quote-rise {
		0% {
			opacity: 0;
			transform: translateY(2.4rem);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
	/* 光带沿文字流动 */
	@keyframes quote-shimmer {
		0% {
			background-position: 180% center;
		}
		100% {
			background-position: -80% center;
		}
	}
	/* 辉光呼吸，像光在轻轻涌动 */
	@keyframes quote-glow {
		0%,
		100% {
			filter: drop-shadow(0 0 10px rgb(120 190 255 / 0.45))
				drop-shadow(0 0 26px rgb(120 190 255 / 0.2));
		}
		50% {
			filter: drop-shadow(0 0 18px rgb(150 210 255 / 0.7))
				drop-shadow(0 0 46px rgb(120 190 255 / 0.35));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.quote-light {
			animation: quote-rise 0.6s ease both;
		}
		.quote-author {
			animation: quote-rise 0.6s ease both;
		}
		.wb-ascii-atom,
		.wb-pixel-grid {
			animation: none;
		}
	}
</style>
