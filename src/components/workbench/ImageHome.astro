---
// 首页舞台：黑蓝深海液态玻璃背景（已下架壁纸）
// 背景由 glass-theme.css 中的 wb-shell 液态玻璃渐变 + 动态光斑提供，
// 这里叠加 ASCII 原子像素装饰与中央弹出文字。
import { profileConfig } from "@/config";

// ASCII 星点装饰（前景点缀）：以星星 / 光点类符号为主，仅留 1 个 ⚛ 作“原子”焦点
// dur: 每颗闪烁节奏（错开即像夜空眨眼）；big: 视觉焦点符号
const asciiStars = [
	{ glyph: "⚛", x: "10%", y: "22%", size: "3rem",   delay: "0s",   dur: "4.8s", big: true },
	{ glyph: "✦", x: "88%", y: "15%", size: "2rem",   delay: "0.6s", dur: "3.4s" },
	{ glyph: "★", x: "84%", y: "73%", size: "2.6rem", delay: "1.4s", dur: "4.2s", big: true },
	{ glyph: "✧", x: "16%", y: "80%", size: "2rem",   delay: "1.0s", dur: "3.8s" },
	{ glyph: "✶", x: "86%", y: "54%", size: "1.6rem", delay: "2.0s", dur: "3.2s" },
	{ glyph: "✷", x: "43%", y: "9%",  size: "1.7rem", delay: "2.6s", dur: "4.0s" },
	{ glyph: "·", x: "6%",  y: "52%", size: "1.4rem", delay: "0.9s", dur: "3.6s" },
	{ glyph: "⋆", x: "93%", y: "44%", size: "1.7rem", delay: "2.3s", dur: "3.5s" },
	{ glyph: "⊹", x: "34%", y: "66%", size: "1.6rem", delay: "2.9s", dur: "4.1s" },
	{ glyph: "◦", x: "4%",  y: "85%", size: "1.5rem", delay: "1.7s", dur: "4.4s" },
	{ glyph: "*", x: "95%", y: "63%", size: "1.4rem", delay: "0.8s", dur: "3.0s" },
	{ glyph: "✺", x: "60%", y: "19%", size: "1.6rem", delay: "1.2s", dur: "3.7s" },
	{ glyph: "❋", x: "28%", y: "38%", size: "1.5rem", delay: "3.1s", dur: "4.3s" },
	{ glyph: "◌", x: "68%", y: "89%", size: "1.8rem", delay: "1.5s", dur: "4.6s" },
];

// 史铁生名句：拆成“手电筒”依次照亮的词 / 字
// 中文逐字、英文 / 数字按词（自带尾随空格，避免词粘连）；纯空格段跳过
function tokenize(text: string) {
	const out: { type: string; ch: string; i?: number }[] = [];
	const segs = text.split(/(\s+)/);
	for (let k = 0; k < segs.length; k++) {
		const seg = segs[k];
		if (seg === "" || /^\s+$/.test(seg)) continue; // 空段 / 纯空格段跳过
		const nextIsSpace = k + 1 < segs.length && /^\s+$/.test(segs[k + 1]);
		if (/[一-鿿]/.test(seg)) {
			for (const ch of seg) out.push({ type: "char", ch });
		} else {
			out.push({ type: "word", ch: seg + (nextIsSpace ? " " : "") });
		}
	}
	// 给可见字符分配连续序号，让手电筒顺序扫过
	let vi = 0;
	for (const t of out) t.i = vi++;
	return out;
}
const quoteTokens = tokenize(profileConfig.bio || "");
const quoteCount = quoteTokens.filter((t) => t.type !== "space").length;
---

<!-- 全屏首页舞台：液态玻璃背景 + ASCII 星点闪烁 + 中央弹出文字 -->
<div class="wb-home-stage">
	<!-- 像素点阵 + 网格（科技基底） -->
	<div class="wb-pixel-dots" aria-hidden="true"></div>
	<div class="wb-pixel-grid" aria-hidden="true"></div>

	<!-- ASCII 星点闪烁层（星星为主，⚛ 为原子焦点） -->
	<div class="wb-ascii-layer" aria-hidden="true">
		{asciiStars.map((a) => (
			<span
				class={`wb-ascii-atom${a.big ? " is-big" : ""}`}
				style={`left:${a.x}; top:${a.y}; font-size:${a.size}; animation-delay:${a.delay}; animation-duration:${a.dur};`}
			>
				{a.glyph}
			</span>
		))}
	</div>

	<!-- 中央艺术字：史铁生名句（手电筒逐词照亮） + 署名 -->
	<div class="wb-home-hero">
		<p class="quote-light" style={`--n:${quoteCount}; --cycle:7s;`}>
			{quoteTokens.map((t) => (
				<span class="q-word" style={`--i:${t.i}`}>{t.ch}</span>
			))}
		</p>
		<div class="quote-author">———史铁生</div>
	</div>
</div>

<style>
	/* 首页：聊天容器全宽无内边距，并消除移动端硬件加速 transform/动画 */
	:global(.wb-chat:has(.wb-home-stage)) {
		max-width: none;
		margin: 0;
		padding: 0;
		height: 100%;
		opacity: 1 !important;
		transform: none !important;
		will-change: auto !important;
		animation: none !important;
	}

	/* 外壳作为背景的定位基准（铺满整个界面，含侧边栏与顶栏区域） */
	:global(.wb-shell:has(.wb-home-stage)) {
		position: relative;
	}

	/* 主区域中和移动端硬件加速 transform */
	:global(.wb-main:has(.wb-home-stage)) {
		overflow: hidden;
		transform: none !important;
		will-change: auto !important;
	}

	/* 首页隐藏底部状态栏，让背景真正占满整屏 */
	:global(.wb-shell:has(.wb-home-stage) .wb-statusbar) {
		display: none;
	}

	/* 首页禁止页面级滚动，避免滚动条挤压右侧产生间隙 */
	:global(html:has(.wb-home-stage)),
	:global(body:has(.wb-home-stage)) {
		overflow: hidden;
	}

	/* 首页舞台：铺满整个工作台外壳，液态玻璃背景在最底层 */
	.wb-home-stage {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		background: transparent;
		overflow: hidden;
	}

	/* ---------- 像素点阵（颗粒感基底） ---------- */
	.wb-pixel-dots {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background-image: radial-gradient(rgb(120 190 255 / 0.08) 1px, transparent 1.6px);
		background-size: 24px 24px;
		mask-image: radial-gradient(ellipse at center, black 22%, transparent 82%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 22%, transparent 82%);
		animation: wb-dot-pulse 6.5s ease-in-out infinite;
	}

	/* ---------- 像素网格纹理（科技感，收敛） ---------- */
	.wb-pixel-grid {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background-image:
			linear-gradient(rgb(120 180 255 / 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgb(120 180 255 / 0.05) 1px, transparent 1px);
		background-size: 38px 38px;
		mask-image: radial-gradient(ellipse at center, black 26%, transparent 80%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 26%, transparent 80%);
		animation: wb-pixel-scan 11s linear infinite;
	}
	@keyframes wb-pixel-scan {
		0%   { background-position: 0 0; }
		100% { background-position: 0 38px; }
	}
	@keyframes wb-dot-pulse {
		0%, 100% { opacity: 0.3; }
		50%      { opacity: 0.5; }
	}

	/* ---------- ASCII 星点闪烁层（星星为主，⚛ 为原子焦点） ---------- */
	.wb-ascii-layer {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}
	.wb-ascii-atom {
		position: absolute;
		font-family: var(--wb-mono, ui-monospace, monospace);
		color: rgb(165 210 255 / 0.6);
		text-shadow: 0 0 8px rgb(90 180 255 / 0.4);
		animation-name: wb-twinkle;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
		-webkit-user-select: none;
		user-select: none;
	}
	/* 视觉焦点符号（⚛ 原子 + ★ 星）：稍亮、闪烁幅度更大 */
	.wb-ascii-atom.is-big {
		color: rgb(200 232 255 / 0.78);
		text-shadow: 0 0 14px rgb(120 200 255 / 0.55);
	}
	@keyframes wb-twinkle {
		0%, 100% { opacity: 0.22; transform: scale(0.9); }
		50%      { opacity: 0.9;  transform: scale(1.06); }
	}

	/* ---------- 中央艺术字：史铁生名句（手电筒逐词照亮） ---------- */
	.wb-home-hero {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: none;
		padding: 0 1.5rem;
	}

	.quote-light {
		margin: 0;
		max-width: 20em;
		font-family: "Georgia", "Songti SC", "STSong", serif;
		font-size: clamp(1.25rem, 3.2vw, 2.5rem);
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.02em;
		line-height: 1.9;
		/* 整句上浮入场，不再用流动渐变（改用逐词手电筒） */
		animation: quote-rise 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
	}

	/* 每个词 / 字默认暗蓝，被“手电筒”扫到时点亮发光 */
	/* 用 inline 保留正常文字流与空格，避免词与词粘连 */
	.q-word {
		display: inline;
		color: rgb(150 195 245 / 0.30);
		animation: wb-flashlight var(--cycle, 7s) linear infinite;
		animation-delay: calc(var(--i) * (var(--cycle, 7s) / var(--n, 10)));
	}
	/* 手电筒：光斑经过该词时由暗转亮再转暗，配合 delay 形成横向扫过 */
	@keyframes wb-flashlight {
		0%   { color: rgb(150 195 245 / 0.30); text-shadow: none; }
		7%   {
			color: rgb(255 255 255 / 1);
			text-shadow: 0 0 10px rgb(185 222 255 / 0.9),
			             0 0 26px rgb(120 190 255 / 0.5);
		}
		30%  { color: rgb(150 195 245 / 0.30); text-shadow: none; }
		100% { color: rgb(150 195 245 / 0.30); text-shadow: none; }
	}

	/* 署名：史铁生（低调收尾，带微光） */
	.quote-author {
		margin-top: 1.8rem;
		font-family: "Songti SC", "STSong", serif;
		font-size: clamp(0.95rem, 2vw, 1.25rem);
		font-weight: 500;
		letter-spacing: 0.35em;
		text-indent: 0.35em;
		color: rgb(205 230 255 / 0.92);
		text-shadow: 0 0 14px rgb(120 190 255 / 0.55);
		animation: quote-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.9s both;
	}

	/* 文字上浮入场 */
	@keyframes quote-rise {
		0%   { opacity: 0; transform: translateY(2.4rem); }
		100% { opacity: 1; transform: translateY(0); }
	}

	/* 移动端：简化装饰，避免干扰中央文字 */
	@media (max-width: 860px) {
		.wb-ascii-atom.is-big { font-size: 2.2rem !important; }
		.wb-pixel-dots { opacity: 0.6; }
	}

	@media (prefers-reduced-motion: reduce) {
		.quote-light { animation: quote-rise 0.6s ease both; }
		.quote-author { animation: quote-rise 0.6s ease both; }
		/* 降级：静态显示全部文字，不再闪烁 */
		.q-word {
			animation: none;
			color: rgb(205 230 255 / 0.92);
			text-shadow: 0 0 12px rgb(120 190 255 / 0.4);
		}
		.wb-ascii-atom,
		.wb-pixel-grid,
		.wb-pixel-dots {
			animation: none;
		}
	}
</style>
