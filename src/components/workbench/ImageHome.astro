---
// 首页舞台：黑蓝深海液态玻璃背景（已下架壁纸）
// 背景由 glass-theme.css 中的 wb-shell 液态玻璃渐变 + 动态光斑提供，
// 这里叠加 ASCII 原子像素装饰与中央弹出文字。
import { profileConfig, siteConfig } from "@/config";

const siteName = siteConfig.subtitle
	? `${siteConfig.title} - ${siteConfig.subtitle}`
	: siteConfig.title;

// ASCII 原子像素装饰元素（前景点缀）
const asciiAtoms = [
	{ glyph: "◌", x: "8%", y: "22%", size: "2.4rem", delay: "0s" },
	{ glyph: "✦", x: "90%", y: "18%", size: "1.8rem", delay: "0.6s" },
	{ glyph: "◍", x: "82%", y: "74%", size: "2.8rem", delay: "1.2s" },
	{ glyph: "⚛", x: "14%", y: "78%", size: "2.2rem", delay: "1.8s" },
	{ glyph: "▪", x: "55%", y: "12%", size: "1.4rem", delay: "0.9s" },
	{ glyph: "▚", x: "68%", y: "88%", size: "1.6rem", delay: "1.5s" },
	{ glyph: "+", x: "30%", y: "88%", size: "1.4rem", delay: "0.3s" },
	{ glyph: "◦", x: "44%", y: "10%", size: "1.6rem", delay: "2.1s" },
];
---

<!-- 全屏首页舞台：液态玻璃背景 + ASCII 原子像素装饰 + 中央弹出文字 -->
<div class="wb-home-stage">
	<!-- ASCII 原子像素点缀层 -->
	<div class="wb-ascii-layer" aria-hidden="true">
		{asciiAtoms.map((a) => (
			<span
				class="wb-ascii-atom"
				style={`left:${a.x}; top:${a.y}; font-size:${a.size}; animation-delay:${a.delay};`}
			>
				{a.glyph}
			</span>
		))}
	</div>

	<!-- 网格/像素纹理层 -->
	<div class="wb-pixel-grid" aria-hidden="true"></div>

	<!-- 中央弹出文字 -->
	<div class="wb-home-hero">
		<div class="wb-hero-name">{siteName}</div>
		<div class="wb-hero-bio">{profileConfig.bio}</div>
	</div>
</div>

<style>
	/* 首页：聊天容器全宽无内边距，并消除移动端硬件加速 transform/动画 */
	:global(.wb-chat:has(.wb-home-stage)) {
		max-width: none;
		margin: 0;
		padding: 0;
		height: 100%;
		opacity: 1 !important;
		transform: none !important;
		will-change: auto !important;
		animation: none !important;
	}

	/* 外壳作为背景的定位基准（铺满整个界面，含侧边栏与顶栏区域） */
	:global(.wb-shell:has(.wb-home-stage)) {
		position: relative;
	}

	/* 主区域中和移动端硬件加速 transform */
	:global(.wb-main:has(.wb-home-stage)) {
		overflow: hidden;
		transform: none !important;
		will-change: auto !important;
	}

	/* 首页隐藏底部状态栏，让背景真正占满整屏 */
	:global(.wb-shell:has(.wb-home-stage) .wb-statusbar) {
		display: none;
	}

	/* 首页禁止页面级滚动，避免滚动条挤压右侧产生间隙 */
	:global(html:has(.wb-home-stage)),
	:global(body:has(.wb-home-stage)) {
		overflow: hidden;
	}

	/* 首页舞台：铺满整个工作台外壳，液态玻璃背景在最底层 */
	.wb-home-stage {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		background: transparent;
		overflow: hidden;
	}

	/* ---------- ASCII 原子像素点缀层 ---------- */
	.wb-ascii-layer {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}
	.wb-ascii-atom {
		position: absolute;
		color: rgb(150 200 255 / 0.5);
		text-shadow: 0 0 18px rgb(90 180 255 / 0.6);
		animation: wb-ascii-float 7s ease-in-out infinite alternate;
		transform: translateY(0);
		-webkit-user-select: none;
		user-select: none;
	}
	@keyframes wb-ascii-float {
		0% {
			transform: translateY(0) translateX(0);
			opacity: 0.4;
		}
		50% {
			transform: translateY(-1.2rem) translateX(0.6rem);
			opacity: 1;
		}
		100% {
			transform: translateY(0.6rem) translateX(-0.4rem);
			opacity: 0.5;
		}
	}

	/* ---------- 像素网格/扫描线纹理（科技感） ---------- */
	.wb-pixel-grid {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background-image:
			linear-gradient(rgb(120 180 255 / 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgb(120 180 255 / 0.06) 1px, transparent 1px);
		background-size: 44px 44px;
		mask-image: radial-gradient(ellipse at center, black 30%, transparent 78%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 78%);
		animation: wb-pixel-scan 8s linear infinite;
	}
	@keyframes wb-pixel-scan {
		0% {
			background-position: 0 0;
		}
		100% {
			background-position: 0 44px;
		}
	}

	/* ---------- 中央弹出文字 ---------- */
	.wb-home-hero {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		pointer-events: none;
		padding: 0 1.5rem;
	}
	.wb-hero-name {
		font-size: clamp(2.2rem, 7vw, 4.6rem);
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1.15;
		color: #fff;
		text-shadow: 0 2px 24px rgb(0 0 0 / 0.45), 0 0 80px rgb(120 190 255 / 0.3);
		background: linear-gradient(
			120deg,
			rgb(255 255 255 / 0.98) 0%,
			rgb(190 225 255 / 0.9) 45%,
			rgb(255 255 255 / 0.98) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: wb-hero-pop 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
		filter: drop-shadow(0 2px 18px rgb(0 0 0 / 0.4));
	}
	.wb-hero-bio {
		margin-top: 0.9rem;
		font-size: clamp(0.95rem, 2.6vw, 1.35rem);
		font-weight: 500;
		letter-spacing: 0.12em;
		color: rgb(220 240 255 / 0.95);
		text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
		animation: wb-hero-pop 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
	}
	@keyframes wb-hero-pop {
		0% {
			opacity: 0;
			transform: translateY(2.2rem) scale(0.92);
			filter: blur(10px);
		}
		60% {
			opacity: 1;
			transform: translateY(-0.3rem) scale(1.02);
			filter: blur(0);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.wb-hero-name,
		.wb-hero-bio,
		.wb-ascii-atom,
		.wb-pixel-grid {
			animation: none;
		}
		.wb-hero-name,
		.wb-hero-bio {
			opacity: 1;
			transform: none;
		}
	}
</style>
