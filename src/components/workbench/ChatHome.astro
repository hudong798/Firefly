---
import { Icon } from "astro-icon/components";
import RandomCoverImage from "@/components/misc/RandomCoverImage.astro";
import { profileConfig } from "@/config";
import { processCoverImageSync } from "@/utils/image-utils";
import type { CollectionEntry } from "astro:content";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const fmtDate = (d: Date) =>
	`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
		d.getDate(),
	).padStart(2, "0")}`;

// 根据标签名生成稳定的色相偏移，让标签有区分度
const tagHue = (tag: string) => {
	let h = 0;
	for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) % 360;
	return h;
};
---

<!-- 站内文章搜索框：固定在顶部，输入关键词即时弹出匹配文章，点击进入 -->
<div class="wb-search" id="wb-site-search">
	<div class="wb-composer wb-composer--search">
		<Icon name="material-symbols:search" class="wb-composer-ic" />
		<input
			id="wb-search-input"
			class="wb-composer-input"
			type="text"
			placeholder="搜索文章，如：影视、DSH、写真…"
			autocomplete="off"
			maxlength="50"
		/>
		<span class="wb-composer-btn" aria-hidden="true"
			><Icon name="material-symbols:search" /></span
		>
	</div>
	<div class="wb-search-results" id="wb-search-results" hidden></div>
</div>

<!-- 系统消息 -->
<div class="wb-sys-msg">🔗 已连接 AI 工作台 · 会话自动恢复 · 共 {posts.length} 个会话</div>

<!-- 助手欢迎消息 -->
<div class="wb-msg wb-msg--assistant">
	<img class="wb-avatar" src={profileConfig.avatar} alt="" />
	<div class="wb-msg-main">
		<div class="wb-msg-meta">
			<span class="wb-msg-author">{profileConfig.name} · 工作台</span>
			<span class="wb-msg-time">刚刚</span>
		</div>
		<div class="wb-bubble">
			<p>你好，我是 <strong>{profileConfig.name}</strong> 的 AI 工作台 🤖</p>
			<p>
				文章以「会话」的形式呈现。点击下面的快捷指令，或直接浏览最近的文章。
			</p>
			<div class="wb-typing"><span></span><span></span><span></span></div>
			<div class="wb-chips">
				<a class="wb-chip" href="/archive/"
					><Icon name="material-symbols:archive" /> 全部文章</a
				>
				<a class="wb-chip" href="/search/"
					><Icon name="material-symbols:search" /> 搜索</a
				>
				<a class="wb-chip" href="/about/"
					><Icon name="material-symbols:info" /> 关于我</a
				>
				<a class="wb-chip" href="/friends/"
					><Icon name="material-symbols:link" /> 友链</a
				>
			</div>
		</div>
	</div>
</div>

<!-- 分隔线 -->
<div class="wb-divider"><span>最近会话</span></div>

<!-- 文章列表：每条 = 一条助手回复 -->
{
	posts.map((post) => {
		const processedImage = processCoverImageSync(post.data.image, post.id);
		const hasCover =
			processedImage !== undefined &&
			processedImage !== null &&
			processedImage !== "";
		return (
			<a
				class="wb-msg wb-msg--assistant wb-msg--post"
				href={getPostUrlBySlug(post.id)}
			>
				<img class="wb-avatar" src={profileConfig.avatar} alt="" />
				<div class="wb-msg-main">
					<div class="wb-msg-meta">
						<span class="wb-msg-author">assistant</span>
						<span class="wb-msg-time">{fmtDate(post.data.published)}</span>
					</div>
					<div class="wb-bubble">
						<div class="wb-post-body">
							{
								hasCover && (
									<RandomCoverImage
										src={processedImage}
										basePath={getFileDirFromPath(post.filePath || "")}
										alt="文章封面"
										class="wb-post-cover"
										seed={post.id}
										preview={true}
									/>
								)
							}
							<div class="wb-post-main">
								<div class="wb-post-title">
									{post.data.pinned && (
										<span class="wb-post-pinned">📌 置顶</span>
									)}
									{post.data.title}
								</div>
								{post.data.description && (
									<div class="wb-post-desc">{post.data.description}</div>
								)}
								<div class="wb-post-footer">
									{post.data.tags?.slice(0, 3).map((t) => (
										<span
											class="wb-tag"
											style={{
												"--tag-c": `oklch(0.55 0.13 ${tagHue(t.trim())})`,
											}}
										>
											#{t.trim()}
										</span>
									))}
									<span class="wb-post-read">阅读 →</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</a>
		);
	})
}

<!-- 站内文章搜索框：输入关键词即时弹出匹配文章，点击进入 -->
<script is:inline>
	// 站内文章即时搜索（数据来自构建时生成的 /ai-posts.json）
	(function () {
		function initSearch() {
			var root = document.getElementById("wb-site-search");
			if (!root || root.dataset.wbSearchInit) return;
			root.dataset.wbSearchInit = "1";

			var input = document.getElementById("wb-search-input");
			var resultsEl = document.getElementById("wb-search-results");
			if (!input || !resultsEl) return;

			var posts = null;

			function loadPosts() {
				if (posts) return Promise.resolve(posts);
				return fetch("/ai-posts.json")
					.then(function (r) {
						if (!r.ok) throw new Error("索引加载失败");
						return r.json();
					})
					.then(function (data) {
						posts = data;
						return posts;
					})
					.catch(function () {
						posts = [];
						return posts;
					});
			}

			function matchPosts(query, list) {
				var q = query.trim().toLowerCase();
				if (!q) return [];
				var scored = list.map(function (p) {
					var title = (p.title || "").toLowerCase();
					var desc = (p.description || "").toLowerCase();
					var tags = (p.tags || []).join(" ").toLowerCase();
					var text = (p.text || "").toLowerCase();
					var score = 0;
					if (title.includes(q)) score += 10;
					if (tags.includes(q)) score += 4;
					if (desc.includes(q)) score += 2;
					if (text.includes(q)) score += 1;
					return { p: p, score: score };
				});
				return scored
					.filter(function (x) { return x.score > 0; })
					.sort(function (a, b) { return b.score - a.score; })
					.slice(0, 6)
					.map(function (x) { return x.p; });
			}

			function renderResults(items) {
				resultsEl.innerHTML = "";
				if (items.length === 0) {
					var empty = document.createElement("div");
					empty.className = "wb-search-empty";
					empty.textContent = "未找到相关文章，换个关键词试试";
					resultsEl.appendChild(empty);
				} else {
					items.forEach(function (p) {
						var a = document.createElement("a");
						a.className = "wb-search-item";
						a.href = "/posts/" + p.slug + "/";

						var title = document.createElement("div");
						title.className = "wb-search-item-title";
						title.textContent = p.title;

						var meta = document.createElement("div");
						meta.className = "wb-search-item-meta";
						var parts = [];
						if (p.category) parts.push(p.category);
						if (p.tags && p.tags.length) parts.push(p.tags.slice(0, 3).join(" / "));
						if (p.published) parts.push(p.published);
						meta.textContent = parts.join(" · ");

						a.appendChild(title);
						a.appendChild(meta);
						resultsEl.appendChild(a);
					});
				}
				resultsEl.hidden = false;
			}

			function hideResults() {
				resultsEl.hidden = true;
			}

			var timer = null;
			input.addEventListener("input", function () {
				clearTimeout(timer);
				var q = input.value.trim();
				if (!q) {
					hideResults();
					return;
				}
				timer = setTimeout(function () {
					loadPosts().then(function (list) {
						renderResults(matchPosts(q, list));
					});
				}, 150);
			});

			input.addEventListener("focus", function () {
				if (input.value.trim()) {
					loadPosts().then(function (list) {
						renderResults(matchPosts(input.value, list));
					});
				}
			});

			input.addEventListener("keydown", function (e) {
				if (e.key === "Enter") {
					var first = resultsEl.querySelector(".wb-search-item");
					if (first) {
						e.preventDefault();
						window.location.href = first.getAttribute("href");
					}
				}
				if (e.key === "Escape") hideResults();
			});

			document.addEventListener("click", function (e) {
				if (!root.contains(e.target)) hideResults();
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initSearch);
		} else {
			initSearch();
		}
	})();
</script>
