---
// 想法页：一排一排的行式文章列表（非会话形式）
import { Icon } from "astro-icon/components";
import RandomCoverImage from "@/components/misc/RandomCoverImage.astro";
import { processCoverImageSync } from "@/utils/image-utils";
import type { CollectionEntry } from "astro:content";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
	emptyText?: string;
}

const { posts, emptyText = "还没有内容，敬请期待 ✨" } = Astro.props;
const fmtDate = (d: Date) =>
	`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(
		d.getDate(),
	).padStart(2, "0")}`;

// 根据标签名生成稳定的色相偏移，让标签有区分度
const tagHue = (tag: string) => {
	let h = 0;
	for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) % 360;
	return h;
};
---

<div class="thought-list card-base rounded-[var(--radius-large)] overflow-hidden">
	{
		posts.map((post) => {
			const processedImage = processCoverImageSync(post.data.image, post.id);
			const hasCover =
				processedImage !== undefined &&
				processedImage !== null &&
				processedImage !== "";
			return (
				<a class="thought-row" href={getPostUrlBySlug(post.id)}>
					<div class="thought-date">
						<span class="thought-date-text">{fmtDate(post.data.published)}</span>
					</div>
					<div class="thought-main">
						<div class="thought-title">
							{post.data.pinned && <span class="thought-pinned">📌 置顶</span>}
							{post.data.title}
						</div>
						{post.data.description && (
							<div class="thought-desc">{post.data.description}</div>
						)}
						{post.data.tags && post.data.tags.length > 0 && (
							<div class="thought-tags">
								{post.data.tags.slice(0, 3).map((t) => (
									<span
										class="thought-tag"
										style={{
											"--tag-c": `oklch(0.55 0.13 ${tagHue(t.trim())})`,
										}}
									>
										#{t.trim()}
									</span>
								))}
							</div>
						)}
					</div>
					{hasCover && (
						<div class="thought-cover">
							<RandomCoverImage
								src={processedImage}
								basePath={getFileDirFromPath(post.filePath || "")}
								alt="文章封面"
								class="thought-cover-img"
								seed={post.id}
								preview={true}
							/>
						</div>
					)}
					<div class="thought-arrow">
						<Icon name="material-symbols:chevron-right-rounded" />
					</div>
				</a>
			);
		})
	}
	{posts.length === 0 && <div class="thought-empty">{emptyText}</div>}
</div>

<style>
	.thought-list {
		display: flex;
		flex-direction: column;
	}

	.thought-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.5rem;
		text-decoration: none;
		transition: background 0.2s ease;
		position: relative;
	}

	/* 行间分隔线 */
	.thought-row:not(:last-child)::after {
		content: "";
		position: absolute;
		left: 1.5rem;
		right: 1.5rem;
		bottom: 0;
		height: 1px;
		background: var(--line-divider);
		opacity: 0.6;
	}

	.thought-row:hover {
		background: var(--btn-plain-bg-hover);
	}

	.thought-row:active {
		background: var(--btn-plain-bg-active);
	}

	/* 左侧日期 */
	.thought-date {
		flex-shrink: 0;
		width: 5.5rem;
	}

	.thought-date-text {
		font-size: 0.8rem;
		color: var(--content-meta);
		font-variant-numeric: tabular-nums;
		transition: color 0.2s ease;
	}

	.thought-row:hover .thought-date-text {
		color: var(--primary);
	}

	/* 中间主体 */
	.thought-main {
		flex: 1;
		min-width: 0;
	}

	.thought-title {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--text-90, currentColor);
		transition: color 0.2s ease;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.thought-row:hover .thought-title {
		color: var(--primary);
	}

	.thought-pinned {
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--primary);
		background: var(--btn-regular-bg);
		padding: 0.1rem 0.45rem;
		border-radius: 0.375rem;
		flex-shrink: 0;
	}

	.thought-desc {
		font-size: 0.85rem;
		color: var(--content-meta);
		margin-top: 0.25rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.thought-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.4rem;
	}

	.thought-tag {
		font-size: 0.72rem;
		color: var(--tag-c);
		background: color-mix(in oklab, var(--tag-c) 10%, transparent);
		padding: 0.05rem 0.45rem;
		border-radius: 0.375rem;
	}

	/* 右侧封面缩略图 */
	.thought-cover {
		flex-shrink: 0;
		width: 5.5rem;
		height: 3.5rem;
		border-radius: 0.5rem;
		overflow: hidden;
	}

	/* RandomCoverImage 自带 min-h，需要压掉以保持缩略图尺寸 */
	.thought-cover-img {
		width: 100% !important;
		height: 100% !important;
		min-height: 0 !important;
		object-fit: cover;
	}

	.thought-cover-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 右侧箭头 */
	.thought-arrow {
		flex-shrink: 0;
		color: var(--content-meta);
		font-size: 1.6rem;
		display: flex;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.thought-row:hover .thought-arrow {
		color: var(--primary);
		transform: translateX(2px);
	}

	.thought-empty {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--content-meta);
	}

	/* 移动端：隐藏日期列，信息更紧凑 */
	@media (max-width: 768px) {
		.thought-row {
			padding: 0.9rem 1rem;
			gap: 0.75rem;
		}

		.thought-row:not(:last-child)::after {
			left: 1rem;
			right: 1rem;
		}

		.thought-date {
			display: none;
		}

		.thought-cover {
			width: 4rem;
			height: 2.75rem;
		}
	}
</style>
