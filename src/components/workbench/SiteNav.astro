---
// 全站统一导航栏：头像 + 站点名 + 导航板块 + 搜索放大镜
import { profileConfig, siteConfig } from "@/config";
import NavSearch from "@/components/workbench/NavSearch.svelte";
import { Icon } from "astro-icon/components";

// 顶部导航板块
const navItems = [
  { name: "观测站", url: "/", icon: "lucide:radar" },
  { name: "说说", url: "/thoughts/", icon: "lucide:message-circle" },
  { name: "Buddy", url: "/ai/", icon: "lucide:bot" },
  { name: "日程", url: "/schedule/", icon: "lucide:calendar", hidden: true },
  { name: "信号", url: "/guestbook/", icon: "lucide:mail", hidden: true },
  { name: "档案", url: "/resources/", icon: "lucide:archive", hidden: true },
  { name: "修仙界", url: "/cultivation/", icon: "lucide:sparkles", hidden: true },
];

// 当前路径，用于高亮当前导航项
const currentPath = Astro.url.pathname;
---

<nav class="site-nav">
  <div class="site-nav__left">
    <a href="/about/" class="site-nav__brand" id="site-nav-avatar-btn" title="关于我">
      <img src={profileConfig.avatar} alt="avatar" class="site-nav__avatar" />
    </a>
    <a href="/" class="site-nav__brand site-nav__brand-name-link" title="首页">
      <span class="site-nav__brand-name">{siteConfig.title}</span>
    </a>
  </div>
  <div class="site-nav__center">
    {navItems.filter(item => !item.hidden).map((item) => {
      const isActive = currentPath === item.url || (item.url !== "/" && currentPath.startsWith(item.url));
      return (
        <a href={item.url} data-nav-href={item.url} class={`site-nav__item${isActive ? " is-active" : ""}`}>
          <span class="site-nav__icon">
            <Icon name={item.icon} />
          </span>
          <span class="site-nav__text">{item.name}</span>
        </a>
      );
    })}
  </div>
  <div class="site-nav__right">
    <NavSearch client:only="svelte" />
  </div>
</nav>

<script>
  // 根据当前路径更新导航高亮（兼容 swup 无刷新切换）
  function updateSiteNavActive() {
    const path = window.location.pathname;
    document.querySelectorAll(".site-nav__item[data-nav-href]").forEach((el) => {
      const href = el.getAttribute("data-nav-href") || "";
      let active = false;
      if (href === "/") {
        active = path === "/" || path === "";
      } else {
        active = path === href || path.startsWith(href);
      }
      el.classList.toggle("is-active", active);
    });
  }

  function bindSiteNav() {
    // 点击时即时高亮，无需等待页面切换
    document.querySelectorAll<HTMLElement>(".site-nav__item[data-nav-href]").forEach((el) => {
      if (el.dataset.navBound) return;
      el.dataset.navBound = "1";
      el.addEventListener("click", () => {
        document.querySelectorAll(".site-nav__item").forEach((n) => n.classList.remove("is-active"));
        el.classList.add("is-active");
      });
    });
  }

  // 档案页分类切换：用 document 事件委托，兼容 swup 无刷新。
  // 原因：resources.astro 的页面脚本位于 swup 容器 <main> 内，无刷新切换后不会重跑，
  // 导致 01影视/02漫画/03社区/04工具 点击无反应。SiteNav 在 <main> 外，只注册一次即可。
  if (!document.body.dataset.archTabDelegated) {
    document.body.dataset.archTabDelegated = "1";
    document.addEventListener("click", (e) => {
      const tab = e.target.closest ? e.target.closest(".arch-index-item[data-tab]") : null;
      if (!tab) return;
      const root = tab.closest(".arch-container") || document;
      const target = tab.getAttribute("data-tab");
      root.querySelectorAll(".arch-index-item[data-tab]").forEach((t) => {
        const on = t === tab;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", String(on));
      });
      root.querySelectorAll(".arch-panel[data-panel]").forEach((p) => {
        p.classList.toggle("is-active", p.getAttribute("data-panel") === target);
      });
    });
  }

  // 初始执行
  bindSiteNav();
  updateSiteNavActive();

  // swup 无刷新切换后同步高亮（两种事件双保险）
  document.addEventListener("swup:contentReplaced", () => {
    bindSiteNav();
    updateSiteNavActive();
  });
  if (window.swup?.hooks) {
    window.swup.hooks.on("content:replace", updateSiteNavActive);
  } else {
    // swup 可能稍后初始化，轮询绑定一次
    let tries = 0;
    const timer = setInterval(() => {
      tries++;
      if (window.swup?.hooks) {
        window.swup.hooks.on("content:replace", updateSiteNavActive);
        clearInterval(timer);
      } else if (tries > 20) {
        clearInterval(timer);
      }
    }, 200);
  }

  // 浏览器前进 / 后退
  window.addEventListener("popstate", updateSiteNavActive);
</script>

<style>
  .site-nav {
    position: relative;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
    background: rgba(5, 7, 13, 0.72);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-nav__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .site-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .site-nav__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(155, 140, 255, 0.4);
    box-shadow: 0 0 12px rgba(155, 140, 255, 0.3);
  }
  .site-nav__brand-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #F5F7FF;
    letter-spacing: 0.05em;
  }
  .site-nav__center {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex: 1;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav__center::-webkit-scrollbar {
    display: none;
  }
  .site-nav__item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.6rem;
    color: rgba(141, 150, 170, 0.9);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .site-nav__item:hover {
    color: #F5F7FF;
    background: rgba(255, 255, 255, 0.04);
  }
  .site-nav__item.is-active {
    color: #F5F7FF;
    font-weight: 600;
  }
  .site-nav__item.is-active .site-nav__icon {
    color: #8ab8ff;
    filter: drop-shadow(0 0 6px rgba(138, 184, 255, 0.9)) drop-shadow(0 0 14px rgba(138, 184, 255, 0.45));
  }
  .site-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    transition: color 0.2s ease, filter 0.2s ease;
  }
  .site-nav__icon svg {
    width: 100%;
    height: 100%;
  }
  .site-nav__right {
    flex-shrink: 0;
  }

  /* 响应式 */
  @media (max-width: 900px) {
    .site-nav {
      padding: 0.6rem 1rem;
    }
    .site-nav__brand-name {
      display: none;
    }
  }
  /* 手机端：导航项只显示图标，避免文字太宽溢出盖住头像 */
  @media (max-width: 768px) {
    .site-nav__center {
      min-width: 0;
      gap: 1.1rem;
      justify-content: center;
    }
    .site-nav__text {
      display: none;
    }
    .site-nav__item {
      padding: 0.4rem 0.5rem;
    }
    .site-nav__icon {
      width: 18px;
      height: 18px;
    }
  }
</style>
