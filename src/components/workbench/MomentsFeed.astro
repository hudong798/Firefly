---
// 说说页：QQ 动态风格的说说列表
import type { ThoughtMoment } from "@/data/thoughts";
import { MOMENT_PREVIEW_LIMIT } from "@/data/thoughts";

interface Props {
	moments: ThoughtMoment[];
}

const { moments } = Astro.props;

// 截断预览：列表页最多展示 MOMENT_PREVIEW_LIMIT 字，超出需进详情页
function previewOf(content: string) {
	const isLong = content.length > MOMENT_PREVIEW_LIMIT;
	return {
		isLong,
		text: isLong ? content.slice(0, MOMENT_PREVIEW_LIMIT) + "…" : content,
	};
}
---

<div class="moments">
	{
		moments.map((m) => {
			const p = previewOf(m.content);
			const detailHref = `/thoughts/${m.id}/`;
			return p.isLong ? (
				// 超长说说：整张卡片可点击进入详情
				<a class="moment moment--link card-base rounded-[var(--radius-large)]" href={detailHref}>
					<header class="moment-head">
						<div class="moment-who">
							<span class="moment-name">Idong</span>
							<span class="moment-time">
								{m.mood && <span class="moment-mood">{m.mood}</span>}
								{m.date}
							</span>
						</div>
					</header>

					<p class="moment-content">{p.text}</p>

					{m.tags && m.tags.length > 0 && (
						<div class="moment-tags">
							{m.tags.map((t) => (
								<span class="moment-tag">#{t}</span>
							))}
						</div>
					)}

					<span class="moment-more">查看详情 ›</span>
				</a>
			) : (
				<article class="moment card-base rounded-[var(--radius-large)]">
					<header class="moment-head">
						<div class="moment-who">
							<span class="moment-name">Idong</span>
							<span class="moment-time">
								{m.mood && <span class="moment-mood">{m.mood}</span>}
								{m.date}
							</span>
						</div>
					</header>

					<p class="moment-content">{m.content}</p>

					{m.tags && m.tags.length > 0 && (
						<div class="moment-tags">
							{m.tags.map((t) => (
								<span class="moment-tag">#{t}</span>
							))}
						</div>
					)}
				</article>
			);
		})
	}
	{moments.length === 0 && (
		<div class="moment-empty card-base rounded-[var(--radius-large)]">
			还没有动态，去 src/data/thoughts.ts 写下第一条吧 ✨
		</div>
	)}
</div>

<style>
	.moments {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.moment {
		padding: 1.1rem 1.3rem 0.6rem;
	}

	/* 头部：昵称 + 时间 */
	.moment-head {
		display: flex;
		align-items: center;
	}

	.moment-who {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.moment-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--primary);
	}

	.moment-time {
		font-size: 0.75rem;
		color: var(--content-meta);
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.moment-mood {
		font-size: 0.85rem;
	}

	/* 正文 */
	.moment-content {
		margin: 0.7rem 0 0;
		font-size: 0.92rem;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* 可点击的整卡：去掉链接默认样式 + 悬停上浮 */
	.moment--link {
		display: block;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
		cursor: pointer;
	}

	.moment--link:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.35);
	}

	/* 查看详情提示 */
	.moment-more {
		display: inline-block;
		margin-top: 0.55rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--primary);
	}

	.moment--link:hover .moment-more {
		text-decoration: underline;
	}

	/* 标签 */
	.moment-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}

	.moment-tag {
		font-size: 0.75rem;
		color: var(--primary);
	}

	.moment-empty {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--content-meta);
	}

	@media (max-width: 768px) {
		.moment {
			padding: 0.9rem 1rem 0.4rem;
		}
	}
</style>
