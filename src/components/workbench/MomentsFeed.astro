---
// 想法页：QQ 动态风格的说说列表
import type { ThoughtMoment } from "@/data/thoughts";

interface Props {
	moments: ThoughtMoment[];
}

const { moments } = Astro.props;
---

<div class="moments">
	{
		moments.map((m) => (
			<article class="moment card-base rounded-[var(--radius-large)]">
				<header class="moment-head">
					<div class="moment-who">
						<span class="moment-name">Idong</span>
						<span class="moment-time">
							{m.mood && <span class="moment-mood">{m.mood}</span>}
							{m.date}
						</span>
					</div>
				</header>

				<p class="moment-content">{m.content}</p>

				{m.tags && m.tags.length > 0 && (
					<div class="moment-tags">
						{m.tags.map((t) => (
							<span class="moment-tag">#{t}</span>
						))}
					</div>
				)}
			</article>
		))
	}
	{moments.length === 0 && (
		<div class="moment-empty card-base rounded-[var(--radius-large)]">
			还没有动态，去 src/data/thoughts.ts 写下第一条吧 ✨
		</div>
	)}
</div>

<style>
	.moments {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.moment {
		padding: 1.1rem 1.3rem 0.6rem;
	}

	/* 头部：昵称 + 时间 */
	.moment-head {
		display: flex;
		align-items: center;
	}

	.moment-who {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.moment-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--primary);
	}

	.moment-time {
		font-size: 0.75rem;
		color: var(--content-meta);
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.moment-mood {
		font-size: 0.85rem;
	}

	/* 正文 */
	.moment-content {
		margin: 0.7rem 0 0;
		font-size: 0.92rem;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* 标签 */
	.moment-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}

	.moment-tag {
		font-size: 0.75rem;
		color: var(--primary);
	}

	.moment-empty {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--content-meta);
	}

	@media (max-width: 768px) {
		.moment {
			padding: 0.9rem 1rem 0.4rem;
		}
	}
</style>
