---
// 说说页：QQ 动态风格的说说列表
import type { ThoughtMoment } from "@/data/thoughts";
import { MOMENT_PREVIEW_LIMIT } from "@/data/thoughts";
import { commentConfig } from "@/config/commentConfig";

interface Props {
	moments: ThoughtMoment[];
}

const { moments } = Astro.props;

// Twikoo 评论系统配置（说说列表接入真实后端，多实例）
const twikooEnvId = commentConfig.twikoo?.envId || "";
const twikooLang = commentConfig.twikoo?.lang || "zh-CN";

// 截断预览：列表页最多展示 MOMENT_PREVIEW_LIMIT 字，超出需进详情页
function previewOf(content: string) {
	const isLong = content.length > MOMENT_PREVIEW_LIMIT;
	return {
		isLong,
		text: isLong ? content.slice(0, MOMENT_PREVIEW_LIMIT) + "…" : content,
	};
}
---

<div class="moments">
	<!-- 发表说说 -->
	<div class="moment-publisher card-base rounded-[var(--radius-large)]">
		<textarea
			class="moment-publisher-input"
			placeholder="说点什么吧..."
			rows="3"
			maxlength="500"
		></textarea>
		<div class="moment-publisher-bar">
			<div class="moment-publisher-moods">
				<button type="button" class="moment-mood-btn" data-mood="😊" title="开心">😊</button>
				<button type="button" class="moment-mood-btn" data-mood="🌙" title="深夜">🌙</button>
				<button type="button" class="moment-mood-btn" data-mood="✨" title="兴奋">✨</button>
				<button type="button" class="moment-mood-btn" data-mood="😆" title="大笑">😆</button>
				<button type="button" class="moment-mood-btn" data-mood="🌱" title="随笔">🌱</button>
			</div>
			<div class="moment-publisher-actions">
				<span class="moment-publisher-count">0/500</span>
				<span class="moment-github-status" id="gh-status" title="点击配置 GitHub Token">☁️ 未同步</span>
				<button type="button" class="moment-publisher-submit">发表</button>
			</div>
		</div>
	</div>

	<!-- 用户发表的说说（JS 动态插入到这里） -->
	<div class="moments-user-list"></div>

	{
		moments.map((m) => {
			const p = previewOf(m.content);
			const detailHref = `/thoughts/${m.id}/`;
			return (
			<article class="moment card-base rounded-[var(--radius-large)]">
				<header class="moment-head">
					<div class="moment-who">
						<span class="moment-name">Idong</span>
						<span class="moment-time">
							{m.mood && <span class="moment-mood">{m.mood}</span>}
							{m.date}
						</span>
					</div>
				</header>

				<p class="moment-content">{p.text}</p>

				{m.tags && m.tags.length > 0 && (
					<div class="moment-tags">
						{m.tags.map((t) => (
							<span class="moment-tag">#{t}</span>
						))}
					</div>
				)}

				{p.isLong && (
					<a class="moment-more" href={detailHref}>查看详情 ›</a>
				)}

				<footer class="moment-footer">
					<button type="button" class="moment-action" data-like={m.id}>
						<svg viewBox="0 0 24 24" class="moment-action-icon"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
						<span class="like-count" data-base={m.likes ?? 0}>{m.likes ?? 0}</span>
					</button>
					<button type="button" class="moment-action" data-comment-toggle={m.id}>
						<svg viewBox="0 0 24 24" class="moment-action-icon"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/></svg>
						<span class="comment-count" data-comment-count={m.id} data-base={m.comments ?? 0}>{m.comments ?? 0}</span>
					</button>
				</footer>

				<div class="moment-comments" id={`comments-${m.id}`} hidden>
					<div class="moment-tk" id={`tcomment-${m.id}`}></div>
				</div>
			</article>
			);
		})
	}
	{moments.length === 0 && (
		<div class="moment-empty card-base rounded-[var(--radius-large)]">
			还没有动态，去 src/data/thoughts.ts 写下第一条吧 ✨
		</div>
	)}
</div>

<style>
	.moments {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.moment {
		padding: 1.1rem 1.3rem 0.6rem;
	}

	/* 头部：昵称 + 时间 */
	.moment-head {
		display: flex;
		align-items: center;
	}

	.moment-who {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.moment-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--primary);
	}

	.moment-time {
		font-size: 0.75rem;
		color: var(--content-meta);
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.moment-mood {
		font-size: 0.85rem;
	}

	/* 正文 */
	.moment-content {
		margin: 0.7rem 0 0;
		font-size: 0.92rem;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* 查看详情提示 */
	.moment-more {
		display: inline-block;
		margin-top: 0.55rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--primary);
		text-decoration: none;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.moment-more:hover {
		opacity: 0.8;
		transform: translateX(2px);
	}

	/* 标签 */
	.moment-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}

	.moment-tag {
		font-size: 0.75rem;
		color: var(--primary);
	}

	/* 底部操作栏（点赞 / 评论） */
	.moment-footer {
		display: flex;
		gap: 1rem;
		margin-top: 0.7rem;
		padding-top: 0.65rem;
		border-top: 1px solid var(--line-color);
	}
	.moment-action {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.4rem;
		border: none;
		background: transparent;
		color: var(--content-meta);
		font-size: 0.82rem;
		cursor: pointer;
		border-radius: 0.4rem;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.moment-action:hover {
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.moment-action.is-liked {
		color: #ff5a79;
	}
	.moment-action-icon {
		width: 1.05rem;
		height: 1.05rem;
		fill: currentColor;
	}

	/* 评论区：默认隐藏，点击评论按钮展开 */
	.moment-comments {
		margin-top: 0.6rem;
		padding-top: 0.7rem;
		border-top: 1px dashed var(--line-color);
	}
	.moment-comments[hidden] {
		display: none;
	}
	.moment-tk {
		min-height: 1rem;
	}
	/* Twikoo 注入 DOM 的主题适配（scoped 不命中，用 :global） */
	.moment-tk :global(.tk-main) {
		background: transparent !important;
		box-shadow: none !important;
	}
	.moment-tk :global(.tk-comments-container),
	.moment-tk :global(.tk-comment) {
		border-color: var(--line-color) !important;
	}

	.moment-empty {
		padding: 3rem 1.5rem;
		text-align: center;
		color: var(--content-meta);
	}

	@media (max-width: 768px) {
		.moment {
			padding: 0.9rem 1rem 0.4rem;
		}
	}

	/* ---------- 发表说说 ---------- */
	.moment-publisher {
		padding: 1rem 1.2rem;
		margin-bottom: 0.2rem;
	}
	.moment-publisher-input {
		width: 100%;
		min-height: 70px;
		padding: 0.7rem 0.9rem;
		border-radius: 0.7rem;
		border: 1px solid var(--line-divider, rgba(255,255,255,0.1));
		background: var(--card-bg, rgba(255,255,255,0.03));
		color: var(--deep-text, #e6edf3);
		font-size: 0.92rem;
		line-height: 1.6;
		resize: vertical;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
		font-family: inherit;
	}
	.moment-publisher-input::placeholder {
		color: var(--content-meta, #8b949e);
	}
	.moment-publisher-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 15%, transparent);
	}
	.moment-publisher-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.7rem;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.moment-publisher-moods {
		display: flex;
		gap: 0.3rem;
	}
	.moment-mood-btn {
		width: 32px;
		height: 32px;
		border-radius: 8px;
		border: 1px solid transparent;
		background: transparent;
		font-size: 1.1rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all 0.15s ease;
		line-height: 1;
	}
	.moment-mood-btn:hover {
		background: var(--btn-plain-bg-hover, rgba(255,255,255,0.06));
		transform: scale(1.1);
	}
	.moment-mood-btn.is-active {
		background: color-mix(in oklch, var(--primary) 18%, transparent);
		border-color: color-mix(in oklch, var(--primary) 40%, transparent);
	}
	.moment-publisher-actions {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}
	.moment-publisher-count {
		font-size: 0.75rem;
		color: var(--content-meta, #8b949e);
		font-variant-numeric: tabular-nums;
	}
	.moment-github-status {
		font-size: 0.72rem;
		color: var(--content-meta, #8b949e);
		cursor: pointer;
		padding: 0.2rem 0.5rem;
		border-radius: 6px;
		border: 1px solid var(--line-divider, rgba(255,255,255,0.1));
		transition: all 0.15s ease;
		user-select: none;
		white-space: nowrap;
	}
	.moment-github-status:hover {
		color: var(--primary);
		border-color: var(--primary);
	}
	.moment-github-status.is-configured {
		color: #3fb950;
		border-color: rgba(63, 185, 80, 0.4);
	}
	.moment-github-status.is-syncing {
		color: #d29922;
		border-color: rgba(210, 153, 34, 0.4);
	}
	.moment-github-status.is-success {
		color: #3fb950;
		border-color: rgba(63, 185, 80, 0.5);
	}
	.moment-github-status.is-error {
		color: #f85149;
		border-color: rgba(248, 81, 73, 0.5);
	}
	.moment-publisher-submit {
		padding: 0.45rem 1.3rem;
		border-radius: 0.6rem;
		border: none;
		background: var(--primary);
		color: #fff;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}
	.moment-publisher-submit:hover {
		filter: brightness(1.1);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px color-mix(in oklch, var(--primary) 35%, transparent);
	}
	.moment-publisher-submit:active {
		transform: translateY(0);
	}

	/* 用户发表的说说标记 */
	.moment-user-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.5rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--line-divider, rgba(255,255,255,0.08));
	}
	.moment-user-badge {
		font-size: 0.7rem;
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		font-weight: 500;
	}
	.moment-user-delete {
		font-size: 0.72rem;
		color: var(--content-meta, #8b949e);
		background: transparent;
		border: 1px solid var(--line-divider, rgba(255,255,255,0.1));
		padding: 0.15rem 0.6rem;
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}
	.moment-user-delete:hover {
		color: #f85149;
		border-color: #f85149;
	}

	@media (max-width: 640px) {
		.moment-publisher {
			padding: 0.85rem 1rem;
		}
		.moment-publisher-bar {
			flex-direction: column;
			align-items: stretch;
		}
		.moment-publisher-actions {
			justify-content: space-between;
		}
		.moment-publisher-submit {
			flex: 1;
			text-align: center;
		}
	}
</style>

<script>
	// 说说列表交互：点赞（本地持久）+ 评论（接入 Twikoo 真实后端，多实例）+ 发表说说（本地存储）
	const LS_LIKE = "moments-likes";
	const LS_USER_MOMENTS = "user-moments";
	const getLikes = () => {
		try { return JSON.parse(localStorage.getItem(LS_LIKE) || "{}"); } catch { return {}; }
	};
	const saveLikes = (o: Record<string, boolean>) => localStorage.setItem(LS_LIKE, JSON.stringify(o));
	const getUserMoments = (): Array<{ id: string; date: string; content: string; mood?: string }> => {
		try { return JSON.parse(localStorage.getItem(LS_USER_MOMENTS) || "[]"); } catch { return []; }
	};
	const saveUserMoments = (arr: unknown[]) => localStorage.setItem(LS_USER_MOMENTS, JSON.stringify(arr));

	// 格式化当前时间
	function nowStr() {
		const d = new Date();
		const pad = (n: number) => String(n).padStart(2, "0");
		return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
	}

	// 创建用户说说卡片元素
	function createUserMomentEl(m: { id: string; date: string; content: string; mood?: string }) {
		const article = document.createElement("article");
		article.className = "moment card-base rounded-[var(--radius-large)] moment-user";
		article.dataset.userMomentId = m.id;

		const head = document.createElement("header");
		head.className = "moment-head";
		const who = document.createElement("div");
		who.className = "moment-who";
		const name = document.createElement("span");
		name.className = "moment-name";
		name.textContent = "Idong";
		const time = document.createElement("span");
		time.className = "moment-time";
		if (m.mood) {
			const mood = document.createElement("span");
			mood.className = "moment-mood";
			mood.textContent = m.mood;
			time.appendChild(mood);
		}
		time.appendChild(document.createTextNode(m.date));
		who.appendChild(name);
		who.appendChild(time);
		head.appendChild(who);

		const content = document.createElement("p");
		content.className = "moment-content";
		content.textContent = m.content;

		const footer = document.createElement("footer");
		footer.className = "moment-footer moment-user-footer";
		const badge = document.createElement("span");
		badge.className = "moment-user-badge";
		badge.textContent = "本地说说";
		const delBtn = document.createElement("button");
		delBtn.type = "button";
		delBtn.className = "moment-user-delete";
		delBtn.textContent = "删除";
		delBtn.addEventListener("click", () => {
			const list = getUserMoments().filter((x) => x.id !== m.id);
			saveUserMoments(list);
			article.remove();
		});
		footer.appendChild(badge);
		footer.appendChild(delBtn);

		article.appendChild(head);
		article.appendChild(content);
		article.appendChild(footer);
		return article;
	}

	// 渲染用户发表的说说到列表顶部
	function renderUserMoments() {
		const container = document.querySelector<HTMLElement>(".moments-user-list");
		if (!container) return;
		container.innerHTML = "";
		const list = getUserMoments();
		list.forEach((m) => {
			container.appendChild(createUserMomentEl(m));
		});
	}

	// 初始化发表说说表单
	function initPublisher() {
		const input = document.querySelector<HTMLTextAreaElement>(".moment-publisher-input");
		const submit = document.querySelector<HTMLButtonElement>(".moment-publisher-submit");
		const countEl = document.querySelector<HTMLElement>(".moment-publisher-count");
		const moodBtns = document.querySelectorAll<HTMLButtonElement>(".moment-mood-btn");
		const ghStatus = document.getElementById("gh-status");
		if (!input || !submit) return;

		let selectedMood = "";

		// 更新 GitHub 同步状态显示
		function updateGhStatus() {
			if (!ghStatus) return;
			const token = localStorage.getItem("github-token");
			if (token) {
				ghStatus.textContent = "☁️ 已配置";
				ghStatus.classList.add("is-configured");
			} else {
				ghStatus.textContent = "☁️ 未同步";
				ghStatus.classList.remove("is-configured");
			}
		}
		updateGhStatus();

		// 点击状态图标配置/修改 GitHub Token
		if (ghStatus) {
			ghStatus.addEventListener("click", () => {
				const current = localStorage.getItem("github-token") || "";
				const token = prompt(
					"请输入 GitHub Personal Access Token（需要 repo 权限，用于自动提交说说到仓库）：\n\n" +
					"获取方式：GitHub → Settings → Developer settings → Personal access tokens → Generate new token，勾选 repo 权限。\n\n" +
					"Token 仅存储在当前浏览器 localStorage 中，不会上传到其他地方。",
					current,
				);
				if (token !== null) {
					const t = token.trim();
					if (t) {
						localStorage.setItem("github-token", t);
					} else {
						localStorage.removeItem("github-token");
					}
					updateGhStatus();
				}
			});
		}

		// 同步说说到 GitHub（修改 src/data/thoughts.ts 并 commit）
		async function syncToGitHub(moment: { id: string; date: string; content: string; mood?: string }) {
			const token = localStorage.getItem("github-token");
			if (!token || !ghStatus) return;
			ghStatus.textContent = "⏳ 同步中...";
			ghStatus.classList.add("is-syncing");

			const owner = "hudong798";
			const repo = "Firefly";
			const branch = "master";
			const filePath = "src/data/thoughts.ts";
			const apiBase = `https://api.github.com/repos/${owner}/${repo}/contents/${filePath}`;

			try {
				// 1. 获取当前文件内容和 SHA
				const getRes = await fetch(`${apiBase}?ref=${branch}`, {
					headers: {
						Authorization: `token ${token}`,
						Accept: "application/vnd.github.v3+json",
					},
				});
				if (!getRes.ok) throw new Error(`获取文件失败: ${getRes.status}`);
				const getJson = await getRes.json();
				const sha = getJson.sha;
				const currentContent = decodeURIComponent(
					escape(atob(getJson.content.replace(/\n/g, ""))),
				);

				// 2. 在 moments 数组开头插入新说说
				const moodStr = moment.mood ? `\n\t\tmood: "${moment.mood}",` : "";
				const newEntry = `\t{\n\t\tid: "${moment.id}",\n\t\tdate: "${moment.date}",\n\t\tcontent: "${moment.content.replace(/"/g, '\\"')}",${moodStr}\n\t},\n`;
				const marker = "export const moments: ThoughtMoment[] = [\n";
				const insertPos = currentContent.indexOf(marker);
				if (insertPos === -1) throw new Error("未找到 moments 数组位置");
				const newContent =
					currentContent.slice(0, insertPos + marker.length) +
					newEntry +
					currentContent.slice(insertPos + marker.length);

				// 3. 提交更新
				const putRes = await fetch(apiBase, {
					method: "PUT",
					headers: {
						Authorization: `token ${token}`,
						Accept: "application/vnd.github.v3+json",
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						message: `feat: 发表说说 - ${moment.content.slice(0, 30)}${moment.content.length > 30 ? "..." : ""}`,
						content: btoa(unescape(encodeURIComponent(newContent))),
						sha,
						branch,
					}),
				});
				if (!putRes.ok) {
					const errText = await putRes.text();
					throw new Error(`提交失败: ${putRes.status} ${errText.slice(0, 100)}`);
				}

				ghStatus.textContent = "✅ 已同步";
				ghStatus.classList.remove("is-syncing");
				ghStatus.classList.add("is-success");
				setTimeout(updateGhStatus, 3000);
			} catch (err) {
				console.error("[GitHub Sync] 失败:", err);
				ghStatus.textContent = "❌ 同步失败";
				ghStatus.classList.remove("is-syncing");
				ghStatus.classList.add("is-error");
				setTimeout(updateGhStatus, 3000);
			}
		}

		// 字数统计
		input.addEventListener("input", () => {
			if (countEl) countEl.textContent = `${input.value.length}/500`;
		});

		// 心情选择
		moodBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				moodBtns.forEach((b) => b.classList.remove("is-active"));
				if (selectedMood === btn.dataset.mood) {
					selectedMood = "";
				} else {
					selectedMood = btn.dataset.mood || "";
					btn.classList.add("is-active");
				}
			});
		});

		// 发表
		submit.addEventListener("click", () => {
			const content = input.value.trim();
			if (!content) {
				input.focus();
				return;
			}
			const moment = {
				id: `user-${Date.now()}`,
				date: nowStr(),
				content,
				mood: selectedMood || undefined,
			};
			const list = getUserMoments();
			list.unshift(moment);
			saveUserMoments(list);
			renderUserMoments();
			// 异步同步到 GitHub
			syncToGitHub(moment);
			// 重置表单
			input.value = "";
			if (countEl) countEl.textContent = "0/500";
			selectedMood = "";
			moodBtns.forEach((b) => b.classList.remove("is-active"));
		});
	}

	// 等待 twikoo 全局对象加载完成
	function whenTwikoo(cb: () => void) {
		if (typeof window.twikoo !== "undefined") { cb(); return; }
		setTimeout(() => whenTwikoo(cb), 300);
	}

	function initMomentInteractions() {
		// ---- 发表说说（本地存储）----
		initPublisher();
		renderUserMoments();

		// ---- 点赞（localStorage 持久可切换）----
		document.querySelectorAll<HTMLButtonElement>("button[data-like]").forEach((btn) => {
			if (btn.dataset.init) return;
			btn.dataset.init = "1";
			const id = btn.getAttribute("data-like") || "";
			const countEl = btn.querySelector<HTMLElement>(".like-count");
			const base = countEl ? Number.parseInt(countEl.dataset.base || "0", 10) : 0;
			const liked = !!getLikes()[id];
			btn.classList.toggle("is-liked", liked);
			if (countEl) countEl.textContent = String(base + (liked ? 1 : 0));
			btn.addEventListener("click", () => {
				const lk = getLikes();
				const now = !lk[id];
				if (now) lk[id] = true; else delete lk[id];
				saveLikes(lk);
				btn.classList.toggle("is-liked", now);
				if (countEl) countEl.textContent = String(base + (now ? 1 : 0));
			});
		});

		// ---- 评论展开 / 收起 + Twikoo 多实例初始化 ----
		document.querySelectorAll<HTMLButtonElement>("button[data-comment-toggle]").forEach((btn) => {
			if (btn.dataset.initToggle) return;
			btn.dataset.initToggle = "1";
			const id = btn.getAttribute("data-comment-toggle") || "";
			const box = document.getElementById(`comments-${id}`);
			if (!box) return;
			btn.addEventListener("click", () => {
				const willShow = box.hidden;
				box.hidden = !box.hidden;
				if (willShow && !box.dataset.tkInited) {
					const el = document.getElementById(`tcomment-${id}`);
					if (!el) return;
					box.dataset.tkInited = "1";
					whenTwikoo(() => {
						window.twikoo
							.init({
								envId: window.__twikooEnv,
								el: `#tcomment-${id}`,
								path: `/thoughts/${id}`,
								lang: window.__twikooLang || "zh-CN",
							})
							.catch((e: unknown) => console.error("[Moments Twikoo] init failed:", e));
					});
				}
			});
		});

		// ---- 刷新真实评论计数 ----
		refreshCommentCounts();
	}

	function refreshCommentCounts() {
		whenTwikoo(() => {
			if (!window.twikoo.getCommentsCount) return;
			const els = document.querySelectorAll<HTMLElement>(".comment-count[data-comment-count]");
			if (!els.length) return;
			const urls = Array.from(els).map(
				(el) => `/thoughts/${el.getAttribute("data-comment-count")}`,
			);
			window.twikoo
				.getCommentsCount({ envId: window.__twikooEnv, urls, includeReply: true })
				.then((res: { url: string; count: number }[]) => {
					res.forEach((item) => {
						const id = (item.url || "").split("/").pop();
						const el = document.querySelector<HTMLElement>(
							`.comment-count[data-comment-count="${id}"]`,
						);
						if (el && typeof item.count === "number") {
							el.textContent = String(item.count);
						}
					});
				})
				.catch(() => {});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initMomentInteractions);
	} else {
		initMomentInteractions();
	}
	document.addEventListener("swup:page:view", initMomentInteractions);
	document.addEventListener("firefly:page:loaded", initMomentInteractions);
</script>

<!-- 设置 Twikoo 环境 ID 并加载 SDK（说说列表页多实例评论） -->
<script is:inline define:vars={{ twikooEnvId, twikooLang }}>
	window.__twikooEnv = twikooEnvId;
	window.__twikooLang = twikooLang;
</script>
<script is:inline src="/assets/js/firefly-twikoo-1.6.44.all.min.js"></script>
