---
// Archive Galaxy Canvas：可交互星图引擎（拖拽+缩放+Hover+详情面板）
import { tvSites, tvOthers } from "@/data/tv";
import { comics } from "@/data/comics";
import { communities } from "@/data/communities";
import { toolGroups } from "@/data/tools";

interface Planet {
	id: string;
	name: string;
	url: string;
	type?: string;
	rating?: number;
	desc?: string;
	category: string;
	x: number;
	y: number;
}

interface StarSys {
	id: string;
	name: string;
	nameEn: string;
	color: string;
	x: number;
	y: number;
	planets: Planet[];
}

const allTools = toolGroups.flatMap((g) => g.items);

// 构建星系数据 + 行星坐标
function buildSystems(): StarSys[] {
	const configs = [
		{ id: "cinema", name: "影视", nameEn: "CINEMA", color: "#8b5cf6", x: 400, y: 320 },
		{ id: "manga", name: "漫画", nameEn: "MANGA", color: "#06b6d4", x: 1200, y: 280 },
		{ id: "community", name: "社区", nameEn: "COMMUNITY", color: "#f59e0b", x: 380, y: 800 },
		{ id: "tools", name: "工具", nameEn: "TOOLS", color: "#10b981", x: 1220, y: 760 },
	];
	const raw = [
		[...tvSites, ...tvOthers].map((s, i) => ({ id: `tv-${i}`, name: s.name, url: s.url, type: (s as any).type, rating: (s as any).rating, category: "影视" })),
		comics.map((c, i) => ({ id: `c-${i}`, name: c.name, url: c.url, type: (c as any).type, category: "漫画" })),
		communities.map((c, i) => ({ id: `cm-${i}`, name: c.name, url: c.url, desc: c.desc, category: "社区" })),
		allTools.map((t, i) => ({ id: `t-${i}`, name: t.name, url: t.url, desc: (t as any).desc, category: "工具" })),
	];
	return configs.map((cfg, si) => {
		const planets = raw[si].map((p, pi) => {
			const orbit = pi % 3;
			const radius = 80 + orbit * 55;
			const perOrbit = Math.ceil(raw[si].length / 3);
			const idxInOrbit = Math.floor(pi / 3);
			const angle = (idxInOrbit / perOrbit) * Math.PI * 2 + orbit * 0.35;
			return {
				...p,
				x: cfg.x + Math.cos(angle) * radius,
				y: cfg.y + Math.sin(angle) * radius,
			};
		});
		return { ...cfg, planets };
	});
}

const systems = buildSystems();
const totalPlanets = systems.reduce((s, x) => s + x.planets.length, 0);
---

<div class="agc" id="archive-galaxy-canvas">
	<!-- 顶部控制中心 -->
	<div class="agc-topbar">
		<div class="agc-search-wrap">
			<span class="agc-search-icon">◎</span>
			<input id="agc-search" type="text" placeholder="SEARCH THE ARCHIVE... 搜索星图" autocomplete="off" spellcheck="false" oninput="window.__agcSearch=this.value" />
		</div>
		<div class="agc-filters" id="agc-filters">
			{systems.map((s, i) => (
				<button class="agc-filter" data-filter={s.id} style={{ "--fc": s.color }}>
					<span class="agc-filter-dot"></span>
					{s.name}
				</button>
			))}
		</div>
	</div>

	<!-- Canvas 星图 -->
	<div class="agc-canvas-wrap">
		<canvas id="agc-canvas"></canvas>
		<!-- 坐标装饰 -->
		<div class="agc-coord agc-coord--tl"><span>OBS-01</span><span>ARCHIVE FIELD</span></div>
		<div class="agc-coord agx-coord--tr"><span>RA 05h 35m</span><span>DEC +22°</span></div>
		<div class="agc-coord agc-coord--bl"><span>SECTOR 04</span><span>DRAG TO PAN</span></div>
		<div class="agc-coord agc-coord--br"><span>{totalPlanets} OBJECTS</span><span>SCROLL TO ZOOM</span></div>
		<!-- 缩放控制 -->
		<div class="agc-zoom">
			<button id="agc-zoom-in" aria-label="放大">+</button>
			<button id="agc-zoom-out" aria-label="缩小">−</button>
			<button id="agc-zoom-reset" aria-label="重置">⌂</button>
		</div>
	</div>

	<!-- 详情面板 -->
	<div class="agc-panel" id="agc-panel" hidden>
		<div class="agc-panel-head">
			<div class="agc-panel-cat" id="agc-panel-cat">影视</div>
			<button class="agc-panel-close" id="agc-panel-close" aria-label="关闭">×</button>
		</div>
		<div class="agc-panel-name" id="agc-panel-name">非凡资源</div>
		<div class="agc-panel-type" id="agc-panel-type">VIDEO</div>
		<div class="agc-panel-desc" id="agc-panel-desc"></div>
		<div class="agc-panel-meta">
			<div class="agc-meta-row"><span class="agc-meta-k">RATING</span><span class="agc-meta-v" id="agc-panel-rating">—</span></div>
			<div class="agc-meta-row"><span class="agc-meta-k">STATUS</span><span class="agc-meta-v agc-meta-v--ok">ACTIVE</span></div>
			<div class="agc-meta-row"><span class="agc-meta-k">VISITED</span><span class="agc-meta-v" id="agc-panel-visited">—</span></div>
		</div>
		<div class="agc-panel-actions">
			<a class="agc-btn agc-btn--primary" id="agc-panel-open" href="#" target="_blank" rel="noopener">VISIT →</a>
			<button class="agc-btn agc-btn--ghost" id="agc-panel-fav">☆ FAVORITE</button>
		</div>
	</div>

	<!-- 移动端列表（降级） -->
	<div class="agc-mobile" id="agc-mobile" hidden>
		{systems.map((s) => (
			<details class="agc-m-group">
				<summary style={{ "--fc": s.color }}>
					<span class="agc-m-dot"></span>
					<span class="agc-m-name">{s.name}</span>
					<span class="agc-m-count">{s.planets.length}</span>
				</summary>
				<div class="agc-m-grid">
					{s.planets.map((p) => (
						<a class="agc-m-item" href={p.url} target="_blank" rel="noopener">{p.name}</a>
					))}
				</div>
			</details>
		))}
	</div>
</div>

<script is:inline define:vars={{ systems, totalPlanets }}>
	window.__agcData = {systems, totalPlanets};
</script>

<style>
	.agc { position: relative; width: 100%; margin-top: 0.5rem; }

	/* 顶部控制 */
	.agc-topbar {
		display: flex; align-items: center; justify-content: space-between;
		gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;
	}
	.agc-search-wrap {
		display: flex; align-items: center; gap: 0.6rem;
		padding: 0.6rem 1rem; border-radius: 10px;
		background: rgba(255,255,255,0.015); border: 1px solid rgba(255,255,255,0.07);
		flex: 1; min-width: 220px; max-width: 420px;
		transition: border-color 0.2s;
	}
	.agc-search-wrap:focus-within { border-color: rgba(139,92,246,0.4); }
	.agc-search-icon { color: rgba(139,92,246,0.6); font-size: 0.85rem; flex-shrink: 0; }
	.agc-search-wrap input {
		flex: 1; border: none; background: transparent; outline: none;
		color: #f8fafc; font-size: 0.82rem; font-family: inherit;
	}
	.agc-search-wrap input::placeholder { color: rgba(255,255,255,0.25); font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.7rem; }

	.agc-filters { display: flex; gap: 0.4rem; flex-wrap: wrap; }
	.agc-filter {
		display: flex; align-items: center; gap: 0.4rem;
		padding: 0.4rem 0.75rem; border-radius: 8px;
		background: transparent; border: 1px solid rgba(255,255,255,0.07);
		color: rgba(255,255,255,0.5); font-size: 0.75rem; cursor: pointer;
		transition: all 0.2s; font-family: inherit;
	}
	.agc-filter:hover { color: rgba(255,255,255,0.8); border-color: rgba(255,255,255,0.15); }
	.agc-filter.active { color: #f8fafc; border-color: var(--fc); background: rgba(255,255,255,0.03); }
	.agc-filter-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--fc); }

	/* Canvas 区域 */
	.agc-canvas-wrap {
		position: relative; width: 100%; height: 680px;
		border-radius: 14px; overflow: hidden;
		border: 1px solid rgba(255,255,255,0.04);
		background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(15,23,42,0.4) 0%, rgba(10,10,15,0.6) 100%);
		cursor: grab;
	}
	.agc-canvas-wrap:active { cursor: grabbing; }
	#agc-canvas { display: block; width: 100%; height: 100%; }

	/* 坐标装饰 */
	.agc-coord {
		position: absolute; display: flex; flex-direction: column; gap: 2px;
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.48rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.15);
		text-transform: uppercase; pointer-events: none; z-index: 2;
	}
	.agc-coord--tl { top: 0.75rem; left: 1rem; }
	.agx-coord--tr { top: 0.75rem; right: 1rem; text-align: right; }
	.agc-coord--bl { bottom: 0.75rem; left: 1rem; }
	.agc-coord--br { bottom: 0.75rem; right: 1rem; text-align: right; }

	/* 缩放控制 */
	.agc-zoom {
		position: absolute; right: 1rem; bottom: 3rem; z-index: 3;
		display: flex; flex-direction: column; gap: 0.3rem;
	}
	.agc-zoom button {
		width: 32px; height: 32px; border-radius: 8px;
		background: rgba(10,10,15,0.8); border: 1px solid rgba(255,255,255,0.1);
		color: rgba(255,255,255,0.6); font-size: 1rem; cursor: pointer;
		display: flex; align-items: center; justify-content: center;
		transition: all 0.2s; backdrop-filter: blur(8px);
	}
	.agc-zoom button:hover { color: #f8fafc; border-color: rgba(139,92,246,0.4); }

	/* 详情面板 */
	.agc-panel {
		position: absolute; top: 0; right: 0; bottom: 0;
		width: 340px; z-index: 10;
		background: rgba(8,10,18,0.97); backdrop-filter: blur(16px);
		border-left: 1px solid rgba(255,255,255,0.08);
		padding: 1.5rem; display: flex; flex-direction: column;
		animation: agc-panel-in 0.3s ease;
	}
	.agc-panel[hidden] { display: none !important; }
	@keyframes agc-panel-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
	.agc-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
	.agc-panel-cat {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.6rem; letter-spacing: 0.15em; color: rgba(255,255,255,0.4);
		text-transform: uppercase;
	}
	.agc-panel-close {
		background: transparent; border: none; color: rgba(255,255,255,0.4);
		font-size: 1.2rem; cursor: pointer; padding: 0.2rem 0.4rem; border-radius: 4px;
		transition: color 0.2s;
	}
	.agc-panel-close:hover { color: #f8fafc; }
	.agc-panel-name { font-size: 1.3rem; font-weight: 600; color: #f8fafc; margin-bottom: 0.3rem; }
	.agc-panel-type {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.6rem; letter-spacing: 0.12em; color: rgba(255,255,255,0.35);
		text-transform: uppercase; margin-bottom: 1rem;
	}
	.agc-panel-desc { font-size: 0.82rem; color: #94a3b8; line-height: 1.7; margin-bottom: 1.25rem; min-height: 2rem; }
	.agc-panel-meta { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
	.agc-meta-row { display: flex; justify-content: space-between; }
	.agc-meta-k { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.55rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); text-transform: uppercase; }
	.agc-meta-v { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.65rem; color: rgba(255,255,255,0.65); }
	.agc-meta-v--ok { color: rgba(16,185,129,0.7); }
	.agc-panel-actions { display: flex; gap: 0.5rem; margin-top: auto; }
	.agc-btn {
		flex: 1; padding: 0.65rem; border-radius: 8px; font-size: 0.72rem;
		font-family: "JetBrains Mono", ui-monospace, monospace; letter-spacing: 0.08em;
		cursor: pointer; text-align: center; text-decoration: none; transition: all 0.2s;
		border: 1px solid transparent;
	}
	.agc-btn--primary { background: rgba(139,92,246,0.15); border-color: rgba(139,92,246,0.35); color: #c4b5fd; }
	.agc-btn--primary:hover { background: rgba(139,92,246,0.25); color: #f8fafc; }
	.agc-btn--ghost { background: transparent; border-color: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); }
	.agc-btn--ghost:hover { border-color: rgba(255,255,255,0.2); color: #f8fafc; }
	.agc-btn--ghost.faved { color: #fbbf24; border-color: rgba(251,191,36,0.3); }

	/* 移动端列表 */
	.agc-mobile { padding: 0.5rem 0; }
	.agc-mobile[hidden] { display: none !important; }
	.agc-m-group { margin-bottom: 0.75rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.015); overflow: hidden; }
	.agc-m-group summary {
		display: flex; align-items: center; gap: 0.6rem;
		padding: 0.85rem 1rem; cursor: pointer; list-style: none;
	}
	.agc-m-group summary::-webkit-details-marker { display: none; }
	.agc-m-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--fc); }
	.agc-m-name { font-size: 0.9rem; font-weight: 600; color: #f8fafc; flex: 1; }
	.agc-m-count { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.65rem; color: rgba(255,255,255,0.35); }
	.agc-m-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.4rem; padding: 0 1rem 1rem; }
	.agc-m-item {
		padding: 0.55rem 0.7rem; border-radius: 6px; font-size: 0.78rem;
		color: rgba(255,255,255,0.65); background: rgba(255,255,255,0.02);
		text-decoration: none; transition: all 0.2s; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.agc-m-item:hover { color: #f8fafc; background: rgba(255,255,255,0.05); }

	@media (max-width: 900px) {
		.agc-canvas-wrap { display: none; }
		.agc-mobile { display: block; }
		.agc-zoom { display: none; }
		.agc-coord { display: none; }
		.agc-panel { display: none !important; }
	}
	@media (max-width: 480px) {
		.agc-m-grid { grid-template-columns: 1fr; }
		.agc-topbar { flex-direction: column; align-items: stretch; }
		.agc-search-wrap { max-width: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.agc-panel { animation: none; }
	}
</style>

<script>
	// ===== Canvas 星图引擎 =====
	const data = (window as any).__agcData || { systems: [], totalPlanets: 0 };
	const canvas = document.getElementById("agc-canvas") as HTMLCanvasElement;
	if (!canvas) { /* SSR 安全 */ }
	else {
		const ctx = canvas.getContext("2d")!;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const WORLD_W = 1600, WORLD_H = 1100;

		// 相机
		const cam = { x: WORLD_W / 2, y: WORLD_H / 2, scale: 1, targetX: WORLD_W / 2, targetY: WORLD_H / 2, targetScale: 1 };

		// 状态
		let hoverPlanet: any = null;
		let hoverStar: any = null;
		let activeFilters = new Set<string>();
		let searchQuery = "";
		let favorites = new Set<string>(JSON.parse(localStorage.getItem("agc-favs") || "[]"));
		let visited: Record<string, string> = JSON.parse(localStorage.getItem("agc-visited") || "{}");

		// 背景星星
		const bgStars = Array.from({ length: 200 }, () => ({
			x: Math.random() * WORLD_W,
			y: Math.random() * WORLD_H,
			r: Math.random() * 1.2 + 0.3,
			a: Math.random() * 0.3 + 0.08,
			layer: Math.random() < 0.3 ? 0 : Math.random() < 0.6 ? 1 : 2,
		}));

		function resize() {
			const rect = canvas.parentElement!.getBoundingClientRect();
			canvas.width = rect.width * dpr;
			canvas.height = rect.height * dpr;
			canvas.style.width = rect.width + "px";
			canvas.style.height = rect.height + "px";
			fitToWorld();
		}

		function fitToWorld() {
			const w = canvas.width / dpr, h = canvas.height / dpr;
			const scaleX = w / WORLD_W, scaleY = h / WORLD_H;
			cam.scale = cam.targetScale = Math.min(scaleX, scaleY) * 1.15;
			cam.x = cam.targetX = WORLD_W / 2;
			cam.y = cam.targetY = WORLD_H / 2;
		}

		function worldToScreen(wx: number, wy: number) {
			return {
				x: (wx - cam.x) * cam.scale + canvas.width / dpr / 2,
				y: (wy - cam.y) * cam.scale + canvas.height / dpr / 2,
			};
		}
		function screenToWorld(sx: number, sy: number) {
			return {
				x: (sx - canvas.width / dpr / 2) / cam.scale + cam.x,
				y: (sy - canvas.height / dpr / 2) / cam.scale + cam.y,
			};
		}

		function isPlanetVisible(p: any) {
			// 直接从 DOM 读取筛选状态（不依赖变量）
			const activeCats = new Set(
				Array.from(document.querySelectorAll(".agc-filter.active"))
					.map((el) => (el as HTMLElement).dataset.filter)
			);
			if (activeCats.size > 0 && !activeCats.has(p.category)) return false;
			// 直接从 DOM 读取搜索词（不依赖事件绑定）
			const si = document.getElementById("agc-search") as HTMLInputElement | null;
			const q = si ? si.value.trim() : "";
			if (q) {
				const ql = q.toLowerCase();
				if (!p.name.toLowerCase().includes(ql) && !p.category.toLowerCase().includes(ql)) return false;
			}
			return true;
		}

		function render() {
			const w = canvas.width / dpr, h = canvas.height / dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);

			// 相机平滑
			cam.x += (cam.targetX - cam.x) * 0.08;
			cam.y += (cam.targetY - cam.y) * 0.08;
			cam.scale += (cam.targetScale - cam.scale) * 0.08;

			// 背景星星（视差）
			bgStars.forEach((s) => {
				const parallax = 0.3 + s.layer * 0.25;
				const px = (s.x - cam.x * parallax) % WORLD_W;
				const py = (s.y - cam.y * parallax) % WORLD_H;
				const sx = ((px + WORLD_W) % WORLD_W) / WORLD_W * w;
				const sy = ((py + WORLD_H) % WORLD_H) / WORLD_H * h;
				ctx.beginPath();
				ctx.arc(sx, sy, s.r, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(255,255,255,${s.a})`;
				ctx.fill();
			});

			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const t = reduced ? 0 : performance.now() / 1000;

			// 绘制星系
			data.systems.forEach((sys: any) => {
				const starScreen = worldToScreen(sys.x, sys.y);
				const isStarHover = hoverStar === sys;
				const isStarDim = hoverStar && hoverStar !== sys;
				const sysAlpha = isStarDim ? 0.25 : 1;

				// 连线（恒星到行星）
				sys.planets.forEach((p: any) => {
					if (!isPlanetVisible(p)) return;
					const ps = worldToScreen(p.x, p.y);
					ctx.beginPath();
					ctx.moveTo(starScreen.x, starScreen.y);
					ctx.lineTo(ps.x, ps.y);
					ctx.strokeStyle = hexToRgba(sys.color, isStarHover ? 0.35 : 0.15);
					ctx.lineWidth = 0.5;
					ctx.setLineDash([3, 5]);
					ctx.stroke();
					ctx.setLineDash([]);
				});

				// 行星
				sys.planets.forEach((p: any) => {
					if (!isPlanetVisible(p)) return;
					const ps = worldToScreen(p.x, p.y);
					const isHover = hoverPlanet === p;
					const si2 = document.getElementById("agc-search") as HTMLInputElement | null;
					const sq = si2 ? si2.value.trim() : "";
					const isSearchMatch = sq && (p.name.toLowerCase().includes(sq.toLowerCase()) || p.category.toLowerCase().includes(sq.toLowerCase()));
					const floatY = reduced ? 0 : Math.sin(t * 0.8 + p.x * 0.01) * 1.5;
					const r = Math.max(3, (isHover ? 6 : 4) * Math.min(cam.scale * 1.3, 1.3));

					// 搜索匹配脉冲
					if (isSearchMatch && !reduced) {
						const pulse = 0.5 + Math.sin(t * 3) * 0.3;
						ctx.beginPath();
						ctx.arc(ps.x, ps.y + floatY, r + 6, 0, Math.PI * 2);
						ctx.strokeStyle = hexToRgba(sys.color, pulse * 0.4);
						ctx.lineWidth = 1;
						ctx.stroke();
					}

					ctx.beginPath();
					ctx.arc(ps.x, ps.y + floatY, r, 0, Math.PI * 2);
					ctx.fillStyle = hexToRgba(sys.color, isHover ? 1 : sysAlpha * 0.7);
					ctx.fill();
					if (isHover) {
						ctx.shadowColor = sys.color;
						ctx.shadowBlur = 12;
						ctx.fill();
						ctx.shadowBlur = 0;
					}

					// 收藏标记
					if (favorites.has(p.id)) {
						ctx.fillStyle = "#fbbf24";
						ctx.font = "8px sans-serif";
						ctx.fillText("★", ps.x + r + 2, ps.y + floatY - r);
					}

					// Hover 标签
					if (isHover || cam.scale > 1.3) {
						ctx.font = "11px 'Inter', sans-serif";
						ctx.textAlign = "center";
						const label = p.name;
						const tw = ctx.measureText(label).width;
						const lx = ps.x, ly = ps.y + floatY + r + 14;
						// 标签背景
						ctx.fillStyle = "rgba(8,10,18,0.9)";
						ctx.strokeStyle = hexToRgba(sys.color, 0.3);
						ctx.lineWidth = 0.5;
						roundRect(ctx, lx - tw / 2 - 6, ly - 10, tw + 12, 18, 4);
						ctx.fill();
						ctx.stroke();
						ctx.fillStyle = "#f8fafc";
						ctx.fillText(label, lx, ly + 3);
						ctx.textAlign = "left";
					}
				});

				// 恒星光晕
				const starR = 14 * Math.min(cam.scale, 1.5);
				const breathe = reduced ? 1 : 1 + Math.sin(t * 1.5 + sys.x * 0.01) * 0.12;
				const grad = ctx.createRadialGradient(starScreen.x, starScreen.y, 0, starScreen.x, starScreen.y, starR * 3 * breathe);
				grad.addColorStop(0, hexToRgba(sys.color, 0.35));
				grad.addColorStop(1, hexToRgba(sys.color, 0));
				ctx.beginPath();
				ctx.arc(starScreen.x, starScreen.y, starR * 3 * breathe, 0, Math.PI * 2);
				ctx.fillStyle = grad;
				ctx.fill();

				// 恒星核心
				ctx.beginPath();
				ctx.arc(starScreen.x, starScreen.y, starR, 0, Math.PI * 2);
				ctx.fillStyle = sys.color;
				ctx.shadowColor = sys.color;
				ctx.shadowBlur = isStarHover ? 25 : 15;
				ctx.fill();
				ctx.shadowBlur = 0;
				// 恒星高光
				ctx.beginPath();
				ctx.arc(starScreen.x - starR * 0.3, starScreen.y - starR * 0.3, starR * 0.35, 0, Math.PI * 2);
				ctx.fillStyle = "rgba(255,255,255,0.6)";
				ctx.fill();

				// 恒星标签
				ctx.font = "600 13px 'Inter', sans-serif";
				ctx.textAlign = "center";
				ctx.fillStyle = isStarHover ? "#f8fafc" : `rgba(248,250,252,${sysAlpha * 0.8})`;
				ctx.fillText(sys.name, starScreen.x, starScreen.y + starR + 20);
				ctx.font = "9px 'JetBrains Mono', monospace";
				ctx.fillStyle = `rgba(255,255,255,${sysAlpha * 0.35})`;
				ctx.fillText(`${sys.planets.length} OBJECTS`, starScreen.x, starScreen.y + starR + 34);
				ctx.textAlign = "left";
			});

			requestAnimationFrame(render);
		}

		function hexToRgba(hex: string, a: number) {
			const r = parseInt(hex.slice(1, 3), 16);
			const g = parseInt(hex.slice(3, 5), 16);
			const b = parseInt(hex.slice(5, 7), 16);
			return `rgba(${r},${g},${b},${a})`;
		}

		function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
			ctx.beginPath();
			ctx.moveTo(x + r, y);
			ctx.arcTo(x + w, y, x + w, y + h, r);
			ctx.arcTo(x + w, y + h, x, y + h, r);
			ctx.arcTo(x, y + h, x, y, r);
			ctx.arcTo(x, y, x + w, y, r);
			ctx.closePath();
		}

		// ===== 交互 =====
		let isDragging = false;
		let dragStart = { x: 0, y: 0 };
		let camStart = { x: 0, y: 0 };
		let dragMoved = false;
		let velocity = { x: 0, y: 0 };

		canvas.addEventListener("mousedown", (e) => {
			isDragging = true;
			dragMoved = false;
			dragStart = { x: e.clientX, y: e.clientY };
			camStart = { x: cam.targetX, y: cam.targetY };
			velocity = { x: 0, y: 0 };
		});

		window.addEventListener("mousemove", (e) => {
			const rect = canvas.getBoundingClientRect();
			const mx = e.clientX - rect.left;
			const my = e.clientY - rect.top;

			if (isDragging) {
				const dx = (e.clientX - dragStart.x) / cam.scale;
				const dy = (e.clientY - dragStart.y) / cam.scale;
				if (Math.abs(dx) > 2 || Math.abs(dy) > 2) dragMoved = true;
				cam.targetX = camStart.x - dx;
				cam.targetY = camStart.y - dy;
				velocity = { x: -dx * 0.1, y: -dy * 0.1 };
				return;
			}

			// Hover 检测
			const wp = screenToWorld(mx, my);
			hoverPlanet = null;
			hoverStar = null;
			// 检测行星
			for (const sys of data.systems) {
				for (const p of sys.planets) {
					if (!isPlanetVisible(p)) continue;
					const d = Math.hypot(p.x - wp.x, p.y - wp.y);
					if (d < 20 / cam.scale) { hoverPlanet = p; hoverStar = sys; break; }
				}
				if (hoverPlanet) break;
			}
			// 检测恒星
			if (!hoverPlanet) {
				for (const sys of data.systems) {
					const d = Math.hypot(sys.x - wp.x, sys.y - wp.y);
					if (d < 40 / cam.scale) { hoverStar = sys; break; }
				}
			}
			canvas.style.cursor = hoverPlanet || hoverStar ? "pointer" : "grab";
		});

		window.addEventListener("mouseup", () => {
			if (isDragging && !dragMoved) {
				// 点击
				if (hoverPlanet) openPanel(hoverPlanet);
				else if (hoverStar) focusStar(hoverStar);
			} else if (isDragging) {
				// 惯性
				inertia();
			}
			isDragging = false;
		});

		function inertia() {
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (reduced) return;
			let vx = velocity.x, vy = velocity.y;
			const step = () => {
				if (Math.abs(vx) < 0.1 && Math.abs(vy) < 0.1) return;
				cam.targetX += vx;
				cam.targetY += vy;
				vx *= 0.94;
				vy *= 0.94;
				requestAnimationFrame(step);
			};
			step();
		}

		canvas.addEventListener("wheel", (e) => {
			e.preventDefault();
			const factor = e.deltaY > 0 ? 0.9 : 1.1;
			cam.targetScale = Math.max(0.4, Math.min(3, cam.targetScale * factor));
		}, { passive: false });

		// 缩放按钮
		document.getElementById("agc-zoom-in")?.addEventListener("click", () => {
			cam.targetScale = Math.min(3, cam.targetScale * 1.3);
		});
		document.getElementById("agc-zoom-out")?.addEventListener("click", () => {
			cam.targetScale = Math.max(0.4, cam.targetScale * 0.75);
		});
		document.getElementById("agc-zoom-reset")?.addEventListener("click", () => {
			fitToWorld();
		});

		function focusStar(sys: any) {
			cam.targetX = sys.x;
			cam.targetY = sys.y;
			cam.targetScale = 1.4;
		}

		// ===== 详情面板 =====
		const panel = document.getElementById("agc-panel")!;
		function openPanel(p: any) {
			panel.hidden = false;
			(document.getElementById("agc-panel-cat") as HTMLElement).textContent = p.category;
			(document.getElementById("agc-panel-name") as HTMLElement).textContent = p.name;
			(document.getElementById("agc-panel-type") as HTMLElement).textContent = (p.type || p.category).toUpperCase();
			(document.getElementById("agc-panel-desc") as HTMLElement).textContent = p.desc || "一个被收藏在数字宇宙中的资源。";
			(document.getElementById("agc-panel-rating") as HTMLElement).textContent = p.rating ? p.rating : "—";
			(document.getElementById("agc-panel-visited") as HTMLElement).textContent = visited[p.id] || "—";
			const openBtn = document.getElementById("agc-panel-open") as HTMLAnchorElement;
			openBtn.href = p.url;
			openBtn.onclick = () => {
				visited[p.id] = new Date().toLocaleDateString("zh-CN");
				localStorage.setItem("agc-visited", JSON.stringify(visited));
			};
			const favBtn = document.getElementById("agc-panel-fav") as HTMLButtonElement;
			const isFav = favorites.has(p.id);
			favBtn.textContent = isFav ? "★ FAVORITED" : "☆ FAVORITE";
			favBtn.classList.toggle("faved", isFav);
			favBtn.onclick = () => {
				if (favorites.has(p.id)) favorites.delete(p.id);
				else favorites.add(p.id);
				localStorage.setItem("agc-favs", JSON.stringify([...favorites]));
				favBtn.textContent = favorites.has(p.id) ? "★ FAVORITED" : "☆ FAVORITE";
				favBtn.classList.toggle("faved", favorites.has(p.id));
			};
		}

		// ===== 全局事件委托（确保 swup 过渡后仍有效）=====
		document.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			// 关闭面板
			if (target.closest("#agc-panel-close")) {
				const p = document.getElementById("agc-panel");
				if (p) p.hidden = true;
			}
			// 筛选按钮：只切换 active class，状态由 DOM 维护
			const filterBtn = target.closest(".agc-filter");
			if (filterBtn) {
				filterBtn.classList.toggle("active");
			}
		});

		// 启动
		resize();
		window.addEventListener("resize", resize);
		requestAnimationFrame(render);
	}
</script>
