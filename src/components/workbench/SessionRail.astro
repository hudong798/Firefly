---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;

const nav = [
	{ name: "首页", url: "/", icon: "material-symbols:home" },
	{ name: "发布", url: "/admin/", icon: "material-symbols:publish" },
	{ name: "留言板", url: "/guestbook/", icon: "material-symbols:forum" },
	{ name: "作品", url: "/works/", icon: "material-symbols:palette" },
	{ name: "AI", url: "/ai/", icon: "material-symbols:smart-toy" },
	{ name: "影视", url: "/tv/", icon: "material-symbols:movie" },
	{ name: "书籍", url: "/books/", icon: "material-symbols:auto-stories" },
	{ name: "游戏", url: "/games/", icon: "material-symbols:sports-esports" },
];

const isActive = (u: string) =>
	pathname === u || (u !== "/" && pathname.startsWith(u));
---

<aside class="wb-rail">
	<nav class="wb-rail-nav">
		<div class="wb-rail-section">会话</div>
		{
			nav.map((n) => (
				<a
					href={n.url}
					class:list={["wb-session", { "is-active": isActive(n.url) }]}
				>
					<Icon name={n.icon} class="wb-session-icon" />
					<span>{n.name}</span>
				</a>
			))
		}
	</nav>
	<div class="wb-rail-footer">
		<span class="wb-status-dot"></span>
		engine ready · firefly
	</div>
</aside>
