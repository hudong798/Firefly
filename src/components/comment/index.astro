---
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config/commentConfig";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { removeFileExtension } from "@/utils/url-utils";
import Artalk from "./Artalk.astro";
import Disqus from "./Disqus.astro";
import Giscus from "./Giscus.astro";
import Twikoo from "./Twikoo.astro";
import Waline from "./Waline.astro";

interface Props {
	post: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	hideHeader?: boolean;
}

const { post, customPath, hideHeader = false } = Astro.props;
const { id } = post;

// 根据页面类型确定路径
const slug = removeFileExtension(id);
const path =
	customPath || (post.collection === "posts" ? `/posts/${slug}` : `/${slug}`);
const url = `${Astro.site?.href}${path}`;

// 强制commentService类型为string，避免类型不兼容警告
let commentService: string = commentConfig?.type || "none";
---

{
  commentService !== "none" && (
    <div class="comment-section">
      {!hideHeader && (
      <!-- 评论区标题 -->
      <div class="comment-header">
        <div class="comment-header-line">
          <span class="comment-header-dot"></span>
        </div>
        <h3 class="comment-title">{i18n(Key.commentSection)}</h3>
        <p class="comment-subtitle">{i18n(Key.commentSubtitle)}</p>
      </div>
      )}
      <!-- 评论内容区域 -->
      <div class="comment-content">
        {commentService === "twikoo" && <Twikoo path={path} />}
        {commentService === "waline" && <Waline path={path} />}
        {commentService === "giscus" && <Giscus />}
        {commentService === "disqus" && <Disqus identifier={slug} url={url} title={'title' in post.data ? post.data.title : slug} />}
          {commentService === "artalk" && <Artalk path={path} />}
        {commentService === "none" && (
          <div class="comment-empty">
            <div class="comment-empty-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
            </div>
            <p>{i18n(Key.commentNotConfigured)}</p>
          </div>
        )}
      </div>
    </div>
  )
}

<style>
  .comment-section {
    position: relative;
  }

  .comment-header {
    margin-bottom: 2rem;
  }

  .comment-header-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .comment-header-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(155, 140, 255, 0.5);
    box-shadow: 0 0 8px rgba(155, 140, 255, 0.3);
  }

  .comment-header-line::before,
  .comment-header-line::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(155, 140, 255, 0.08), transparent);
    max-width: 80px;
  }

  .comment-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #F4F5FA;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .comment-subtitle {
    font-size: 0.85rem;
    color: #7F8799;
    margin: 0;
    line-height: 1.6;
  }

  .comment-content {
    position: relative;
  }

  .comment-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: rgba(255, 255, 255, 0.35);
  }

  .comment-empty-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
  }

  .comment-empty-icon svg {
    width: 32px;
    height: 32px;
  }

  .comment-empty p {
    font-size: 0.85rem;
    margin: 0;
  }
</style>
