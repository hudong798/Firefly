---
// 阅读详情页：展示单本书的完整阅读感悟
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { bookNotes } from "@/data/books";
import { profileConfig } from "@/config";

export function getStaticPaths() {
	return bookNotes.map((book) => ({
		params: { id: book.id },
		props: { book },
	}));
}

const { book } = Astro.props;
const title = "阅读 · " + book.title;
const description = book.feeling.slice(0, 60);
---

<MainGridLayout title={title} description={description}>
	<div class="rd-detail">
		<a class="rd-back" href="/reading/">‹ 返回阅读</a>

		<article class="rd-card card-base rounded-[var(--radius-large)]">
			<header class="rd-head">
				<img class="rd-avatar" src={profileConfig.avatar} alt="" loading="lazy" />
				<div class="rd-meta">
					<span class="rd-name">{profileConfig.name}</span>
					<span class="rd-time">{book.date}</span>
				</div>
			</header>

			<div class="rd-book" style={`--book-hue:${book.hue}deg;`}>
				<span class="rd-cover">{book.cover}</span>
				<div class="rd-book-info">
					<h3 class="rd-title">《{book.title}》</h3>
					<p class="rd-author-line">{book.author}</p>
				</div>
			</div>

			<div class="rd-feeling">
				{book.feeling.split("\n").map((para) => (
					<p class="rd-para">{para}</p>
				))}
			</div>

			<div class="rd-tags">
				{book.tags.map((tag) => (
					<span class="rd-tag">{tag}</span>
				))}
			</div>

			<footer class="rd-footer">
				<button type="button" class="rd-action rd-like-btn" data-like={book.id}>
					<span class="rd-like-ic">♥</span>
					<span class="like-count" data-base={book.likes}>{book.likes}</span>
				</button>
				<span class="rd-action">
					<span>💬</span>
					<span class="comment-count" data-comment-count={book.id} data-base={book.comments}>{book.comments}</span>
				</span>
			</footer>

			<div class="rd-comments" id={`comments-${book.id}`}>
				<div class="rc-list" data-list={book.id}></div>
				<form class="rc-form" data-form={book.id}>
					<input class="rc-name" type="text" value={profileConfig.name} maxlength="20" aria-label="昵称" />
					<input class="rc-input" type="text" placeholder="说点什么…" maxlength="200" aria-label="评论内容" />
					<button type="submit" class="rc-send">发送</button>
				</form>
			</div>
		</article>
	</div>
</MainGridLayout>

<style>
	.rd-detail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 680px;
		margin: 0 auto;
	}
	.rd-back {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--content-meta);
		text-decoration: none;
		transition: color 0.18s ease;
	}
	.rd-back:hover {
		color: var(--primary);
	}

	.rd-card {
		padding: 1.4rem 1.6rem 1.2rem;
	}
	.rd-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	.rd-avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.rd-meta {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.rd-name {
		font-weight: 700;
		color: var(--deep-text);
	}
	.rd-time {
		font-size: 0.78rem;
		color: var(--content-meta);
	}

	.rd-book {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.8rem 0.9rem;
		border-radius: 0.85rem;
		background: linear-gradient(
			135deg,
			oklch(0.42 0.07 var(--book-hue, 210)) 0%,
			oklch(0.28 0.05 var(--book-hue, 250)) 100%
		);
		border: 1px solid oklch(0.55 0.08 var(--book-hue, 210) / 0.35);
		margin-bottom: 1rem;
	}
	.rd-cover {
		font-size: 2.4rem;
		line-height: 1;
	}
	.rd-book-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.rd-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: #fff;
	}
	.rd-author-line {
		margin: 0;
		font-size: 0.8rem;
		color: oklch(0.9 0.02 var(--book-hue) / 0.9);
	}

	.rd-feeling {
		margin: 0 0 1rem;
	}
	.rd-para {
		margin: 0 0 0.7rem;
		font-size: 0.96rem;
		line-height: 1.8;
		color: var(--content-normal);
	}
	.rd-para:last-child {
		margin-bottom: 0;
	}

	.rd-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.9rem;
	}
	.rd-tag {
		font-size: 0.72rem;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 14%, transparent);
		color: var(--primary);
		border: 1px solid color-mix(in oklch, var(--primary) 28%, transparent);
	}

	.rd-footer {
		display: flex;
		gap: 1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--line-color);
		color: var(--content-meta);
		font-size: 0.82rem;
	}
	.rd-like-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: none;
		background: transparent;
		color: var(--content-meta);
		font-size: 0.82rem;
		cursor: pointer;
		border-radius: 0.4rem;
		padding: 0.25rem 0.4rem;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.rd-like-btn:hover {
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.rd-like-btn.is-liked {
		color: #ff5a79;
	}
	.rd-like-ic {
		font-size: 1rem;
		line-height: 1;
	}

	/* 评论区（详情页常显） */
	.rd-comments {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line-color);
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.rc-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.rc-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.5rem 0.7rem;
		border-radius: 0.6rem;
		background: var(--glass-surface, var(--wb-hover));
	}
	.rc-meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.rc-name-text {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--deep-text);
	}
	.rc-time {
		font-size: 0.7rem;
		color: var(--content-meta);
	}
	.rc-text {
		font-size: 0.86rem;
		line-height: 1.55;
		color: var(--content-normal);
		white-space: pre-wrap;
		word-break: break-word;
	}
	.rc-empty {
		font-size: 0.8rem;
		color: var(--content-meta);
		margin: 0;
	}
	.rc-form {
		display: flex;
		gap: 0.4rem;
		align-items: center;
	}
	.rc-name {
		width: 5.5rem;
		flex-shrink: 0;
		padding: 0.4rem 0.55rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line-color);
		background: var(--glass-surface, var(--wb-hover));
		color: var(--deep-text);
		font-size: 0.8rem;
	}
	.rc-input {
		flex: 1;
		min-width: 0;
		padding: 0.4rem 0.6rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line-color);
		background: var(--glass-surface, var(--wb-hover));
		color: var(--deep-text);
		font-size: 0.85rem;
	}
	.rc-name:focus,
	.rc-input:focus {
		outline: none;
		border-color: color-mix(in oklch, var(--primary) 50%, transparent);
	}
	.rc-send {
		flex-shrink: 0;
		padding: 0.4rem 0.85rem;
		border: none;
		border-radius: 0.5rem;
		background: var(--primary);
		color: #fff;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: filter 0.15s ease;
	}
	.rc-send:hover {
		filter: brightness(1.08);
	}

	@media (max-width: 768px) {
		.rd-card {
			padding: 1.1rem 1.1rem 1rem;
		}
	}
</style>

<script>
	// 阅读详情页交互：点赞（持久可切换）+ 评论（持久可输入/显示）
	const LS_LIKE = "reading-likes";
	const LS_COMMENT = "reading-comments";
	const getLikes = () => {
		try { return JSON.parse(localStorage.getItem(LS_LIKE) || "{}"); } catch { return {}; }
	};
	const getComments = () => {
		try { return JSON.parse(localStorage.getItem(LS_COMMENT) || "{}"); } catch { return {}; }
	};
	const saveLikes = (o) => localStorage.setItem(LS_LIKE, JSON.stringify(o));
	const saveComments = (o) => localStorage.setItem(LS_COMMENT, JSON.stringify(o));
	const esc = (s) =>
		s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
	const fmtTime = (t) => {
		const d = new Date(t);
		const p = (n) => String(n).padStart(2, "0");
		return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
	};

	function initReadingInteractions() {
		document.querySelectorAll("button[data-like]").forEach((btn) => {
			if (btn.dataset.init) return;
			btn.dataset.init = "1";
			const id = btn.getAttribute("data-like") || "";
			const countEl = btn.querySelector(".like-count");
			const base = countEl ? Number.parseInt(countEl.dataset.base || "0", 10) : 0;
			const liked = !!getLikes()[id];
			btn.classList.toggle("is-liked", liked);
			if (countEl) countEl.textContent = String(base + (liked ? 1 : 0));
			btn.addEventListener("click", () => {
				const lk = getLikes();
				const now = !lk[id];
				if (now) lk[id] = true; else delete lk[id];
				saveLikes(lk);
				btn.classList.toggle("is-liked", now);
				if (countEl) countEl.textContent = String(base + (now ? 1 : 0));
			});
		});

		document.querySelectorAll(".rc-list[data-list]").forEach((list) => {
			if (list.dataset.initList) return;
			list.dataset.initList = "1";
			const id = list.getAttribute("data-list") || "";
			const update = () => {
				const arr = getComments()[id] || [];
				const countEl = document.querySelector(`.comment-count[data-comment-count="${id}"]`);
				if (countEl) {
					const base = Number.parseInt(countEl.dataset.base || "0", 10);
					countEl.textContent = String(base + arr.length);
				}
				if (!arr.length) {
					list.innerHTML = `<p class="rc-empty">还没有评论，来抢沙发～</p>`;
					return;
				}
				list.innerHTML = arr
					.map(
						(c) => `
					<div class="rc-item">
						<div class="rc-meta"><span class="rc-name-text">${esc(c.name)}</span><span class="rc-time">${fmtTime(c.time)}</span></div>
						<div class="rc-text">${esc(c.text)}</div>
					</div>`,
					)
					.join("");
			};
			list._update = update;
			update();
		});

		document.querySelectorAll("form[data-form]").forEach((form) => {
			if (form.dataset.initForm) return;
			form.dataset.initForm = "1";
			const id = form.getAttribute("data-form") || "";
			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const nameEl = form.querySelector(".rc-name");
				const inputEl = form.querySelector(".rc-input");
				if (!nameEl || !inputEl) return;
				const name = (nameEl.value || "匿名").trim() || "匿名";
				const text = (inputEl.value || "").trim();
				if (!text) { inputEl.focus(); return; }
				const all = getComments();
				all[id] = all[id] || [];
				all[id].push({ name, text, time: Date.now() });
				saveComments(all);
				inputEl.value = "";
				const list = document.querySelector(`.rc-list[data-list="${id}"]`);
				if (list && list._update) list._update();
			});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initReadingInteractions);
	} else {
		initReadingInteractions();
	}
	document.addEventListener("swup:page:view", initReadingInteractions);
</script>
