---
// 阅读详情页：展示单本书的完整阅读感悟
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { bookNotes } from "@/data/books";
import { profileConfig } from "@/config";
import { commentConfig } from "@/config/commentConfig";
import Twikoo from "@/components/comment/Twikoo.astro";

// Twikoo 评论系统环境（详情页真实评论）
const twikooEnvId = commentConfig.twikoo?.envId || "";
const twikooLang = commentConfig.twikoo?.lang || "zh-CN";

export function getStaticPaths() {
	return bookNotes.map((book) => ({
		params: { id: book.id },
		props: { book },
	}));
}

const { book } = Astro.props;
const title = "阅读 · " + book.title;
const description = book.feeling.slice(0, 60);
---

<MainGridLayout title={title} description={description}>
	<div class="rd-detail">
		<a class="rd-back" href="/reading/">‹ 返回阅读</a>

		<article class="rd-card card-base rounded-[var(--radius-large)]">
			<header class="rd-head">
				<img class="rd-avatar" src={profileConfig.avatar} alt="" loading="lazy" />
				<div class="rd-meta">
					<span class="rd-name">{profileConfig.name}</span>
					<span class="rd-time">{book.date}</span>
				</div>
			</header>

			<div class="rd-book" style={`--book-hue:${book.hue}deg;`}>
				<span class="rd-cover">{book.cover}</span>
				<div class="rd-book-info">
					<h3 class="rd-title">《{book.title}》</h3>
					<p class="rd-author-line">{book.author}</p>
				</div>
			</div>

			<div class="rd-feeling">
				{book.feeling.split("\n").map((para) => (
					<p class="rd-para">{para}</p>
				))}
			</div>

			<div class="rd-tags">
				{book.tags.map((tag) => (
					<span class="rd-tag">{tag}</span>
				))}
			</div>

			<footer class="rd-footer">
				<button type="button" class="rd-action rd-like-btn" data-like={book.id}>
					<span class="rd-like-ic">♥</span>
					<span class="like-count" data-base={book.likes}>{book.likes}</span>
				</button>
				<span class="rd-action" id="comments">
					<span>💬</span>
					<span class="comment-count" data-comment-count={book.id} data-base={book.comments}>{book.comments}</span>
				</span>
			</footer>

			<div class="rd-comments">
				<Twikoo path={`/reading/${book.id}`} />
			</div>
		</article>
	</div>
</MainGridLayout>

<style>
	.rd-detail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 680px;
		margin: 0 auto;
	}
	.rd-back {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--content-meta);
		text-decoration: none;
		transition: color 0.18s ease;
	}
	.rd-back:hover {
		color: var(--primary);
	}

	.rd-card {
		padding: 1.4rem 1.6rem 1.2rem;
	}
	.rd-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	.rd-avatar {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.rd-meta {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.rd-name {
		font-weight: 700;
		color: var(--deep-text);
	}
	.rd-time {
		font-size: 0.78rem;
		color: var(--content-meta);
	}

	.rd-book {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.8rem 0.9rem;
		border-radius: 0.85rem;
		background: linear-gradient(
			135deg,
			oklch(0.42 0.07 var(--book-hue, 210)) 0%,
			oklch(0.28 0.05 var(--book-hue, 250)) 100%
		);
		border: 1px solid oklch(0.55 0.08 var(--book-hue, 210) / 0.35);
		margin-bottom: 1rem;
	}
	.rd-cover {
		font-size: 2.4rem;
		line-height: 1;
	}
	.rd-book-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.rd-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
		color: #fff;
	}
	.rd-author-line {
		margin: 0;
		font-size: 0.8rem;
		color: oklch(0.9 0.02 var(--book-hue) / 0.9);
	}

	.rd-feeling {
		margin: 0 0 1rem;
	}
	.rd-para {
		margin: 0 0 0.7rem;
		font-size: 0.96rem;
		line-height: 1.8;
		color: var(--content-normal);
	}
	.rd-para:last-child {
		margin-bottom: 0;
	}

	.rd-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.9rem;
	}
	.rd-tag {
		font-size: 0.72rem;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 14%, transparent);
		color: var(--primary);
		border: 1px solid color-mix(in oklch, var(--primary) 28%, transparent);
	}

	.rd-footer {
		display: flex;
		gap: 1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--line-color);
		color: var(--content-meta);
		font-size: 0.82rem;
	}
	.rd-like-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: none;
		background: transparent;
		color: var(--content-meta);
		font-size: 0.82rem;
		cursor: pointer;
		border-radius: 0.4rem;
		padding: 0.25rem 0.4rem;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.rd-like-btn:hover {
		color: var(--primary);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.rd-like-btn.is-liked {
		color: #ff5a79;
	}
	.rd-like-ic {
		font-size: 1rem;
		line-height: 1;
	}

	/* 评论区（详情页常显，Twikoo 真实评论） */
	.rd-comments {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line-color);
	}
	/* Twikoo 注入 DOM 的主题适配 */
	.rd-comments :global(.tk-main) {
		background: transparent !important;
		box-shadow: none !important;
	}

	@media (max-width: 768px) {
		.rd-card {
			padding: 1.1rem 1.1rem 1rem;
		}
	}
</style>

<script>
	// 阅读详情页交互：点赞（本地持久）+ 评论计数刷新（接入 Twikoo 真实后端）
	const LS_LIKE = "reading-likes";
	const getLikes = () => {
		try { return JSON.parse(localStorage.getItem(LS_LIKE) || "{}"); } catch { return {}; }
	};
	const saveLikes = (o) => localStorage.setItem(LS_LIKE, JSON.stringify(o));

	function initReadingInteractions() {
		document.querySelectorAll("button[data-like]").forEach((btn) => {
			if (btn.dataset.init) return;
			btn.dataset.init = "1";
			const id = btn.getAttribute("data-like") || "";
			const countEl = btn.querySelector(".like-count");
			const base = countEl ? Number.parseInt(countEl.dataset.base || "0", 10) : 0;
			const liked = !!getLikes()[id];
			btn.classList.toggle("is-liked", liked);
			if (countEl) countEl.textContent = String(base + (liked ? 1 : 0));
			btn.addEventListener("click", () => {
				const lk = getLikes();
				const now = !lk[id];
				if (now) lk[id] = true; else delete lk[id];
				saveLikes(lk);
				btn.classList.toggle("is-liked", now);
				if (countEl) countEl.textContent = String(base + (now ? 1 : 0));
			});
		});

		// ---- 刷新真实评论计数（Twikoo 后端）----
		refreshCommentCounts();
	}

	function whenTwikoo(cb) {
		if (typeof window.twikoo !== "undefined") { cb(); return; }
		setTimeout(() => whenTwikoo(cb), 300);
	}

	function refreshCommentCounts() {
		whenTwikoo(() => {
			if (!window.twikoo.getCommentsCount) return;
			const el = document.querySelector(".comment-count[data-comment-count]");
			if (!el) return;
			const id = el.getAttribute("data-comment-count");
			window.twikoo
				.getCommentsCount({ envId: window.__twikooEnv, urls: [`/reading/${id}`], includeReply: true })
				.then((res) => { if (res && res[0]) el.textContent = String(res[0].count); })
				.catch(() => {});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initReadingInteractions);
	} else {
		initReadingInteractions();
	}
	document.addEventListener("swup:page:view", initReadingInteractions);
</script>

<!-- 设置 Twikoo 环境 ID，供评论计数刷新使用 -->
<script is:inline define:vars={{ twikooEnvId, twikooLang }}>
	window.__twikooEnv = twikooEnvId;
	window.__twikooLang = twikooLang;
</script>
