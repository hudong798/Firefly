---
import Layout from "@layouts/Layout.astro";
import AdminEchoes from "@/components/admin/AdminEchoes.svelte";
---

<Layout title="回声管理 - FreeX" description="管理回声内容">
	<main class="admin-page">
		<AdminEchoes client:only="svelte" />
	</main>
</Layout>

<style is:global>
	.admin-page {
		min-height: 100vh;
		padding-top: 80px;
		background: #050811;
		background-image:
			radial-gradient(ellipse at 20% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
			radial-gradient(ellipse at 80% 100%, rgba(139, 92, 246, 0.06) 0%, transparent 50%);
	}
</style>
