---
import Layout from "@layouts/Layout.astro";
import AdminComments from "@components/admin/AdminComments.svelte";
---

<Layout title="评论管理 - FreeX" description="管理网站评论">
	<main class="admin-page">
		<AdminComments client:only="svelte" />
	</main>
</Layout>

<style is:global>
	.admin-page {
		min-height: 100vh;
		padding-top: 80px;
		background: #050811;
		background-image:
			radial-gradient(ellipse at 20% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
			radial-gradient(ellipse at 80% 100%, rgba(139, 92, 246, 0.06) 0%, transparent 50%);
	}

	.admin-page body,
	.admin-page html {
		background: #050811 !important;
	}
</style>
