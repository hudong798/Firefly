---
// 说说详情页：展示单条说说的完整内容
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { moments } from "@/data/thoughts";

export function getStaticPaths() {
	return moments.map((m) => ({
		params: { id: m.id },
		props: { moment: m },
	}));
}

const { moment } = Astro.props;
const title = "说说 · " + moment.date;
const description = moment.content.slice(0, 60);
---

<MainGridLayout title={title} description={description}>
	<div class="thought-detail">
		<a class="td-back" href="/thoughts/">‹ 返回说说</a>

		<article class="td-card card-base rounded-[var(--radius-large)]">
			<header class="td-head">
				<span class="td-name">Idong</span>
				<span class="td-time">
					{moment.mood && <span class="td-mood">{moment.mood}</span>}
					{moment.date}
				</span>
			</header>

			<p class="td-content">{moment.content}</p>

			{
				moment.tags && moment.tags.length > 0 && (
					<div class="td-tags">
						{moment.tags.map((t) => (
							<span class="td-tag">#{t}</span>
						))}
					</div>
				)
			}
		</article>
	</div>
</MainGridLayout>

<style>
	.thought-detail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.td-back {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--content-meta);
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.td-back:hover {
		color: var(--primary);
	}

	.td-card {
		padding: 1.4rem 1.6rem 1.2rem;
	}

	.td-head {
		display: flex;
		align-items: center;
	}

	.td-name {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--primary);
	}

	.td-time {
		font-size: 0.8rem;
		color: var(--content-meta);
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: 0.7rem;
	}

	.td-mood {
		font-size: 0.95rem;
	}

	.td-content {
		margin: 1rem 0 0;
		font-size: 1rem;
		line-height: 1.9;
		white-space: pre-wrap;
		word-break: break-word;
		color: var(--btn-content);
	}

	.td-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.9rem;
	}

	.td-tag {
		font-size: 0.8rem;
		color: var(--primary);
	}

	@media (max-width: 768px) {
		.td-card {
			padding: 1.1rem 1.1rem 1rem;
		}
	}
</style>
