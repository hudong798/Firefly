---
// 说说详情页：客户端按 ?slug=xxx 加载单条说说完整内容（含图片、上锁解锁）
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ClientEchoDetail from "@/components/workbench/ClientEchoDetail.svelte";

const title = "说说详情";
const description = "岁月留痕";
---

<MainGridLayout title={title} description={description}>
	<div class="echo-detail-vignette" aria-hidden="true"></div>
	<ClientEchoDetail client:only="svelte" />
</MainGridLayout>

<style>
	.echo-detail-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 65% 55% at 45% 40%, rgba(3, 5, 10, 0.5) 0%, rgba(3, 5, 10, 0.25) 50%, transparent 80%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.15) 0%, transparent 12%, transparent 88%, rgba(3, 5, 10, 0.2) 100%);
	}
</style>

<style is:global>
	/* 全局兜底：保证任何说说详情都显示深色液态玻璃卡片，避免 Svelte 样式缓存 */
	.ed-card {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 3rem;
		padding: 3rem;
		background: linear-gradient(160deg, rgba(30, 32, 54, 0.72), rgba(16, 18, 32, 0.78)) !important;
		border: 1px solid rgba(155, 140, 255, 0.28) !important;
		border-radius: 1.25rem !important;
		backdrop-filter: blur(18px) saturate(1.3);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), 0 0 24px rgba(155, 140, 255, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;
	}
	@media (max-width: 768px) {
		.ed-card {
			grid-template-columns: 1fr !important;
			gap: 1rem !important;
			padding: 1.5rem !important;
		}
	}
</style>
