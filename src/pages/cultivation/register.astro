---
import CultivationLayout from "@layouts/CultivationLayout.astro";
---

<CultivationLayout title="注册" description="注册修仙界">
	<a href="/" class="cult-login-home" aria-label="返回首页" title="返回首页">
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 9.5 12 3l9 6.5"/>
			<path d="M5 10v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V10"/>
			<path d="M9 21v-6h6v6"/>
		</svg>
	</a>
	<div class="cult-register-page">
		<div class="cult-register-card">
			<div class="cult-register-header">
				<div class="cult-register-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20 7 7 0 0 0 0-10 7 7 0 0 1 0-10z"/></svg></div>
				<h1>加入修仙界</h1>
				<p>创建你的道号，开始修仙之旅</p>
			</div>

			<div id="cult-register-form-container"></div>

			<div class="cult-register-footer">
				<p>已有账号？<a href="/cultivation/login/">立即登录</a></p>
			</div>
		</div>
	</div>
</CultivationLayout>

<script>
	import { register, validateInvitationCode, useInvitationCode, getCurrentUser } from "@/services/cultivation";

	const container = document.getElementById("cult-register-form-container");
	if (container) {
		let error = "";
		let success = "";
		let loading = false;

		function render() {
			container.innerHTML = `
				<div class="cult-form-group">
					<label for="username">道号 *</label>
					<input type="text" id="username" placeholder="输入你的道号（唯一，用于登录）" autocomplete="username" />
				</div>
				<div class="cult-form-group">
					<label for="invitation-code">邀请码 *</label>
					<input type="text" id="invitation-code" placeholder="输入宗主发放的邀请码" autocomplete="off" />
				</div>
				<div class="cult-form-group">
					<label for="password">密码 *</label>
					<input type="password" id="password" placeholder="至少6位密码" autocomplete="new-password" />
				</div>
				<div class="cult-form-group">
					<label for="confirm-password">确认密码 *</label>
					<input type="password" id="confirm-password" placeholder="再次输入密码" autocomplete="new-password" />
				</div>
				${error ? `<div class="cult-error-message">${error}</div>` : ""}
				${success ? `<div class="cult-success-message">${success}</div>` : ""}
				<button class="cult-register-btn" ${loading ? "disabled" : ""}>
					${loading ? "注册中..." : "加入修仙界"}
				</button>
			`;

			const btn = container.querySelector(".cult-register-btn");
			const inputs = container.querySelectorAll("input");
			btn?.addEventListener("click", handleRegister);
			inputs.forEach((input, i) => {
				input.addEventListener("keydown", (e) => {
					if (e.key === "Enter") {
						if (i < inputs.length - 1) {
							(inputs[i + 1] as HTMLElement).focus();
						} else {
							handleRegister();
						}
					}
				});
			});
		}

		async function handleRegister() {
			const username = (document.getElementById("username") as HTMLInputElement)?.value.trim();
			const invitationCode = (document.getElementById("invitation-code") as HTMLInputElement)?.value.trim();
			const password = (document.getElementById("password") as HTMLInputElement)?.value;
			const confirmPassword = (document.getElementById("confirm-password") as HTMLInputElement)?.value;

			if (!username || !invitationCode || !password) {
				error = "请填写道号、邀请码和密码";
				render();
				return;
			}

			if (password.length < 6) {
				error = "密码至少6位";
				render();
				return;
			}

			if (password !== confirmPassword) {
				error = "两次输入的密码不一致";
				render();
				return;
			}

			loading = true;
			error = "";
			success = "";
			render();

			// 先验证邀请码
			const validateResult = await validateInvitationCode(invitationCode);
			if (!validateResult.success) {
				loading = false;
				error = validateResult.error || "邀请码无效";
				render();
				return;
			}

			// 注册用户
			const result = await register(username, "", password);
			if (!result.success) {
				loading = false;
				error = result.error || "注册失败";
				render();
				return;
			}

			// 注册成功后，使用邀请码（需要先登录获取用户ID）
			// 由于注册后需要登录才能获取用户ID，这里先标记邀请码为待使用
			// 实际使用邀请码的操作在用户首次登录时完成
			// 为了简化，这里直接使用邀请码（需要用户ID）
			// 由于注册后用户未登录，无法获取用户ID，所以我们在注册时直接使用邀请码
			// 这里需要修改 register 函数，让它返回用户ID
			// 暂时先跳过使用邀请码的步骤，在用户首次登录时使用

			loading = false;
			success = "注册成功！正在跳转到登录页...";
			render();

			// 保存邀请码到 sessionStorage，登录后使用
			sessionStorage.setItem("pending_invitation_code", invitationCode);

			setTimeout(() => {
				window.location.href = "/cultivation/login/";
			}, 1500);
		}

		render();
	}
</script>

<style is:global>
	.cult-login-home {
		position: fixed;
		top: calc(16px + env(safe-area-inset-top, 0px));
		right: 16px;
		z-index: 100;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(139, 92, 246, 0.3);
		color: #c4b5fd;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
		transition: transform 0.18s ease, background 0.18s ease;
	}

	.cult-login-home:active {
		transform: scale(0.9);
		background: rgba(139, 92, 246, 0.4);
	}

	@media (min-width: 768px) {
		.cult-login-home {
			top: 24px;
			right: 24px;
		}
	}

	.cult-register-page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.cult-register-card {
		width: 100%;
		max-width: 440px;
		padding: 2.5rem 2rem;
		background: rgba(15, 23, 42, 0.9);
		border: 1px solid rgba(99, 102, 241, 0.25);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
	}

	.cult-register-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.cult-register-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #a78bfa;
	}

	.cult-register-header h1 {
		font-size: 1.5rem;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: #f1f5f9;
	}

	.cult-register-header p {
		font-size: 0.9rem;
		color: #94a3b8;
		margin: 0;
	}

	.cult-form-group {
		margin-bottom: 1rem;
	}

	.cult-form-group label {
		display: block;
		font-size: 0.85rem;
		color: #cbd5e1;
		margin-bottom: 0.4rem;
		font-weight: 500;
	}

	.cult-form-group input {
		width: 100%;
		padding: 0.85rem 1rem;
		background: #1e293b;
		border: 1px solid rgba(148, 163, 184, 0.3);
		border-radius: 10px;
		color: #f1f5f9;
		font-size: 0.95rem;
		box-sizing: border-box;
		transition: all 0.2s;
		-webkit-appearance: none;
		appearance: none;
	}

	.cult-form-group input:focus {
		outline: none;
		border-color: #818cf8;
		background: #1e293b;
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
	}

	.cult-form-group input::placeholder {
		color: #64748b;
	}

	.cult-error-message {
		padding: 0.6rem 0.85rem;
		background: rgba(239, 68, 68, 0.15);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.3);
		border-radius: 8px;
		font-size: 0.85rem;
		margin-bottom: 1rem;
	}

	.cult-success-message {
		padding: 0.6rem 0.85rem;
		background: rgba(16, 185, 129, 0.15);
		color: #34d399;
		border: 1px solid rgba(16, 185, 129, 0.3);
		border-radius: 8px;
		font-size: 0.85rem;
		margin-bottom: 1rem;
	}

	.cult-register-btn {
		width: 100%;
		padding: 0.9rem;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		border: none;
		border-radius: 10px;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
		margin-top: 0.5rem;
	}

	.cult-register-btn:hover:not(:disabled) {
		opacity: 0.92;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);
	}

	.cult-register-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.cult-register-footer {
		text-align: center;
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: #94a3b8;
	}

	.cult-register-footer p {
		margin: 0.5rem 0;
	}

	.cult-register-footer a {
		color: #a78bfa;
		text-decoration: none;
	}

	.cult-register-footer a:hover {
		text-decoration: underline;
	}
</style>
