---
import CultivationLayout from "@layouts/CultivationLayout.astro";
---

<CultivationLayout title="登录" description="童话小镇">
	<div class="cult-login-page">
		<div class="cult-login-card">
			<div class="cult-login-header">
				<div class="cult-login-icon">
					<svg width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
						<!-- 可达鸭头部 -->
						<ellipse cx="32" cy="34" rx="20" ry="18" fill="#FFD93D"/>
						<!-- 头顶三根毛 -->
						<path d="M24 18 Q22 10 26 12 Q28 14 27 18" fill="#FFD93D" stroke="#E6B800" stroke-width="1"/>
						<path d="M32 14 Q32 6 34 10 Q36 14 34 18" fill="#FFD93D" stroke="#E6B800" stroke-width="1"/>
						<path d="M40 18 Q42 10 38 12 Q36 14 37 18" fill="#FFD93D" stroke="#E6B800" stroke-width="1"/>
						<!-- 眼睛 -->
						<ellipse cx="25" cy="30" rx="3" ry="4" fill="white"/>
						<ellipse cx="39" cy="30" rx="3" ry="4" fill="white"/>
						<circle cx="25" cy="31" r="1.8" fill="#1a1a2e"/>
						<circle cx="39" cy="31" r="1.8" fill="#1a1a2e"/>
						<!-- 鸭嘴 -->
						<path d="M24 38 Q32 44 40 38 Q38 46 32 46 Q26 46 24 38" fill="#FF8C00"/>
						<path d="M24 38 Q32 42 40 38" stroke="#CC7000" stroke-width="1" fill="none"/>
						<!-- 腮红 -->
						<ellipse cx="19" cy="36" rx="2.5" ry="1.5" fill="#FF6B6B" opacity="0.5"/>
						<ellipse cx="45" cy="36" rx="2.5" ry="1.5" fill="#FF6B6B" opacity="0.5"/>
						<!-- 头痛的手 -->
						<path d="M14 28 Q10 24 14 22 Q18 22 18 26" fill="#FFD93D" stroke="#E6B800" stroke-width="1"/>
						<path d="M50 28 Q54 24 50 22 Q46 22 46 26" fill="#FFD93D" stroke="#E6B800" stroke-width="1"/>
					</svg>
				</div>
				<h1>童话小镇</h1>
				<p>输入你的道号和密码，进入童话世界</p>
			</div>

			<div id="cult-login-form-container"></div>

			<div class="cult-login-footer">
				<p>还没有账号？<a href="/cultivation/register/">立即注册</a></p>
				<p><a href="/">返回 FreeX 首页</a></p>
			</div>
		</div>
	</div>
</CultivationLayout>

<script>
	import { login, useInvitationCode, getCurrentUser } from "@/services/cultivation";

	const container = document.getElementById("cult-login-form-container");
	if (container) {
		let error = "";
		let loading = false;

		function render() {
			container.innerHTML = `
				<div class="cult-form-group">
					<label for="identifier">道号</label>
					<input type="text" id="identifier" placeholder="输入你的道号" autocomplete="username" />
				</div>
				<div class="cult-form-group">
					<label for="password">密码</label>
					<input type="password" id="password" placeholder="输入密码" autocomplete="current-password" />
				</div>
				${error ? `<div class="cult-error-message">${error}</div>` : ""}
				<button class="cult-login-btn" ${loading ? "disabled" : ""}>
					${loading ? "登录中..." : "进入小镇"}
				</button>
			`;

			const btn = container.querySelector(".cult-login-btn");
			const idInput = container.querySelector("#identifier");
			const pwInput = container.querySelector("#password");

			btn?.addEventListener("click", handleLogin);
			pwInput?.addEventListener("keydown", (e) => {
				if (e.key === "Enter") handleLogin();
			});
			idInput?.addEventListener("keydown", (e) => {
				if (e.key === "Enter") pwInput?.focus();
			});
		}

		async function handleLogin() {
			const identifier = (document.getElementById("identifier") as HTMLInputElement)?.value.trim();
			const password = (document.getElementById("password") as HTMLInputElement)?.value;

			if (!identifier || !password) {
				error = "请输入道号和密码";
				render();
				return;
			}

			loading = true;
			error = "";
			render();

			const result = await login(identifier, password);
			loading = false;

			if (result.success) {
				// 检查是否有待使用的邀请码
				const pendingCode = sessionStorage.getItem("pending_invitation_code");
				if (pendingCode) {
					try {
						const user = await getCurrentUser();
						if (user) {
							await useInvitationCode(pendingCode, user.id);
						}
					} catch (e) {
						console.error("使用邀请码失败:", e);
					}
					sessionStorage.removeItem("pending_invitation_code");
				}
				window.location.href = "/cultivation/";
			} else {
				error = result.error || "登录失败";
				render();
			}
		}

		render();
	}
</script>

<style is:global>
	.cult-login-page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.cult-login-card {
		width: 100%;
		max-width: 420px;
		padding: 2.5rem 2rem;
		background: rgba(15, 23, 42, 0.9);
		border: 1px solid rgba(99, 102, 241, 0.25);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
	}

	.cult-login-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.cult-login-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #a78bfa;
	}

	.cult-login-header h1 {
		font-size: 1.5rem;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: #f1f5f9;
	}

	.cult-login-header p {
		font-size: 0.9rem;
		color: #94a3b8;
		margin: 0;
	}

	.cult-form-group {
		margin-bottom: 1.25rem;
	}

	.cult-form-group label {
		display: block;
		font-size: 0.85rem;
		color: #cbd5e1;
		margin-bottom: 0.5rem;
		font-weight: 500;
	}

	.cult-form-group input {
		width: 100%;
		padding: 0.85rem 1rem;
		background: #1e293b;
		border: 1px solid rgba(148, 163, 184, 0.3);
		border-radius: 10px;
		color: #f1f5f9;
		font-size: 0.95rem;
		box-sizing: border-box;
		transition: all 0.2s;
		-webkit-appearance: none;
		appearance: none;
	}

	.cult-form-group input:focus {
		outline: none;
		border-color: #818cf8;
		background: #1e293b;
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
	}

	.cult-form-group input::placeholder {
		color: #64748b;
	}

	.cult-error-message {
		padding: 0.6rem 0.85rem;
		background: rgba(239, 68, 68, 0.15);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.3);
		border-radius: 8px;
		font-size: 0.85rem;
		margin-bottom: 1rem;
	}

	.cult-login-btn {
		width: 100%;
		padding: 0.9rem;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		border: none;
		border-radius: 10px;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
		margin-top: 0.5rem;
	}

	.cult-login-btn:hover:not(:disabled) {
		opacity: 0.92;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);
	}

	.cult-login-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.cult-login-footer {
		text-align: center;
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: #94a3b8;
	}

	.cult-login-footer p {
		margin: 0.5rem 0;
	}

	.cult-login-footer a {
		color: #a78bfa;
		text-decoration: none;
	}

	.cult-login-footer a:hover {
		text-decoration: underline;
	}
</style>
