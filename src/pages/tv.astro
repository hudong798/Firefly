---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import ThoughtList from "@/components/workbench/ThoughtList.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

const title = "影视";
const description = "影视推荐与观后感";

const post = await getEntry("spec", "tv");

if (!post) {
	throw new Error("tv page content not found");
}

const { Content } = await render(post);

// 相关文章：分类为「影视」的文章归入本板块
const relatedPosts = (await getSortedPosts()).filter(
	(p) => p.data.category === "影视",
);
---

<MainGridLayout title={title} description={description}>
	<div class="page-card card-base rounded-[var(--radius-large)]">
		<Markdown class="markdown-content">
			<Content />
		</Markdown>
	</div>

	{
		relatedPosts.length > 0 && (
			<>
				<h2 class="section-h2">📄 相关文章</h2>
				<ThoughtList posts={relatedPosts} />
			</>
		)
	}
</MainGridLayout>

<style>
	.page-card {
		padding: 1.5rem 1.8rem;
	}
	.section-h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 1.6rem 0 0.9rem;
	}
	@media (max-width: 768px) {
		.page-card {
			padding: 1.1rem 1rem;
		}
	}
	/* 内容页面表格美化：圆角卡片式 + 斑马纹 + 悬停高亮 */
	:global(.markdown-content table) {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		border-radius: 0.75rem;
		overflow: hidden;
		border: 1px solid var(--line-color);
		box-shadow: 0 1px 8px oklch(0.35 0.03 var(--hue) / 0.1);
	}
	:global(.markdown-content thead th) {
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		font-weight: 700;
		text-align: left;
		padding: 0.6rem 0.9rem;
		border: none;
	}
	:global(.markdown-content tbody td) {
		padding: 0.55rem 0.9rem;
		border: none;
		border-top: 1px solid var(--line-color);
	}
	:global(.markdown-content tbody tr:nth-child(even)) {
		background: color-mix(in oklch, var(--primary) 4%, transparent);
	}
	:global(.markdown-content tbody tr:hover) {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	:global(.markdown-content tbody td:first-child) {
		font-weight: 600;
		white-space: nowrap;
	}
</style>
