      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:12px 16px;
    }

    .row{
      gap:14px;
      min-height:78px;
      margin:0;
      padding:12px 16px;
      border-radius:12px;
      transition:transform .18s ease,background .18s ease,box-shadow .18s ease;
    }

    .row:hover{
      transform:translateY(-2px);
      background:rgba(25,52,107,.88);
      box-shadow:0 8px 24px rgba(0,0,0,.18);
    }

    .row .rk{
      width:42px;
      font-size:20px;
    }

    .row .ava{
      width:54px;
      height:54px;
      border-width:2px;
    }

    .row .nm{font-size:16px;gap:8px}
