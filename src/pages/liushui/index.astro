  .stat b{display:block;font-size:.32rem;color:var(--gold);font-variant-numeric:tabular-nums}
  .stat span{font-size:.2rem;color:var(--ink-soft)}

  /* Tab */
  .tabs{
    position:sticky;top:0;z-index:50;display:flex;gap:.14rem;
    background:var(--tab-bg);border-radius:.999rem;padding:.07rem;
    box-shadow:0 .06rem .2rem rgba(0,0,0,.22);
