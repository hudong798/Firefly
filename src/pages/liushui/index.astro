const LVS = [
  {min:400000, name:'砖石', cls:'lv-3'},
  {min:150000, name:'黄金', cls:'lv-2'},
  {min:50000,  name:'白银', cls:'lv-1'},
  {min:0,      name:'青铜', cls:'lv-0'}
];
const lvOf = s => LVS.find(l => s >= l.min);
const fmt = n => n.toLocaleString('zh-CN');
const esc = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

let cur = 'zhubo', kw = '';

function avatar(u, cls){
  const inner = u.a
    ? '<img src="'+esc(u.a)+'" loading="lazy" onerror="this.parentNode.innerHTML=ph(this.dataset.n)" data-n="'+esc(u.n)+'">'
    : ph(u.n);
  const live = u.l ? '<span class="live-dot">LIVE</span>' : '';
  return '<div class="ava '+cls+'">'+inner+live+'</div>';
}
function ph(n){ return '<div class="ph">'+esc((n||'?')[0])+'</div>'; }

function render(){
  let rows = DATA[cur];
  const total = rows.reduce((a,u)=>a+u.s,0);
  const top = rows[0];
  document.getElementById('stats').innerHTML =
    '<div class="stat"><b>'+rows.length+'</b><span>上榜人数</span></div>'+
    '<div class="stat"><b>'+fmt(total)+'</b><span>总战力值</span></div>'+
    '<div class="stat"><b>'+fmt(top.s)+'</b><span>榜首战力</span></div>';

  const q = kw.trim().toLowerCase();
  const shown = q ? rows.filter(u => u.n.toLowerCase().includes(q)) : rows;

  // 领奖台
  const top3 = shown.slice(0,3);
  const order = top3.length === 3 ? [top3[1],top3[0],top3[2]] : top3;
  const pcls = u => u===top3[0]?'p1':(u===top3[1]?'p2':'p3');
  const colors = {1:'#ffd86b',2:'#cdd6e4',3:'#e8a080'};
  let pod = '<div class="podium">';
  order.forEach(u=>{
    const k = top3.indexOf(u)+1;
    pod += '<div class="pod '+pcls(u)+'" style="--c:'+colors[k]+'">'
      + (k===1?'<div class="crown">👑</div>':'')
      + avatar(u,'')
      + '<div class="nm">'+esc(u.n)+'</div>'
      + '<div class="sc">'+fmt(u.s)+'</div>'
      + '<div class="base">'+k+'</div></div>';
  });
  pod += '</div>';
  document.getElementById('podium').innerHTML = pod;

  // 列表
  const rest = shown.slice(3);
  let html = '';
  rest.forEach(u=>{
    const lv = lvOf(u.s);
    html += '<div class="row">'
      + '<div class="rk">'+u.r+'</div>'
      + avatar(u,'')
      + '<div class="info"><div class="nm"><b>'+esc(u.n)+'</b>'
      + (u.l?'<span class="live">LIVE</span>':'')+'</div>'
      + '<span class="lv '+lv.cls+'">'+lv.name+'</span></div>'
      + '<div class="sc">'+fmt(u.s)+'<small>战力值</small></div></div>';
  });
  document.getElementById('list').innerHTML =
    html || '<div class="empty">没有找到「'+esc(kw)+'」相关的上榜用户</div>';
}

document.getElementById('tabs').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  document.querySelectorAll('#tabs button').forEach(x=>x.classList.toggle('on', x===b));
  cur = b.dataset.k; render();
});
document.getElementById('q').addEventListener('input', e=>{ kw = e.target.value; render(); });

// 星星
(function(){
  const box = document.getElementById('stars');
  let s = '';
  for(let i=0;i<26;i++){
    const sz = 2+Math.random()*3;
    s += '<i style="left:'+(Math.random()*100)+'vw;top:'+(Math.random()*100)+'vh;width:'+sz+'px;height:'+sz+'px;animation-delay:'+(Math.random()*3)+'s"></i>';
  }
  box.innerHTML = s;
})();

render();
</script>
</body>
</html>