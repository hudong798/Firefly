    flex:1;border:1px solid var(--card-line);background:var(--card);color:var(--ink);
    border-radius:.999rem;padding:.15rem .3rem;font-size:.24rem;outline:none;font-family:inherit;
  }
  .search input::placeholder{color:#8ea7d8}
  .search input:focus{border-color:var(--tab-bg)}

  /* Top3 领奖台 */
