---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/misc/Markdown.astro";
import { commentConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");

if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}

const { Content } = await render(guestbookPost);

// 检查评论系统是否启用
const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";

// 页面标题和描述
const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
---

<MainGridLayout title={title} description={description}>
	<!-- Reading Quiet Zone：评论区局部暗层，降低星星密度 -->
	<div class="gb-reading-vignette" aria-hidden="true"></div>

	<!-- 统一内容容器：确保标题和评论对齐 -->
	<div class="gb-container">
		<!-- 头部：Digital Observatory 风格 -->
		<header class="gb-header">
			<div class="gb-header-label">
				<span class="gb-header-label-text">VISITOR SIGNALS</span>
				<span class="gb-header-label-line"></span>
			</div>
			<h1 class="gb-title">{title}</h1>
			<p class="gb-sub">欢迎在这里留下你的足迹，分享你的想法和建议。</p>
		</header>

		<!-- 留言区 -->
		<section class="gb-comments">
			{
				isCommentEnabled ? (
					<Comment post={guestbookPost} customPath="/guestbook/" hideHeader />
				) : (
					<div class="gb-empty">
						<div class="gb-empty-dot"></div>
						<p class="gb-empty-title">NO SIGNALS YET</p>
						<p class="gb-empty-sub">还没有来自这个宇宙的信号。</p>
					</div>
				)
			}
		</section>
	</div>
</MainGridLayout>

<style>
	/* Reading Quiet Zone：评论区局部暗层，自然降低星星可见度 */
	.gb-reading-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 70% 60% at 50% 45%, rgba(3, 5, 10, 0.55) 0%, rgba(3, 5, 10, 0.3) 50%, transparent 80%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.2) 0%, transparent 15%, transparent 85%, rgba(3, 5, 10, 0.25) 100%);
	}

	/* 统一内容容器：确保标题和评论对齐 */
	.gb-container {
		position: relative;
		z-index: 2;
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* 确保内容在遮罩层之上 */
	.gb-header,
	.gb-comments {
		position: relative;
		z-index: 2;
		width: 100%;
	}

	/* 头部 */
	.gb-header {
		margin-bottom: 2.5rem;
		padding-top: 1rem;
	}

	.gb-header-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.gb-header-label-text {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		color: rgba(155, 140, 255, 0.5);
		text-transform: uppercase;
	}

	.gb-header-label-line {
		flex: 1;
		max-width: 120px;
		height: 1px;
		background: linear-gradient(90deg, rgba(155, 140, 255, 0.15), transparent);
	}

	.gb-title {
		margin: 0 0 0.75rem;
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.2;
		color: #F4F5FA;
		letter-spacing: -0.01em;
	}

	.gb-sub {
		margin: 0;
		font-size: 0.9rem;
		color: #7F8799;
		line-height: 1.7;
		max-width: 520px;
	}

	/* 留言区 */
	.gb-comments {
		position: relative;
	}

	/* 空状态 */
	.gb-empty {
		text-align: center;
		padding: 4rem 1rem;
	}

	.gb-empty-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(155, 140, 255, 0.4);
		margin: 0 auto 1.5rem;
		box-shadow: 0 0 12px rgba(155, 140, 255, 0.2);
		animation: gb-empty-pulse 4s ease-in-out infinite;
	}

	@keyframes gb-empty-pulse {
		0%, 100% { opacity: 0.4; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.2); }
	}

	.gb-empty-title {
		font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.3);
		margin: 0 0 0.5rem;
	}

	.gb-empty-sub {
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.25);
		margin: 0;
	}

	@media (max-width: 768px) {
		.gb-container {
			padding: 0 1.25rem;
		}
		.gb-header {
			margin-bottom: 2rem;
		}
		.gb-title {
			font-size: 1.6rem;
		}
		.gb-sub {
			font-size: 0.85rem;
		}
	}

	/* Reduced Motion */
	@media (prefers-reduced-motion: reduce) {
		.gb-empty-dot {
			animation: none;
		}
	}
</style>
