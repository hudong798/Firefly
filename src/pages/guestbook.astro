---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/misc/Markdown.astro";
import { commentConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");

if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}

const { Content } = await render(guestbookPost);

// 检查评论系统是否启用
const isCommentEnabled = commentConfig?.type && commentConfig.type !== "none";

// 页面标题和描述
const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
---

<MainGridLayout title={title} description={description}>
	<!-- 头部 -->
	<header class="gb-header">
		<span class="gb-header-ic">💬</span>
		<div class="gb-header-text">
			<h1 class="gb-title">{title}</h1>
			<p class="gb-sub">{description}</p>
		</div>
	</header>

	<!-- 介绍卡片 -->
	<div class="guestbook-card card-base rounded-[var(--radius-large)]">
		<Markdown>
			<Content />
		</Markdown>
	</div>

	<!-- 留言区 -->
	<section class="gb-comments">
		<h2 class="gb-comments-h2">
			<span class="gb-comments-ic">📝</span> 留言区
		</h2>
		{
			isCommentEnabled ? (
				<Comment post={guestbookPost} customPath="/guestbook/" hideHeader />
			) : (
				<div class="card-base p-8 mb-6 relative overflow-hidden">
					<div class="text-center py-8 text-[var(--content-meta)]">
						<div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[var(--btn-regular-bg)] flex items-center justify-center">
							<svg
								class="w-8 h-8 text-[var(--primary)]"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
								></path>
							</svg>
						</div>
						<p class="text-base mb-2">{i18n(I18nKey.commentNotConfigured)}</p>
						<p class="text-sm text-[var(--content-meta)] opacity-75">
							{i18n(I18nKey.guestbookCommentHint)}
						</p>
					</div>
				</div>
			)
		}
	</section>
</MainGridLayout>

<style>
	/* 头部 */
	.gb-header {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 1.2rem;
	}
	.gb-header-ic {
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.6rem;
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
	}
	.gb-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 800;
		line-height: 1.2;
	}
	.gb-sub {
		margin: 0.2rem 0 0;
		font-size: 0.85rem;
		color: var(--content-meta);
	}

	/* 介绍卡片 */
	.guestbook-card {
		padding: 1.5rem 1.8rem;
	}

	/* 留言区 */
	.gb-comments {
		margin-top: 1.6rem;
	}
	.gb-comments-h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.9rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--line-divider);
	}
	.gb-comments-ic {
		font-size: 1.2rem;
	}

	@media (max-width: 768px) {
		.guestbook-card {
			padding: 1.1rem 1rem;
		}
	}
</style>
