---
import { Icon } from "astro-icon/components";
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import { profileConfig, siteConfig } from "@/config";

const title = "AI 对话";
---

<WorkbenchLayout
  title={title}
  description={`和 ${profileConfig.name} 的博客 AI 助手对话`}
>
  <!-- 系统消息 -->
  <div class="wb-sys-msg">🤖 已连接博客 AI 助手 · 基于 DeepSeek</div>

  <!-- 欢迎消息 -->
  <div class="wb-msg wb-msg--assistant">
    <img class="wb-avatar" src={profileConfig.avatar} alt="" />
    <div class="wb-msg-main">
      <div class="wb-msg-meta">
        <span class="wb-msg-author">{profileConfig.name} · AI</span>
        <span class="wb-msg-time">online</span>
      </div>
      <div class="wb-bubble">
        你好，我是这个博客的 AI 助手 🤖
        可以问我关于站点、文章的任何问题，也可以聊点别的。
      </div>
    </div>
  </div>

  <!-- 动态消息区 -->
  <div id="wb-chat-messages"></div>

  <!-- 等待回复的打字指示 -->
  <div class="wb-msg wb-msg--assistant" id="wb-chat-typing" hidden>
    <img class="wb-avatar" src={profileConfig.avatar} alt="" />
    <div class="wb-msg-main">
      <div class="wb-msg-meta">
        <span class="wb-msg-author">{profileConfig.name} · AI</span>
      </div>
      <div class="wb-bubble">
        <div class="wb-typing wb-typing--live">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- 输入区 -->
  <form id="wb-chat-form" class="wb-composer wb-composer--real">
    <Icon name="material-symbols:edit" class="wb-composer-ic" />
    <input
      id="wb-chat-input"
      class="wb-composer-input"
      type="text"
      placeholder="输入消息，和博客 AI 对话…"
      autocomplete="off"
      maxlength="2000"
    />
    <button type="submit" class="wb-composer-btn" aria-label="发送">
      <Icon name="material-symbols:send" />
    </button>
  </form>

  <!--
    聊天逻辑：is:inline 且放在模板内（swup 容器内），
    这样无论直接打开还是从会话栏 swup 跳转进来，脚本都会执行。
    幂等保护：form.dataset.wbChatInit 防止重复绑定。
  -->
  <script is:inline define:vars={{ avatar: profileConfig.avatar, siteName: siteConfig.title }}>
    (function () {
      function initChat() {
        var form = document.getElementById("wb-chat-form");
        if (!form || form.dataset.wbChatInit) return;
        form.dataset.wbChatInit = "1";

        var input = document.getElementById("wb-chat-input");
        var messagesEl = document.getElementById("wb-chat-messages");
        var typingEl = document.getElementById("wb-chat-typing");
        if (!input || !messagesEl || !typingEl) return;

        var history = [];
        var MAX_HISTORY = 20;

        function scrollToBottom() {
          window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
        }

        function addMessage(role, content) {
          var el = document.createElement("div");
          el.className = "wb-msg wb-msg--" + role;

          if (role === "assistant") {
            el.innerHTML =
              '<img class="wb-avatar" src="' + avatar + '" alt="" />' +
              '<div class="wb-msg-main">' +
              '<div class="wb-msg-meta">' +
              '<span class="wb-msg-author">' + siteName + ' · AI</span>' +
              '<span class="wb-msg-time">刚刚</span>' +
              "</div>" +
              '<div class="wb-bubble"></div>' +
              "</div>";
          } else {
            el.innerHTML =
              '<div class="wb-avatar wb-avatar--user">我</div>' +
              '<div class="wb-msg-main">' +
              '<div class="wb-msg-meta">' +
              '<span class="wb-msg-author">访客</span>' +
              '<span class="wb-msg-time">刚刚</span>' +
              "</div>" +
              '<div class="wb-bubble"></div>' +
              "</div>";
          }

          var bubble = el.querySelector(".wb-bubble");
          bubble.textContent = content;
          messagesEl.appendChild(el);
          scrollToBottom();
        }

        function setTyping(show) {
          typingEl.hidden = !show;
          if (show) scrollToBottom();
        }

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var text = input.value.trim();
          if (!text) return;

          input.value = "";
          history.push({ role: "user", content: text });
          addMessage("user", text);
          setTyping(true);

          fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ messages: history.slice(-MAX_HISTORY) }),
          })
            .then(function (res) {
              return res.json().then(function (data) {
                return { ok: res.ok, data: data };
              });
            })
            .then(function (r) {
              if (!r.ok) {
                addMessage("assistant", "⚠️ 出错了：" + (r.data.error || "HTTP " + r.status));
                history.pop();
                return;
              }
              var reply = r.data.reply || "（空回复）";
              history.push({ role: "assistant", content: reply });
              addMessage("assistant", reply);
            })
            .catch(function (err) {
              addMessage("assistant", "⚠️ 网络错误：" + err.message);
              history.pop();
            })
            .finally(function () {
              setTyping(false);
            });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initChat);
      } else {
        initChat();
      }
    })();
  </script>
</WorkbenchLayout>
