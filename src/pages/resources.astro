---
// 资源板块：液态玻璃横排导航（影视 / 漫画资源 / 社区 / 工具），点击切换下方内容
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import TvLinks from "@/components/workbench/TvLinks.astro";
import LinkRows from "@/components/workbench/LinkRows.astro";
import { comics, comicTypeClass } from "@/data/comics";
import { communities } from "@/data/communities";
import { toolGroups } from "@/data/tools";

const title = "资源";
const description = "影视、漫画、社区、工具等资源导航";
---

<MainGridLayout title={title} description={description}>
	<!-- 液态玻璃横排导航 -->
	<div class="res-tabs" role="tablist" aria-label="资源分类">
		<button class="res-tab is-active" data-tab="tv" role="tab" aria-selected="true">
			<span class="res-tab-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M7 4v16M17 4v16M2 9h5M2 15h5M17 9h5M17 15h5"/></svg>
			</span>
			影视
		</button>
		<button class="res-tab" data-tab="comic" role="tab" aria-selected="false">
			<span class="res-tab-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
			</span>
			漫画资源
		</button>
		<button class="res-tab" data-tab="community" role="tab" aria-selected="false">
			<span class="res-tab-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
			</span>
			社区
		</button>
		<button class="res-tab" data-tab="tool" role="tab" aria-selected="false">
			<span class="res-tab-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
			</span>
			工具
		</button>
	</div>

	<!-- 影视面板 -->
	<section class="res-panel is-active" data-panel="tv" role="tabpanel">
		<TvLinks />
	</section>

	<!-- 漫画资源面板 -->
	<section class="res-panel" data-panel="comic" role="tabpanel">
		<div class="comic-grid">
			{
				comics.map((c) => (
					<a class="comic-card" href={c.url} target="_blank" rel="noopener">
						<div class="comic-top">
							<span class="comic-name">{c.name}</span>
							<span class="comic-arrow">↗</span>
						</div>
						<span class={`comic-tag comic-tag--${comicTypeClass[c.type]}`}>
							{c.type}
						</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- 社区面板 -->
	<section class="res-panel" data-panel="community" role="tabpanel">
		<div class="community-grid">
			{
				communities.map((c) => (
					<a class="community-card" href={c.url} target="_blank" rel="noopener">
						<span class="community-icon">{c.icon}</span>
						<div class="community-info">
							<span class="community-name">{c.name}</span>
							<span class="community-desc">{c.desc}</span>
						</div>
						<span class="community-arrow">↗</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- 工具面板 -->
	<section class="res-panel" data-panel="tool" role="tabpanel">
		<p class="tool-hint">好用的工具让人事半功倍，点击直达官网。</p>
		{
			toolGroups.map((g) => (
				<section class="tool-group">
					<h2 class="tool-group-title">{g.title}</h2>
					<LinkRows items={g.items} />
				</section>
			))
		}
	</section>
</MainGridLayout>

<style>
	/* ---------- 液态玻璃横排导航 ---------- */
	.res-tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem;
		width: fit-content;
		max-width: 100%;
		margin: 0 auto 1.6rem;
		padding: 0.4rem;
		border-radius: 999px;
		background: var(--glass-surface-strong, var(--wb-rail));
		-webkit-backdrop-filter: blur(24px) saturate(170%);
		backdrop-filter: blur(24px) saturate(170%);
		border: 1px solid var(--glass-border, var(--wb-border));
		box-shadow: var(--glass-highlight, none), var(--wb-shadow-md);
	}
	.res-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid transparent;
		background: transparent;
		color: var(--content-meta);
		font-size: 0.9rem;
		padding: 0.5rem 1.15rem;
		border-radius: 999px;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.18s ease;
	}
	.res-tab-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.05em;
		height: 1.05em;
		flex-shrink: 0;
	}
	.res-tab-icon svg {
		width: 100%;
		height: 100%;
		display: block;
	}
	.res-tab:hover {
		background: var(--glass-surface-soft, var(--wb-hover));
		color: var(--deep-text);
	}
	.res-tab.is-active {
		background: color-mix(in oklch, var(--primary) 26%, transparent);
		border-color: color-mix(in oklch, var(--primary) 50%, transparent);
		color: var(--primary);
		font-weight: 600;
	}

	/* 移动端：4 个 tab 强制一行等宽，避免换行 */
	@media (max-width: 640px) {
		.res-tabs {
			flex-wrap: nowrap;
			width: 100%;
			padding: 0.3rem;
			gap: 0.2rem;
		}
		.res-tab {
			flex: 1;
			justify-content: center;
			padding: 0.45rem 0.3rem;
			font-size: 0.78rem;
			gap: 0.25rem;
		}
		.res-tab-icon {
			width: 1em;
			height: 1em;
		}
	}

	/* ---------- 面板切换 ---------- */
	.res-panel {
		display: none;
	}
	.res-panel.is-active {
		display: block;
		animation: res-fade 0.25s ease;
	}
	@keyframes res-fade {
		from {
			opacity: 0;
			transform: translateY(0.4rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ---------- 漫画卡片 ---------- */
	.comic-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 0.8rem;
	}
	.comic-card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 0.85rem 0.95rem;
		border-radius: var(--radius-large, 14px);
		background: var(--card-bg, rgba(255, 255, 255, 0.04));
		border: 1px solid var(--line-divider, rgba(255, 255, 255, 0.08));
		text-decoration: none;
		color: inherit;
		transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
	}
	.comic-card:hover {
		transform: translateY(-3px);
		border-color: var(--primary);
		background: var(--card-bg-hover, rgba(255, 255, 255, 0.08));
	}
	.comic-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.comic-name {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-90, #e6edf3);
	}
	.comic-arrow {
		color: var(--content-meta);
		font-size: 0.85rem;
		transition: color 0.18s ease;
	}
	.comic-card:hover .comic-arrow {
		color: var(--primary);
	}
	.comic-tag {
		align-self: flex-start;
		font-size: 0.72rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		color: #fff;
		font-weight: 500;
		line-height: 1.4;
	}
	.comic-tag--manga {
		background: #d85a30;
	}
	.comic-tag--strip {
		background: #7f77dd;
	}
	.comic-tag--overseas {
		background: #378add;
	}

	/* ---------- 社区卡片 ---------- */
	.community-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.9rem;
	}
	.community-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		border-radius: var(--radius-large, 14px);
		background: var(--card-bg, rgba(255, 255, 255, 0.04));
		border: 1px solid var(--line-divider, rgba(255, 255, 255, 0.08));
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			background 0.18s ease;
	}
	.community-card:hover {
		transform: translateY(-3px);
		border-color: var(--primary);
		background: var(--card-bg-hover, rgba(255, 255, 255, 0.08));
	}
	.community-icon {
		font-size: 1.6rem;
		line-height: 1;
		flex-shrink: 0;
	}
	.community-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		flex: 1;
	}
	.community-name {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-90, #e6edf3);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.community-desc {
		font-size: 0.78rem;
		color: var(--content-meta);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.community-arrow {
		color: var(--content-meta);
		font-size: 0.85rem;
		transition: color 0.18s ease;
		flex-shrink: 0;
	}
	.community-card:hover .community-arrow {
		color: var(--primary);
	}

	/* ---------- 工具分组 ---------- */
	.tool-hint {
		color: var(--content-meta);
		font-size: 0.88rem;
		margin: 0 0 1.1rem;
	}
	.tool-group {
		margin-bottom: 1.4rem;
	}
	.tool-group-title {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0 0 0.6rem;
	}

	@media (max-width: 640px) {
		.comic-grid {
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 0.6rem;
		}
	}
</style>

<script>
	// 资源页 tab 切换：事件委托，一次绑定永久有效（兼容 swup 无刷新切换）
	function handleResTabClick(e) {
		const tab = e.target.closest(".res-tab");
		if (!tab) return;
		const name = tab.dataset.tab;
		if (!name) return;
		const root = tab.closest(".res-tabs");
		if (!root) return;
		const tabs = root.querySelectorAll(".res-tab");
		const panels = document.querySelectorAll(".res-panel");
		tabs.forEach((t) => {
			const active = t === tab;
			t.classList.toggle("is-active", active);
			t.setAttribute("aria-selected", String(active));
		});
		panels.forEach((p) =>
			p.classList.toggle("is-active", p.dataset.panel === name),
		);
	}
	if (!window.__resTabsBound) {
		document.addEventListener("click", handleResTabClick);
		window.__resTabsBound = true;
	}
</script>
