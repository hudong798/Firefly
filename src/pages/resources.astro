---
// 档案 / ARCHIVE：个人数字星系 — Personal Archive Galaxy
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ArchiveGalaxy from "@/components/workbench/ArchiveGalaxy.astro";

const title = "档案";
const description = "收藏那些值得留下的东西。";
---

<MainGridLayout title={title} description={description}>
	<!-- Reading Quiet Zone -->
	<div class="arch-vignette" aria-hidden="true"></div>

	<div class="arch-container">
		<!-- 页面标题：左右布局 -->
		<header class="arch-header">
			<div class="arch-header-left">
				<div class="arch-header-label">
					<span class="arch-header-observing">
						<span class="arch-header-dot"></span>
						PERSONAL LIBRARY
					</span>
					<span class="arch-header-text">ARCHIVE GALAXY</span>
				</div>
				<h1 class="arch-title">档案</h1>
				<p class="arch-sub">收藏那些值得留下的东西。工具、影视、漫画、社区，以及值得反复打开的数字片段。</p>
			</div>
			<div class="arch-header-right">
				<div class="arch-obs-item">
					<span class="arch-obs-label">ARCHIVE</span>
					<span class="arch-obs-value">2026</span>
				</div>
				<div class="arch-obs-item">
					<span class="arch-obs-label">TOTAL</span>
					<span class="arch-obs-value" id="arch-total-objects">65</span>
				</div>
				<div class="arch-obs-item">
					<span class="arch-obs-label">CONSTELLATIONS</span>
					<span class="arch-obs-value">04</span>
				</div>
			</div>
		</header>

		<!-- 星系主体（含搜索+筛选+Canvas星图+详情面板） -->
		<ArchiveGalaxy />

		<!-- 底部状态栏 -->
		<footer class="arch-statusbar">
			<div class="arch-status-left">
				<span class="arch-status-dot"></span>
				<span class="arch-status-label">ARCHIVE SYSTEM</span>
				<span class="arch-status-sep">·</span>
				<span class="arch-status-value">4 CONSTELLATIONS</span>
			</div>
			<div class="arch-status-right">
				<span class="arch-status-online">SYSTEM ONLINE</span>
			</div>
		</footer>
	</div>
</MainGridLayout>

<style>
	/* Reading Quiet Zone */
	.arch-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 80% 65% at 50% 40%, rgba(3, 5, 10, 0.35) 0%, rgba(3, 5, 10, 0.15) 60%, transparent 85%);
	}

	.arch-container {
		position: relative;
		z-index: 2;
		max-width: 1500px;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	/* 标题：左右布局 */
	.arch-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		margin-bottom: 2rem;
		padding-top: 1.25rem;
	}

	.arch-header-left {
		flex: 1;
	}

	.arch-header-right {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding-top: 0.5rem;
		flex-shrink: 0;
	}

	.arch-obs-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
		align-items: flex-end;
	}

	.arch-obs-label {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.52rem;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
	}

	.arch-obs-value {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.5);
		letter-spacing: 0.05em;
	}

	.arch-header-label {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 1rem;
	}

	.arch-header-observing {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.6rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.32);
		text-transform: uppercase;
	}

	.arch-header-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(155, 140, 255, 0.55);
		box-shadow: 0 0 8px rgba(155, 140, 255, 0.35);
	}

	.arch-header-text {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		color: rgba(155, 140, 255, 0.5);
		text-transform: uppercase;
	}

	.arch-title {
		margin: 0 0 0.75rem;
		font-size: 2.5rem;
		font-weight: 600;
		line-height: 1.15;
		color: #F4F5FA;
		letter-spacing: -0.015em;
	}

	.arch-sub {
		margin: 0;
		font-size: 0.92rem;
		color: #7F8799;
		line-height: 1.75;
		max-width: 560px;
	}

	/* 搜索框 */
	.arch-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.75rem;
		padding: 0.75rem 1.1rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.015);
		border: 1px solid rgba(255, 255, 255, 0.07);
		transition: border-color 0.25s ease, background 0.25s ease;
	}

	.arch-search:focus-within {
		border-color: rgba(155, 140, 255, 0.35);
		background: rgba(255, 255, 255, 0.025);
		box-shadow: 0 0 20px rgba(155, 140, 255, 0.06);
	}

	.arch-search-icon {
		color: rgba(155, 140, 255, 0.5);
		font-size: 0.9rem;
		flex-shrink: 0;
	}

	.arch-search input {
		flex: 1;
		border: none;
		background: transparent;
		outline: none;
		color: #F4F5FA;
		font-size: 0.85rem;
		font-family: inherit;
	}

	.arch-search input::placeholder {
		color: rgba(255, 255, 255, 0.25);
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.05em;
	}

	.arch-search-hint {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.12em;
		color: rgba(99, 216, 255, 0.4);
		text-transform: uppercase;
		flex-shrink: 0;
	}

	/* 底部状态栏 */
	.arch-statusbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1.5rem;
		padding: 0.85rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.arch-status-left {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.arch-status-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: rgba(125, 232, 208, 0.6);
		box-shadow: 0 0 8px rgba(125, 232, 208, 0.3);
		animation: arch-status-pulse 3s ease-in-out infinite;
	}

	@keyframes arch-status-pulse {
		0%, 100% { opacity: 0.5; }
		50% { opacity: 1; }
	}

	.arch-status-label {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.35);
		text-transform: uppercase;
	}

	.arch-status-sep {
		color: rgba(255, 255, 255, 0.15);
		font-size: 0.6rem;
	}

	.arch-status-value {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.4);
		text-transform: uppercase;
	}

	.arch-status-online {
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		color: rgba(125, 232, 208, 0.5);
		text-transform: uppercase;
	}

	/* 响应式 */
	@media (max-width: 1024px) {
		.arch-container {
			padding: 0 2.5rem;
		}
	}

	@media (max-width: 768px) {
		.arch-container {
			padding: 0 1.25rem;
		}
		.arch-header {
			flex-direction: column;
			gap: 1rem;
		}
		.arch-header-right {
			flex-direction: row;
			gap: 1.5rem;
			padding-top: 0;
		}
		.arch-obs-item {
			align-items: flex-start;
		}
		.arch-title {
			font-size: 2rem;
		}
		.arch-sub {
			font-size: 0.85rem;
		}
		.arch-search-hint {
			display: none;
		}
		.arch-statusbar {
			flex-direction: column;
			gap: 0.4rem;
			align-items: flex-start;
		}
	}
</style>
