---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { profileConfig } from "@/config";

const title = "AI";
const description = "AI 工具与心得";

const post = await getEntry("spec", "ai");

if (!post) {
	throw new Error("ai page content not found");
}

const { Content } = await render(post);
---

<MainGridLayout title={title} description={description}>
	<!-- 页面内容 = 助手消息气泡 -->
	<div class="wb-msg wb-msg--assistant">
		<img class="wb-avatar" src={profileConfig.avatar} alt="" />
		<div class="wb-msg-main">
			<div class="wb-msg-meta">
				<span class="wb-msg-author">{title}</span>
				<span class="wb-msg-time">page</span>
			</div>
			<div class="wb-bubble wb-page-bubble">
				<div class="wb-article-body markdown-content">
					<Markdown class="mt-2">
						<Content />
					</Markdown>
				</div>
			</div>
		</div>
	</div>
</MainGridLayout>
