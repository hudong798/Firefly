---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ClientAiTools from "@/components/workbench/ClientAiTools.svelte";

const title = "AI";
const description = "AI 工具导航";
---

<MainGridLayout title={title} description={description}>
	<!-- 左侧边导航栏 -->
	<aside class="ai-sidebar">
		<a href="/ai/" class="sidebar-btn active" title="AI工具">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="sidebar-icon">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
			</svg>
			<span class="sidebar-label">AI</span>
		</a>
		<a href="/resources/" class="sidebar-btn" title="我的收藏">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="sidebar-icon">
				<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
			</svg>
			<span class="sidebar-label">收藏</span>
		</a>
		<a href="/admin/resources/" class="sidebar-btn" title="管理收藏" style="margin-top:auto;margin-bottom:30px;">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="sidebar-icon">
				<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
			</svg>
			<span class="sidebar-label">管理</span>
		</a>
	</aside>

	<div class="ai-content-wrap">
		<ClientAiTools client:load />
	</div>

<script>
	// 页面加载后清除自身 swup 缓存
	setTimeout(() => {
		try {
			const swup = window.swup;
			if (swup?.cache) swup.cache.delete(location.pathname);
		} catch (e) {}
	}, 200);
</script>
</MainGridLayout>

<style>
	.ai-sidebar {
		position: fixed;
		left: 0; top: 0; bottom: 0;
		width: 60px;
		background: rgba(8, 10, 20, 0.95);
		border-right: 1px solid rgba(155, 140, 255, 0.12);
		display: flex; flex-direction: column; align-items: center;
		padding-top: 100px; gap: 1rem;
		z-index: 100; backdrop-filter: blur(12px);
	}
	.sidebar-btn {
		display: flex; flex-direction: column; align-items: center; justify-content: center;
		gap: 0.35rem; width: 56px; height: 56px; border-radius: 12px;
		color: rgba(255,255,255,0.5); text-decoration: none;
		transition: all 0.25s ease; cursor: pointer;
	}
	.sidebar-btn:hover { background: rgba(155,140,255,0.12); color: rgba(155,140,255,0.9); transform: translateY(-1px); }
	.sidebar-btn.active { background: rgba(155,140,255,0.15); color: rgba(155,140,255,0.95); border: 1px solid rgba(155,140,255,0.2); }
	.sidebar-icon { width: 1.3rem; height: 1.3rem; }
	.sidebar-label { font-size: 0.65rem; font-weight: 500; letter-spacing: 0.05em; }
	.ai-content-wrap { padding-left: 72px; }
	@media (max-width: 768px) { .ai-content-wrap { padding-left: 52px; } }
</style>
