---
import LinkGrid from "@/components/workbench/LinkGrid.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { aiTools } from "@/data/ai";

const title = "AI";
const description = "AI 工具导航";

const tools = aiTools;
---

<MainGridLayout title={title} description={description}>
	<h2 class="section-h2">🤖 常用 AI 工具</h2>
	<p class="section-hint">点击直达官网，收藏你常用的 AI 助手吧。</p>
	<LinkGrid items={tools} perRow={6} />

	<p class="section-tip">💡 想推荐其他好用的 AI 工具？欢迎去<a href="/guestbook/">讨论区</a>留言！</p>
</MainGridLayout>

<style>
	.section-h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}
	.section-h2-gap {
		margin-top: 1.6rem;
	}
	.section-hint {
		color: var(--content-meta);
		font-size: 0.88rem;
		margin: 0 0 0.9rem;
	}
	.section-tip {
		margin-top: 1.2rem;
		font-size: 0.85rem;
		color: var(--content-meta);
	}
	.section-tip a {
		color: var(--primary);
		text-decoration: none;
	}
	.section-tip a:hover {
		text-decoration: underline;
	}
</style>
