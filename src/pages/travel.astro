---
// 轨迹 / JOURNEY：中国旅行星图 + 时间轴 + 精选旅记
import TravelCards from "@/components/workbench/TravelCards.astro";
import TravelMap from "@/components/workbench/TravelMap.astro";
import JourneyTimeline from "@/components/workbench/JourneyTimeline.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { travels } from "@/data/travels";

const title = "轨迹";
const description = "走过的地方，最终都会成为记忆的一部分。";

// 精选旅记（前3个）
const selectedJourneys = travels.slice(0, 3);
---

<MainGridLayout title={title} description={description}>
	<div class="traj-vignette" aria-hidden="true"></div>

	<div class="traj-container">
		<!-- 页面标题（简洁） -->
		<header class="traj-header">
			<div class="traj-header-label">
				<span class="traj-header-observing">
					<span class="traj-header-dot"></span>
					TRAVEL LOG
				</span>
				<span class="traj-header-text">JOURNEY</span>
				<span class="traj-header-line"></span>
			</div>
			<h1 class="traj-title">轨迹</h1>
		</header>

		<!-- 中国旅行星图 -->
		<section class="traj-map-section">
			<TravelMap />
		</section>

		<!-- 旅行时间轴 -->
		<section class="traj-timeline-section">
			<JourneyTimeline />
		</section>

		<!-- 精选旅记 -->
		<section class="traj-selected-section">
			<div class="traj-list-label">
				<span>SELECTED JOURNEYS</span>
				<span>精选旅记</span>
			</div>
			<TravelCards items={selectedJourneys} />
		</section>
	</div>
</MainGridLayout>

<style>
	/* Reading Quiet Zone */
	.traj-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 70% 60% at 50% 35%, rgba(3, 5, 10, 0.4) 0%, rgba(3, 5, 10, 0.15) 55%, transparent 85%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.12) 0%, transparent 10%, transparent 90%, rgba(3, 5, 10, 0.18) 100%);
	}

	.traj-container {
		position: relative;
		z-index: 2;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* 页面标题 */
	.traj-header {
		margin-bottom: 2rem;
		padding-top: 1rem;
	}

	.traj-header-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.traj-header-observing {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.3);
		text-transform: uppercase;
	}

	.traj-header-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(99, 216, 255, 0.5);
		box-shadow: 0 0 6px rgba(99, 216, 255, 0.3);
	}

	.traj-header-text {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		color: rgba(99, 216, 255, 0.45);
		text-transform: uppercase;
	}

	.traj-header-line {
		flex: 1;
		max-width: 200px;
		height: 1px;
		background: linear-gradient(90deg, rgba(99, 216, 255, 0.1), transparent);
	}

	.traj-title {
		margin: 0;
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.2;
		color: #F4F5FA;
		letter-spacing: -0.01em;
	}

	/* 地图区域 */
	.traj-map-section {
		margin-bottom: 3rem;
	}

	/* 时间轴区域 */
	.traj-timeline-section {
		margin-bottom: 3.5rem;
		padding: 1.5rem 0;
		border-top: 1px solid rgba(255,255,255,0.04);
		border-bottom: 1px solid rgba(255,255,255,0.04);
	}

	/* 精选旅记 */
	.traj-selected-section {
		margin-bottom: 3rem;
	}

	/* 旅行列表 */
	.traj-list {
		position: relative;
	}

	.traj-list-label {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
		font-family: "JetBrains Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.12em;
		color: rgba(255,255,255,0.3);
		text-transform: uppercase;
	}

	@media (max-width: 768px) {
		.traj-container {
			padding: 0 1.25rem;
		}
		.traj-header {
			margin-bottom: 1.5rem;
		}
		.traj-title {
			font-size: 1.75rem;
		}
	}
</style>
