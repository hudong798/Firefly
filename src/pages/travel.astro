---
// 轨迹 / TRAJECTORIES：一个人曾经经过的地方，最终成为留在数字宇宙里的空间轨迹
import TravelCards from "@/components/workbench/TravelCards.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { travels } from "@/data/travels";

const title = "轨迹";
const description = "每一张封面，都是一段出发与抵达。";

// Journey Statistics
const journeyCount = travels.length;
// 统计国家数
const countries = new Set(
	travels.map((t) => t.location.split("·")[0].trim()).filter(Boolean),
);
const countryCount = countries.size;
---

<MainGridLayout title={title} description={description}>
	<!-- Reading Quiet Zone：轨迹页面局部暗层 -->
	<div class="traj-vignette" aria-hidden="true"></div>

	<!-- 统一内容容器 -->
	<div class="traj-container">
		<!-- 页面标题 -->
		<header class="traj-header">
			<div class="traj-header-label">
				<span class="traj-header-observing">
					<span class="traj-header-dot"></span>
					TRAVEL LOG
				</span>
				<span class="traj-header-text">TRAJECTORIES</span>
				<span class="traj-header-line"></span>
			</div>
			<h1 class="traj-title">轨迹</h1>
			<p class="traj-sub">每一张封面，都是一段出发与抵达。</p>

			<!-- Journey Statistics -->
			<div class="traj-stats">
				<div class="traj-stat">
					<span class="traj-stat-num">{String(journeyCount).padStart(2, "0")}</span>
					<span class="traj-stat-label">JOURNEYS</span>
				</div>
				<div class="traj-stat-divider"></div>
				<div class="traj-stat">
					<span class="traj-stat-num">{String(countryCount).padStart(2, "0")}</span>
					<span class="traj-stat-label">COUNTRIES</span>
				</div>
				<div class="traj-stat-divider"></div>
				<div class="traj-stat">
					<span class="traj-stat-num">2022</span>
					<span class="traj-stat-label">— 2024</span>
				</div>
			</div>
		</header>

		<!-- 旅行卡片列表 -->
		<section class="traj-list">
			<TravelCards items={travels} />
		</section>
	</div>
</MainGridLayout>

<style>
	/* Reading Quiet Zone */
	.traj-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 70% 60% at 50% 35%, rgba(3, 5, 10, 0.4) 0%, rgba(3, 5, 10, 0.15) 55%, transparent 85%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.12) 0%, transparent 10%, transparent 90%, rgba(3, 5, 10, 0.18) 100%);
	}

	.traj-container {
		position: relative;
		z-index: 2;
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* 页面标题 */
	.traj-header {
		margin-bottom: 3rem;
		padding-top: 1rem;
	}

	.traj-header-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.traj-header-observing {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.3);
		text-transform: uppercase;
	}

	.traj-header-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(99, 216, 255, 0.5);
		box-shadow: 0 0 6px rgba(99, 216, 255, 0.3);
	}

	.traj-header-text {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		color: rgba(99, 216, 255, 0.45);
		text-transform: uppercase;
	}

	.traj-header-line {
		flex: 1;
		max-width: 120px;
		height: 1px;
		background: linear-gradient(90deg, rgba(99, 216, 255, 0.1), transparent);
	}

	.traj-title {
		margin: 0 0 0.75rem;
		font-size: 2.25rem;
		font-weight: 600;
		line-height: 1.2;
		color: #F4F5FA;
		letter-spacing: -0.01em;
	}

	.traj-sub {
		margin: 0 0 1.75rem;
		font-size: 0.9rem;
		color: #7F8799;
		line-height: 1.7;
		max-width: 480px;
	}

	/* Journey Statistics */
	.traj-stats {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.traj-stat {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.traj-stat-num {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 1rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.6);
		letter-spacing: 0.02em;
	}

	.traj-stat-label {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
	}

	.traj-stat-divider {
		width: 1px;
		height: 16px;
		background: rgba(255, 255, 255, 0.06);
	}

	/* 旅行列表 */
	.traj-list {
		position: relative;
	}

	@media (max-width: 768px) {
		.traj-container {
			padding: 0 1.25rem;
		}
		.traj-header {
			margin-bottom: 2rem;
		}
		.traj-title {
			font-size: 1.75rem;
		}
		.traj-sub {
			font-size: 0.85rem;
		}
		.traj-stats {
			gap: 1rem;
			flex-wrap: wrap;
		}
		.traj-stat-num {
			font-size: 0.9rem;
		}
	}
</style>
