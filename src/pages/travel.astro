---
import TravelCards from "@/components/workbench/TravelCards.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { travels } from "@/data/travels";

const title = "旅游";
const description = "旅行足迹";
---

<MainGridLayout title={title} description={description}>
	<h2 class="section-h2">✈️ 旅行足迹</h2>
	<p class="section-hint">每一张封面，都是一段出发与抵达。</p>
	<TravelCards items={travels} />
</MainGridLayout>

<style>
	.section-h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}
	.section-hint {
		color: var(--content-meta);
		font-size: 0.88rem;
		margin: 0 0 0.9rem;
	}
</style>
