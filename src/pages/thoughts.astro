---
// 回声 / ECHOES：思想从这个数字宇宙中发出，经过时间之后留下的回声
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ClientEchoes from "@/components/workbench/ClientEchoes.svelte";

const title = "公告";
const description = "一些想法经过时间，最终留下的痕迹。";
---

<MainGridLayout title={title} description={description}>
	<!-- Reading Quiet Zone：回声页面局部暗层，降低星星密度 -->
	<div class="echo-reading-vignette" aria-hidden="true"></div>

	<!-- 统一内容容器 -->
	<div class="echo-container">
		<!-- 页面标题 -->
		<header class="echo-header">
			<div class="echo-header-label">
				<span class="echo-header-observing">
					<span class="echo-header-dot"></span>
					OBSERVING
				</span>
				<span class="echo-header-text">ECHOES</span>
				<span class="echo-header-line"></span>
			</div>
			<div class="echo-title-row">
				<h1 class="echo-title">公告</h1>
				<a href="/admin/echoes/" class="echo-admin-btn" target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="echo-admin-icon">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
					</svg>
					写公告
				</a>
			</div>
			<p class="echo-sub">一些想法经过时间，最终留下的痕迹。</p>
		</header>

		<!-- 回声列表（客户端动态加载 Supabase 数据） -->
		<section class="echo-list">
			<ClientEchoes client:only="svelte" />
		</section>
	</div>
</MainGridLayout>

<style>
	/* Reading Quiet Zone：回声页面局部暗层 */
	.echo-reading-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 65% 55% at 45% 40%, rgba(3, 5, 10, 0.5) 0%, rgba(3, 5, 10, 0.25) 50%, transparent 80%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.15) 0%, transparent 12%, transparent 88%, rgba(3, 5, 10, 0.2) 100%);
	}

	/* 统一内容容器 */
	.echo-container {
		position: relative;
		z-index: 2;
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* 页面标题 */
	.echo-header {
		margin-bottom: 3rem;
		padding-top: 1rem;
	}

	.echo-header-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.echo-header-observing {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.55rem;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.3);
		text-transform: uppercase;
	}

	.echo-header-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(155, 140, 255, 0.5);
		box-shadow: 0 0 6px rgba(155, 140, 255, 0.3);
	}

	.echo-header-text {
		font-family: "JetBrains Mono", "Fira Code", "Space Mono", ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		color: rgba(155, 140, 255, 0.5);
		text-transform: uppercase;
	}

	.echo-header-line {
		flex: 1;
		max-width: 100px;
		height: 1px;
		background: linear-gradient(90deg, rgba(155, 140, 255, 0.12), transparent);
	}

	.echo-title {
		margin: 0 0 0.75rem;
		font-size: 2.25rem;
		font-weight: 600;
		line-height: 1.2;
		color: #F4F5FA;
		letter-spacing: -0.01em;
	}

	.echo-title-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.echo-admin-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.85rem;
		background: rgba(155, 140, 255, 0.1);
		border: 1px solid rgba(155, 140, 255, 0.25);
		border-radius: 999px;
		color: rgba(155, 140, 255, 0.9);
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.2s;
		letter-spacing: 0.02em;
	}

	.echo-admin-btn:hover {
		background: rgba(155, 140, 255, 0.2);
		border-color: rgba(155, 140, 255, 0.5);
		color: #fff;
	}

	.echo-admin-icon {
		width: 0.85rem;
		height: 0.85rem;
	}

	.echo-sub {
		margin: 0;
		font-size: 0.9rem;
		color: #7F8799;
		line-height: 1.7;
		max-width: 480px;
	}

	/* 回声列表 */
	.echo-list {
		position: relative;
	}

	/* 公告卡片全局样式（避免Svelte客户端样式偶尔丢失） */
	:global(.echoes) {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	:global(.echo) {
		position: relative;
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 2rem;
		padding: 1.5rem;
		background: rgba(155, 140, 255, 0.06);
		border: 1px solid rgba(155, 140, 255, 0.12);
		border-radius: 0.75rem;
		backdrop-filter: blur(8px);
		animation: echo-fade-in 0.6s ease-out both;
		transition: all 0.25s ease;
	}

	:global(.echo:hover) {
		background: rgba(155, 140, 255, 0.09);
		border-color: rgba(155, 140, 255, 0.2);
		transform: translateY(-2px);
	}

	:global(.echo-expanded) {
		background: rgba(155, 140, 255, 0.1);
		border-color: rgba(155, 140, 255, 0.25);
	}

	:global(.echo-meta) {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-top: 0.25rem;
	}

	:global(.echo-number) {
		font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
		font-size: 0.6rem;
		letter-spacing: 0.15em;
		color: rgba(155, 140, 255, 0.5);
		text-transform: uppercase;
	}

	:global(.echo-date) {
		font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.45);
		letter-spacing: 0.02em;
	}

	:global(.echo-time) {
		font-family: "JetBrains Mono", "Fira Code", ui-monospace, monospace;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.3);
	}

	:global(.echo-night-badge) {
		display: inline-block;
		width: fit-content;
		font-size: 0.6rem;
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		background: rgba(99, 102, 241, 0.1);
		color: rgba(155, 140, 255, 0.7);
		letter-spacing: 0.1em;
		margin-top: 0.25rem;
	}

	:global(.echo-body) {
		min-width: 0;
	}

	:global(.echo-mood) {
		font-size: 1.3rem;
		margin-bottom: 0.75rem;
		line-height: 1;
	}

	:global(.echo-title) {
		font-size: 1.1rem;
		font-weight: 600;
		color: #F4F5FA;
		margin: 0 0 0.75rem 0;
		line-height: 1.4;
	}

	:global(.echo-content) {
		font-size: 0.95rem;
		line-height: 1.9;
		color: rgba(255, 255, 255, 0.75);
		white-space: pre-wrap;
		word-break: break-word;
	}

	:global(.echo-expand-btn) {
		margin-top: 0.75rem;
		padding: 0.3rem 0.75rem;
		background: rgba(155, 140, 255, 0.08);
		border: 1px solid rgba(155, 140, 255, 0.15);
		border-radius: 6px;
		color: rgba(155, 140, 255, 0.8);
		font-size: 0.75rem;
		cursor: pointer;
		transition: all 0.2s;
		font-family: inherit;
	}

	:global(.echo-expand-btn:hover) {
		background: rgba(155, 140, 255, 0.15);
		color: rgba(155, 140, 255, 1);
	}

	:global(.echo-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	:global(.echo-tag) {
		font-size: 0.7rem;
		color: rgba(155, 140, 255, 0.6);
		background: rgba(155, 140, 255, 0.05);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		letter-spacing: 0.02em;
	}

	:global(.echo-divider) {
		display: none;
	}

	@keyframes echo-fade-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		:global(.echo) {
			grid-template-columns: 1fr;
			gap: 1rem;
			padding: 1.25rem;
		}

		:global(.echo-meta) {
			flex-direction: row;
			align-items: center;
			gap: 0.75rem;
			flex-wrap: wrap;
		}

		:global(.echo-night-badge) {
			margin-top: 0;
		}

		:global(.echo-content) {
			font-size: 0.9rem;
		}
	}

	@media (max-width: 768px) {
		.echo-container {
			padding: 0 1.25rem;
		}
		.echo-header {
			margin-bottom: 2rem;
		}
		.echo-title {
			font-size: 1.75rem;
		}
		.echo-sub {
			font-size: 0.85rem;
		}
	}
</style>
