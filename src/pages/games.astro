---
import GomokuGame from "@/components/games/GomokuGame.svelte";
import TicTacToe from "@/components/games/TicTacToe.svelte";
import LinkRows from "@/components/workbench/LinkRows.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { onlineGames } from "@/data/games";

const title = "游戏";
const description = "在线小游戏";

const onlineGameList = onlineGames;
---

<MainGridLayout title={title} description={description}>
	<h2 class="section-h2">🕹️ 站内小游戏</h2>
	<p class="section-hint">无需安装，点击棋盘直接开玩，人机对战。</p>
	<div class="games-grid">
		<div class="game-panel card-base">
			<h3>⚫ 五子棋</h3>
			<GomokuGame client:load />
		</div>
		<div class="game-panel card-base">
			<h3>⭕ 井字棋</h3>
			<TicTacToe client:load />
		</div>
	</div>

	<h2 class="section-h2 section-h2-gap">🔗 更多在线游戏</h2>
	<p class="section-hint">点击跳转到在线可玩的游戏，无需注册。</p>
	<LinkRows items={onlineGameList} />
</MainGridLayout>

<style>
	.section-h2 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 0.25rem;
	}
	.section-h2-gap {
		margin-top: 1.6rem;
	}
	.section-hint {
		color: var(--content-meta);
		font-size: 0.88rem;
		margin: 0 0 0.9rem;
	}
	.games-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
	}
	.game-panel {
		padding: 0.9rem;
		border-radius: var(--radius-large);
	}
	.game-panel h3 {
		margin: 0 0 0.7rem;
		font-size: 0.95rem;
		text-align: center;
	}
</style>
