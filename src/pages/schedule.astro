---
// 日程 / SCHEDULE：时间的安排，未来的轨迹
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ClientSchedules from "@/components/workbench/ClientSchedules.svelte";

const title = "日程";
const description = "时间的安排，未来的轨迹。";
---

<MainGridLayout title={title} description={description}>
	<!-- Reading Quiet Zone：日程页面局部暗层 -->
	<div class="schedule-reading-vignette" aria-hidden="true"></div>

	<!-- 统一内容容器 -->
	<div class="schedule-container">
		<!-- 页面标题 -->
		<header class="schedule-header">
			<div class="schedule-header-label">
				<span class="schedule-header-observing">
					<span class="schedule-header-dot"></span>
					OBSERVING
				</span>
				<span class="schedule-header-text">SCHEDULE</span>
				<span class="schedule-header-line"></span>
			</div>
			<div class="schedule-header-main">
				<div class="schedule-header-left">
					<h1 class="schedule-title">日程</h1>
					<p class="schedule-sub">时间的安排，未来的轨迹。</p>
				</div>
				<div class="schedule-header-right">
					<button class="schedule-admin-btn" id="schedule-add-btn" type="button">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="schedule-admin-icon">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
						</svg>
						写日程
					</button>
				</div>
			</div>
		</header>

		<!-- 日程列表（客户端动态加载 Supabase 数据） -->
		<section class="schedule-list">
			<ClientSchedules client:only="svelte" />
		</section>
	</div>
</MainGridLayout>

<script>
	// 点击"写日程"按钮，派发自定义事件让 ClientSchedules 组件打开表单
	function bindScheduleAddBtn() {
		const btn = document.getElementById("schedule-add-btn");
		if (!btn) {
			// DOM 还没准备好，等一下再试
			setTimeout(bindScheduleAddBtn, 100);
			return;
		}
		btn.addEventListener("click", () => {
			// 按钮点击反馈
			btn.style.transform = "scale(0.95)";
			setTimeout(() => { btn.style.transform = ""; }, 150);
			// 派发自定义事件
			window.dispatchEvent(new CustomEvent("open-schedule-form"));
		});
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", bindScheduleAddBtn);
	} else {
		bindScheduleAddBtn();
	}
</script>

<style>
	/* 日程页面需要更宽的容器来承载 2/3 屏幕宽度的卡片，覆盖全局 .wb-chat 限制 */
	:global(.wb-chat) {
		max-width: 100%;
	}

	/* Reading Quiet Zone：日程页面局部暗层 */
	.schedule-reading-vignette {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse 65% 55% at 45% 40%, rgba(3, 5, 10, 0.5) 0%, rgba(3, 5, 10, 0.25) 50%, transparent 80%),
			linear-gradient(180deg, rgba(3, 5, 10, 0.15) 0%, transparent 12%, transparent 88%, rgba(3, 5, 10, 0.2) 100%);
	}

	/* 统一内容容器：与时间线卡片共用同一轴线 */
	.schedule-container {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 880px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
	}

	/* 页面标题 */
	.schedule-header {
		margin-bottom: 2.5rem;
	}

	.schedule-header-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.schedule-header-observing {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		color: rgba(155, 140, 255, 0.8);
		text-transform: uppercase;
	}

	.schedule-header-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #9b8cff;
		box-shadow: 0 0 8px rgba(155, 140, 255, 0.6);
		animation: schedule-pulse 2s ease-in-out infinite;
	}

	@keyframes schedule-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	.schedule-header-text {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		color: rgba(141, 150, 170, 0.6);
	}

	.schedule-header-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, rgba(155, 140, 255, 0.3), transparent);
	}

	/* 桌面端 Header：左标题右按钮 */
	.schedule-header-main {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.schedule-header-left {
		flex: 1;
	}

	.schedule-header-right {
		flex-shrink: 0;
		padding-bottom: 0.25rem;
	}

	.schedule-title {
		font-size: 2rem;
		font-weight: 700;
		color: #F5F7FF;
		letter-spacing: 0.02em;
		margin: 0 0 0.5rem 0;
	}

	.schedule-sub {
		font-size: 0.9rem;
		color: rgba(141, 150, 170, 0.7);
		margin: 0;
	}

	/* 写日程按钮 */
	.schedule-admin-btn {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 1rem;
		background: linear-gradient(135deg, rgba(155, 140, 255, 0.2), rgba(99, 216, 255, 0.12));
		border: 1px solid rgba(155, 140, 255, 0.35);
		border-radius: 0.6rem;
		color: #F5F7FF;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
		font-family: inherit;
		text-decoration: none;
	}
	.schedule-admin-btn:hover {
		background: linear-gradient(135deg, rgba(155, 140, 255, 0.3), rgba(99, 216, 255, 0.2));
		box-shadow: 0 0 16px rgba(155, 140, 255, 0.25);
	}
	.schedule-admin-icon {
		width: 14px;
		height: 14px;
	}

	/* 日程列表 */
	.schedule-list {
		margin-top: 1rem;
	}

	/* 空状态 */
	.schedule-empty {
		text-align: center;
		padding: 4rem 2rem;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.schedule-empty-icon {
		width: 48px;
		height: 48px;
		margin: 0 auto 1rem;
		color: rgba(155, 140, 255, 0.5);
	}

	.schedule-empty-icon svg {
		width: 100%;
		height: 100%;
	}

	.schedule-empty-title {
		font-size: 1.1rem;
		font-weight: 600;
		color: rgba(245, 247, 255, 0.8);
		margin: 0 0 0.5rem;
	}

	.schedule-empty-sub {
		font-size: 0.85rem;
		color: rgba(141, 150, 170, 0.6);
		margin: 0;
	}
</style>

<!-- 防闪烁样式必须全局生效：Svelte client:only 组件元素没有 data-astro-cid 属性，scoped CSS 无法匹配 -->
<style is:global>
	/* ===== 日程组件防闪烁：关键样式页面加载即生效，避免Svelte CSS注入延迟 ===== */
	/* 时间线：左日期栏 + 竖向轨道 + 右卡片列，与页面容器共用同一轴线 */
	.sch-timeline { display: flex; flex-direction: column; gap: 2.25rem; }
	.sch-timeline-group { display: grid; grid-template-columns: 76px 1fr; gap: 1.5rem; align-items: start; }
	.sch-timeline-date { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; position: sticky; top: 6rem; padding-top: 0.35rem; }
	.sch-timeline-month { font-size: 0.75rem; color: rgba(155,140,255,0.75); letter-spacing: 0.12em; font-weight: 500; }
	.sch-timeline-day { font-size: 2rem; font-weight: 700; color: #F5F7FF; line-height: 1.1; text-shadow: 0 0 20px rgba(155,140,255,0.3); }
	.sch-timeline-weekday { font-size: 0.75rem; color: rgba(141,150,170,0.6); letter-spacing: 0.05em; }
	.sch-timeline-items { display: flex; flex-direction: column; gap: 1rem; min-width: 0; border-left: 1px solid rgba(155,140,255,0.14); padding-left: 1.5rem; }
	.sch-card { display: block; width: 100%; box-sizing: border-box; padding: 1.4rem 1.6rem; background: rgba(155,140,255,0.04); border: 1px solid rgba(155,140,255,0.12); border-radius: 0.75rem; backdrop-filter: blur(8px); }
	.sch-card-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.7rem; }
	.sch-title { font-size: 1.15rem; font-weight: 600; color: #F4F5FA; margin: 0; flex: 1; }
	.sch-status { font-size: 0.72rem; padding: 0.25rem 0.65rem; border-radius: 4px; border: 1px solid; white-space: nowrap; letter-spacing: 0.05em; flex-shrink: 0; }
	.sch-meta { display: flex; flex-wrap: wrap; gap: 1rem; }
	.sch-meta-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: rgba(255,255,255,0.5); }
	.sch-meta-item svg { width: 14px; height: 14px; flex-shrink: 0; }
	.sch-description { font-size: 0.92rem; line-height: 1.75; color: rgba(255,255,255,0.65); margin: 0.7rem 0 0; white-space: pre-wrap; word-break: break-word; }
	.sch-actions { display: flex; gap: 0.6rem; margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid rgba(255,255,255,0.06); }
	.sch-action-btn { padding: 0.4rem 0.9rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 0.4rem; color: rgba(255,255,255,0.6); font-size: 0.78rem; cursor: pointer; font-family: inherit; }
	.sch-empty { text-align: center; padding: 4rem 2rem; border: 1px solid rgba(255,255,255,0.06); border-radius: 1rem; background: rgba(255,255,255,0.02); }
	.sch-empty-icon { width: 48px; height: 48px; margin: 0 auto 1rem; color: rgba(155,140,255,0.5); }
	.sch-empty-icon svg { width: 100%; height: 100%; }
	.sch-loading { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 4rem 2rem; color: rgba(255,255,255,0.4); }
	.sch-spinner { width: 24px; height: 24px; border: 2px solid rgba(155,140,255,0.2); border-top-color: rgba(155,140,255,0.8); border-radius: 50%; animation: sch-spin 0.8s linear infinite; }
	@keyframes sch-spin { to { transform: rotate(360deg); } }

	/* 日程组件移动端覆盖：日期回到卡片上方横排，去掉轨道线 */
	@media (max-width: 768px) {
		.sch-timeline { gap: 1.75rem; }
		.sch-timeline-group { display: flex; flex-direction: column; gap: 0.7rem; }
		.sch-timeline-date { flex-direction: row; align-items: baseline; gap: 0.5rem; position: static; padding-top: 0; }
		.sch-timeline-month { font-size: 0.8rem; }
		.sch-timeline-day { font-size: 1.4rem; }
		.sch-timeline-weekday { font-size: 0.75rem; }
		.sch-timeline-items { border-left: none; padding-left: 0; gap: 0.75rem; }
		.sch-card { padding: 1.1rem 1.2rem; }
		.sch-title { font-size: 1.05rem; }
		.sch-status { font-size: 0.65rem; padding: 0.2rem 0.5rem; }
		.sch-meta { gap: 0.75rem; }
		.sch-meta-item { font-size: 0.75rem; }
		.sch-meta-item svg { width: 12px; height: 12px; }
		.sch-description { font-size: 0.85rem; line-height: 1.6; }
		.sch-actions { gap: 0.5rem; margin-top: 0.85rem; padding-top: 0.7rem; flex-wrap: wrap; }
		.sch-action-btn { padding: 0.35rem 0.75rem; font-size: 0.75rem; }
	}
</style>
