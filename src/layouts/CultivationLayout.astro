---
/**
 * 修仙系统布局
 * 包含导航栏和内容区域
 * 统一设计系统：CSS variables + 可复用组件类
 */

interface Props {
	title: string;
	description?: string;
}

const { title, description = "修仙系统" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} - FreeX 修仙界</title>
		<meta name="description" content={description} />
		{/* 关键 CSS 内联：防止外部 CSS 加载延迟时页面无样式闪烁（FOUC） */}
		<style is:inline>
			*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
			.cult-body{
				--cult-bg:#050811;--cult-bg-soft:#0a0f1e;
				--cult-surface:rgba(15,20,40,.75);--cult-surface-hover:rgba(20,27,50,.85);
				--cult-border:rgba(130,110,255,.12);--cult-border-strong:rgba(130,110,255,.25);
				--cult-primary:#8b5cf6;--cult-primary-soft:rgba(139,92,246,.15);
				--cult-primary-hover:rgba(139,92,246,.25);--cult-primary-text:#a78bfa;
				--cult-gold:#fbbf24;--cult-gold-soft:rgba(251,191,36,.12);--cult-gold-text:#fcd34d;
				--cult-text:#f1f5f9;--cult-text-secondary:#94a3b8;--cult-text-muted:#64748b;
				--cult-success:#34d399;--cult-success-soft:rgba(52,211,153,.12);
				--cult-warning:#fbbf24;--cult-warning-soft:rgba(251,191,36,.12);
				--cult-danger:#f87171;--cult-danger-soft:rgba(248,113,113,.12);
				--cult-info:#60a5fa;--cult-info-soft:rgba(96,165,250,.12);
				--cult-space-1:4px;--cult-space-2:8px;--cult-space-3:12px;--cult-space-4:16px;
				--cult-space-5:20px;--cult-space-6:24px;--cult-space-8:32px;
				--cult-radius-sm:8px;--cult-radius-md:12px;--cult-radius-lg:16px;--cult-radius-xl:20px;
				min-height:100vh;background:var(--cult-bg);color:var(--cult-text);
				font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
				-webkit-font-smoothing:antialiased;
			}
			@media(max-width:767px){
				.cult-body{
					background-image:url("/assets/images/cult-bg-mobile.webp");
					background-size:cover;background-position:center;background-repeat:no-repeat;background-attachment:fixed;
				}
			}
			@media(min-width:768px){
				.cult-body{
					background-image:linear-gradient(180deg,rgba(5,8,17,.45) 0%,rgba(5,8,17,.38) 45%,rgba(5,8,17,.58) 100%),url("/assets/images/cult-bg-desktop.webp");
					background-size:cover,cover;background-position:center,center;background-repeat:no-repeat,no-repeat;background-attachment:fixed,fixed;
				}
			}
			.cult-body a{color:inherit;text-decoration:none}
			.cult-body button{font-family:inherit;cursor:pointer;border:none;background:none}
			/* 导航栏关键布局 */
			.cult-nav{position:sticky;top:0;z-index:500;background:rgba(5,8,17,.9);
				backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
				border-bottom:1px solid var(--cult-border)}
			.cult-nav-inner{max-width:1100px;margin:0 auto;padding:0 20px;height:64px;
				display:flex!important;align-items:center;gap:16px}
			.cult-nav-links{display:flex;align-items:center;gap:4px}
			.cult-nav-user{margin-left:auto;display:flex;align-items:center;gap:10px}
			.cult-nav-back,.cult-nav-brand{display:flex;align-items:center;flex-shrink:0}
			.cult-nav-link{display:flex;align-items:center;gap:6px;padding:8px 14px;border-radius:10px;
				color:var(--cult-text-secondary);font-size:14px;font-weight:500;white-space:nowrap}
			/* 页面容器 */
			.cult-page{max-width:720px;margin:0 auto;padding:20px 16px 32px}
			@media(min-width:768px){.cult-page{max-width:800px;padding:24px 20px 32px}}
			@media(min-width:1024px){.cult-page{max-width:900px}}
			/* 卡片基本样式 */
			.cult-card,.cult-ranking-card,.cult-stat-card,.cult-realm-card{
				background:var(--cult-surface);border:1px solid var(--cult-border);
				border-radius:var(--cult-radius-lg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
			/* 网格布局 */
			.cult-stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:24px}
			.cult-stat-card{padding:16px;display:flex;flex-direction:column;gap:8px}
			.cult-dashboard-grid{display:grid;grid-template-columns:1fr;gap:20px}
			.cult-section{margin-bottom:24px}
			.cult-section-title{font-size:16px;font-weight:600;margin-bottom:12px;color:var(--cult-text)}
			.cult-dashboard-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:20px;flex-wrap:wrap}
			.cult-dashboard-title{font-size:24px;font-weight:700}
			.cult-dashboard-desc{font-size:14px;color:var(--cult-text-secondary);margin-top:4px}
			/* 排名列表 */
			.cult-ranking-tabs{display:flex;gap:4px;margin-bottom:16px}
			.cult-ranking-tab{padding:8px 16px;border-radius:10px;font-size:14px;color:var(--cult-text-secondary);background:var(--cult-primary-soft)}
			.cult-ranking-tab.active{background:var(--cult-primary);color:#fff}
			.cult-ranking-header{display:flex;align-items:center;padding:8px 12px;font-size:12px;color:var(--cult-text-muted)}
			.cult-ranking-list{display:flex;flex-direction:column}
			.cult-ranking-row{display:flex;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid var(--cult-border)}
			.cult-ranking-col-rank{width:40px;flex-shrink:0}
			.cult-ranking-col-name{flex:1}
			.cult-ranking-col-value{text-align:right}
			.cult-ranking-pagination{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:12px}
			.cult-page-btn{padding:6px 14px;border-radius:8px;background:var(--cult-primary-soft);color:var(--cult-primary-text);font-size:13px}
			.cult-page-btn:disabled{opacity:.4}
			.cult-page-info{font-size:13px;color:var(--cult-text-muted)}
			/* 登录/注册页关键布局 */
			.cult-login-page,.cult-register-page{min-height:100vh;display:flex;
				align-items:center;justify-content:center;padding:2rem 1rem}
			.cult-login-card,.cult-register-card{width:100%;max-width:420px;padding:2.5rem 2rem;
				background:rgba(15,23,42,.9);border:1px solid rgba(99,102,241,.25);border-radius:16px;
				backdrop-filter:blur(10px);box-shadow:0 8px 32px rgba(0,0,0,.5)}
			.cult-login-header,.cult-register-header{text-align:center;margin-bottom:2rem}
			.cult-login-header h1,.cult-register-header h1{font-size:1.5rem!important;font-weight:600;
				margin:0 0 .5rem;color:#f1f5f9}
			.cult-login-header p,.cult-register-header p{font-size:.9rem!important;color:#94a3b8;margin:0}
			.cult-form-group{margin-bottom:1.25rem}
			.cult-form-group label{display:block;font-size:.85rem;color:#cbd5e1;margin-bottom:.5rem;font-weight:500}
			.cult-form-group input{width:100%;padding:.85rem 1rem;background:#1e293b;
				border:1px solid rgba(148,163,184,.3);border-radius:10px;color:#f1f5f9;font-size:.95rem;
				box-sizing:border-box;-webkit-appearance:none;appearance:none}
			.cult-login-btn,.cult-register-btn{width:100%;padding:.9rem;
				background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;border-radius:10px;
				font-size:.95rem;font-weight:600;cursor:pointer;margin-top:.5rem}
			.cult-login-footer,.cult-register-footer{text-align:center;margin-top:1.5rem;font-size:.85rem;color:#94a3b8}
			.cult-login-footer a,.cult-register-footer a{color:#a78bfa}
			.cult-error-message{padding:.6rem .85rem;background:rgba(239,68,68,.15);color:#f87171;
				border:1px solid rgba(239,68,68,.3);border-radius:8px;font-size:.85rem;margin-bottom:1rem}
			.cult-success-message{padding:.6rem .85rem;background:rgba(16,185,129,.15);color:#34d399;
				border:1px solid rgba(16,185,129,.3);border-radius:8px;font-size:.85rem;margin-bottom:1rem}
			/* 移动端导航 */
			@media(max-width:640px){
				.cult-nav-inner{padding:0 12px;gap:10px;height:56px}
				.cult-nav-link{padding:8px 10px}
			}
		</style>
	</head>
	<body class="cult-body">
		<slot />
	</body>
</html>

<style is:global>
	/* ============================================================
	   设计系统 - CSS Variables
	   ============================================================ */
	.cult-body {
		/* 颜色 */
		--cult-bg: #050811;
		--cult-bg-soft: #0a0f1e;
		--cult-surface: rgba(15, 20, 40, 0.75);
		--cult-surface-hover: rgba(20, 27, 50, 0.85);
		--cult-border: rgba(130, 110, 255, 0.12);
		--cult-border-strong: rgba(130, 110, 255, 0.25);

		/* 主色 - 紫色 */
		--cult-primary: #8b5cf6;
		--cult-primary-soft: rgba(139, 92, 246, 0.15);
		--cult-primary-hover: rgba(139, 92, 246, 0.25);
		--cult-primary-text: #a78bfa;

		/* 强调色 - 金色（星辰币/境界） */
		--cult-gold: #fbbf24;
		--cult-gold-soft: rgba(251, 191, 36, 0.12);
		--cult-gold-text: #fcd34d;

		/* 文字 */
		--cult-text: #f1f5f9;
		--cult-text-secondary: #94a3b8;
		--cult-text-muted: #64748b;

		/* 状态色 */
		--cult-success: #34d399;
		--cult-success-soft: rgba(52, 211, 153, 0.12);
		--cult-warning: #fbbf24;
		--cult-warning-soft: rgba(251, 191, 36, 0.12);
		--cult-danger: #f87171;
		--cult-danger-soft: rgba(248, 113, 113, 0.12);
		--cult-info: #60a5fa;
		--cult-info-soft: rgba(96, 165, 250, 0.12);

		/* 间距 */
		--cult-space-1: 4px;
		--cult-space-2: 8px;
		--cult-space-3: 12px;
		--cult-space-4: 16px;
		--cult-space-5: 20px;
		--cult-space-6: 24px;
		--cult-space-8: 32px;

		/* 圆角 */
		--cult-radius-sm: 8px;
		--cult-radius-md: 12px;
		--cult-radius-lg: 16px;
		--cult-radius-xl: 20px;

		/* 基础样式 */
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background: var(--cult-bg);
		background-image:
			radial-gradient(ellipse at 20% 0%, rgba(99, 102, 241, 0.06) 0%, transparent 50%),
			radial-gradient(ellipse at 80% 100%, rgba(139, 92, 246, 0.04) 0%, transparent 50%);
		color: var(--cult-text);
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB",
			"Microsoft YaHei", sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	.cult-body * {
		box-sizing: border-box;
	}

	.cult-body a {
		color: inherit;
		text-decoration: none;
	}

	.cult-body button {
		font-family: inherit;
		cursor: pointer;
		border: none;
		background: none;
	}

	.cult-body input,
	.cult-body textarea,
	.cult-body select {
		font-family: inherit;
	}

	/* ============================================================
	   可复用组件 - 页面容器
	   ============================================================ */
	.cult-page {
		max-width: 720px;
		margin: 0 auto;
		padding: var(--cult-space-5) var(--cult-space-4) var(--cult-space-8);
	}

	.cult-page-header {
		margin-bottom: var(--cult-space-6);
	}

	.cult-page-title {
		font-size: 28px;
		font-weight: 700;
		margin: 0 0 var(--cult-space-2);
		color: var(--cult-text);
		letter-spacing: -0.02em;
	}

	.cult-page-desc {
		font-size: 14px;
		color: var(--cult-text-secondary);
		margin: 0;
		line-height: 1.6;
	}

	/* ============================================================
	   可复用组件 - 卡片（液态玻璃）
	   ============================================================ */
	.cult-card {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-lg);
		padding: var(--cult-space-5);
		transition: all 0.2s;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
	}

	.cult-card:hover {
		background: rgba(15, 20, 40, 0.55);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
	}

	.cult-card-title {
		font-size: 16px;
		font-weight: 600;
		margin: 0 0 var(--cult-space-3);
		color: var(--cult-text);
	}

	.cult-card-desc {
		font-size: 14px;
		color: var(--cult-text-secondary);
		margin: 0;
		line-height: 1.6;
	}

	/* ============================================================
	   可复用组件 - 统计卡片
	   ============================================================ */
	.cult-stats-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--cult-space-3);
		margin-bottom: var(--cult-space-6);
	}

	.cult-stat-card {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-md);
		padding: var(--cult-space-4);
		display: flex;
		flex-direction: column;
		gap: var(--cult-space-1);
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
	}

	.cult-stat-card:hover {
		background: rgba(15, 20, 40, 0.55);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
	}

	.cult-stat-icon {
		font-size: 18px;
		margin-bottom: var(--cult-space-1);
	}

	.cult-stat-value {
		font-size: 24px;
		font-weight: 700;
		color: var(--cult-text);
		line-height: 1.2;
	}

	.cult-stat-value.gold {
		color: var(--cult-gold-text);
	}

	.cult-stat-label {
		font-size: 12px;
		color: var(--cult-text-muted);
	}

	/* ============================================================
	   可复用组件 - 按钮
	   ============================================================ */
	.cult-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--cult-space-2);
		height: 40px;
		padding: 0 var(--cult-space-4);
		border-radius: var(--cult-radius-sm);
		font-size: 14px;
		font-weight: 500;
		transition: all 0.15s;
		white-space: nowrap;
	}

	.cult-btn:active {
		transform: scale(0.98);
	}

	.cult-btn-primary {
		background: rgba(139, 92, 246, 0.6);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid rgba(139, 92, 246, 0.4);
		color: white;
		box-shadow: 0 4px 16px rgba(139, 92, 246, 0.25);
	}

	.cult-btn-primary:hover {
		background: rgba(139, 92, 246, 0.75);
		border-color: rgba(139, 92, 246, 0.6);
		box-shadow: 0 6px 20px rgba(139, 92, 246, 0.35);
	}

	.cult-btn-primary:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.cult-btn-secondary {
		background: rgba(15, 20, 40, 0.4);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: var(--cult-text);
	}

	.cult-btn-secondary:hover {
		background: rgba(139, 92, 246, 0.25);
		color: var(--cult-text);
		border-color: rgba(139, 92, 246, 0.5);
	}

	.cult-btn-danger {
		background: rgba(248, 113, 113, 0.25);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: var(--cult-danger);
		border: 1px solid rgba(248, 113, 113, 0.35);
	}

	.cult-btn-danger:hover {
		background: rgba(248, 113, 113, 0.35);
		border-color: rgba(248, 113, 113, 0.5);
	}

	.cult-btn-success {
		background: rgba(52, 211, 153, 0.25);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: var(--cult-success);
		border: 1px solid rgba(52, 211, 153, 0.35);
	}

	.cult-btn-sm {
		height: 32px;
		padding: 0 var(--cult-space-3);
		font-size: 13px;
	}

	.cult-btn-block {
		width: 100%;
	}

	/* ============================================================
	   可复用组件 - 状态徽章
	   ============================================================ */
	.cult-badge {
		display: inline-flex;
		align-items: center;
		padding: 2px 10px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
	}

	.cult-badge-success {
		background: var(--cult-success-soft);
		color: var(--cult-success);
	}

	.cult-badge-warning {
		background: var(--cult-warning-soft);
		color: var(--cult-warning);
	}

	.cult-badge-danger {
		background: var(--cult-danger-soft);
		color: var(--cult-danger);
	}

	.cult-badge-info {
		background: var(--cult-info-soft);
		color: var(--cult-info);
	}

	.cult-badge-muted {
		background: rgba(148, 163, 184, 0.1);
		color: var(--cult-text-muted);
	}

	/* ============================================================
	   可复用组件 - 分段控制器
	   ============================================================ */
	.cult-segmented {
		display: flex;
		gap: var(--cult-space-1);
		padding: var(--cult-space-1);
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-md);
		overflow-x: auto;
		scrollbar-width: none;
		margin-bottom: var(--cult-space-4);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
	}

	.cult-segmented::-webkit-scrollbar {
		display: none;
	}

	.cult-segmented-btn {
		flex-shrink: 0;
		padding: 8px 16px;
		border-radius: var(--cult-radius-sm);
		font-size: 13px;
		font-weight: 500;
		color: var(--cult-text-muted);
		background: transparent;
		transition: all 0.15s;
		white-space: nowrap;
	}

	.cult-segmented-btn:hover {
		color: var(--cult-text-secondary);
	}

	.cult-segmented-btn.active {
		background: var(--cult-primary);
		color: white;
	}

	/* ============================================================
	   可复用组件 - 任务卡片
	   ============================================================ */
	.cult-task-card {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-lg);
		padding: var(--cult-space-5);
		margin-bottom: var(--cult-space-3);
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
	}

	.cult-task-card:hover {
		background: rgba(15, 20, 40, 0.55);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
	}

	.cult-task-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--cult-space-3);
		margin-bottom: var(--cult-space-2);
	}

	.cult-task-category {
		font-size: 11px;
		color: var(--cult-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: var(--cult-space-1);
		display: inline-block;
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(148, 163, 184, 0.1);
	}

	.cult-task-category-top {
		color: #f87171;
		background: rgba(248, 113, 113, 0.1);
	}

	.cult-task-category-mid {
		color: #fbbf24;
		background: rgba(251, 191, 36, 0.1);
	}

	.cult-task-category-low {
		color: #34d399;
		background: rgba(52, 211, 153, 0.1);
	}

	.cult-task-filter {
		margin-bottom: var(--cult-space-4);
		display: flex;
		justify-content: flex-end;
	}

	.cult-task-select {
		padding: 8px 14px;
		background: rgba(139, 92, 246, 0.05);
		border: 1px solid rgba(139, 92, 246, 0.2);
		border-radius: 10px;
		color: var(--cult-text);
		font-size: 14px;
		outline: none;
		cursor: pointer;
		transition: all 0.15s;
	}

	.cult-task-select:focus {
		border-color: rgba(139, 92, 246, 0.5);
		background: rgba(139, 92, 246, 0.08);
	}

	.cult-task-select option {
		background: #0f1220;
		color: var(--cult-text);
	}

	.cult-task-title {
		font-size: 18px;
		font-weight: 600;
		color: var(--cult-text);
		margin: 0;
	}

	.cult-task-desc {
		font-size: 14px;
		color: var(--cult-text-secondary);
		margin: 0 0 var(--cult-space-4);
		line-height: 1.6;
	}

	.cult-task-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--cult-space-3);
	}

	.cult-task-reward {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 15px;
		font-weight: 600;
		color: var(--cult-gold-text);
	}

	/* ============================================================
	   可复用组件 - 商品卡片
	   ============================================================ */
	.cult-products-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--cult-space-3);
	}

	.cult-product-card {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-lg);
		padding: var(--cult-space-4);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--cult-space-2);
		transition: all 0.2s;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
	}

	.cult-product-card:hover {
		background: rgba(15, 20, 40, 0.55);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
	}

	.cult-product-icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--cult-primary-soft);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
		margin-bottom: var(--cult-space-2);
	}

	.cult-product-name {
		font-size: 15px;
		font-weight: 600;
		color: var(--cult-text);
		margin: 0;
	}

	.cult-product-desc {
		font-size: 12px;
		color: var(--cult-text-muted);
		margin: 0;
		flex: 1;
	}

	.cult-product-price {
		font-size: 16px;
		font-weight: 700;
		color: var(--cult-gold-text);
		margin: var(--cult-space-2) 0;
	}

	/* ============================================================
	   可复用组件 - 流水记录
	   ============================================================ */
	.cult-tx-list {
		display: flex;
		flex-direction: column;
		gap: var(--cult-space-2);
	}

	.cult-tx-item {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-md);
		padding: var(--cult-space-4);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--cult-space-3);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
	}

	.cult-tx-info {
		display: flex;
		align-items: center;
		gap: var(--cult-space-3);
		flex: 1;
		min-width: 0;
	}

	.cult-tx-icon {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 16px;
		flex-shrink: 0;
	}

	.cult-tx-icon.income {
		background: var(--cult-success-soft);
	}

	.cult-tx-icon.expense {
		background: var(--cult-danger-soft);
	}

	.cult-tx-details {
		min-width: 0;
	}

	.cult-tx-type {
		font-size: 14px;
		font-weight: 500;
		color: var(--cult-text);
		margin: 0 0 2px;
	}

	.cult-tx-meta {
		font-size: 12px;
		color: var(--cult-text-muted);
		margin: 0;
	}

	.cult-tx-amount {
		font-size: 16px;
		font-weight: 600;
		flex-shrink: 0;
	}

	.cult-tx-amount.income {
		color: var(--cult-success);
	}

	.cult-tx-amount.expense {
		color: var(--cult-danger);
	}

	/* ============================================================
	   可复用组件 - 修行状态卡（首页）
	   ============================================================ */
	.cult-profile-card {
		background: rgba(15, 20, 40, 0.45);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--cult-radius-xl);
		padding: var(--cult-space-6);
		margin-bottom: var(--cult-space-5);
		text-align: center;
		position: relative;
		overflow: hidden;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
	}

	.cult-profile-card::before {
		content: "";
		position: absolute;
		top: -50%;
		left: 50%;
		transform: translateX(-50%);
		width: 200px;
		height: 200px;
		background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
		pointer-events: none;
	}

	.cult-avatar-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		display: block;
		margin: 0 auto;
		transition: transform 0.15s;
	}

	.cult-avatar-btn:hover {
		transform: scale(1.05);
	}

	.cult-avatar-btn:active {
		transform: scale(0.98);
	}

	.cult-avatar-core {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: linear-gradient(135deg, #6366f1, #8b5cf6);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28px;
		font-weight: 700;
		color: white;
		margin: 0 auto var(--cult-space-4);
		position: relative;
		box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
		overflow: hidden;
	}

	.cult-avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	.cult-username {
		font-size: 20px;
		font-weight: 700;
		color: var(--cult-text);
		margin: 0 0 var(--cult-space-1);
	}

	.cult-user-role {
		font-size: 13px;
		color: var(--cult-text-secondary);
		margin: 0 0 var(--cult-space-4);
	}

	.cult-realm-display {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		padding: var(--cult-space-3) var(--cult-space-6);
		background: var(--cult-gold-soft);
		border: 1px solid rgba(251, 191, 36, 0.2);
		border-radius: var(--cult-radius-md);
	}

	.cult-realm-label {
		font-size: 11px;
		color: var(--cult-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.cult-realm-name {
		font-size: 18px;
		font-weight: 700;
		color: var(--cult-gold-text);
	}

	/* 境界进度条 */
	.cult-realm-progress {
		margin-top: var(--cult-space-4);
		padding: var(--cult-space-4);
		background: rgba(15, 20, 40, 0.6);
		border: 1px solid rgba(139, 92, 246, 0.15);
		border-radius: var(--cult-radius-md);
	}

	.cult-realm-progress-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-bottom: var(--cult-space-3);
	}

	.cult-realm-current {
		font-size: 13px;
		font-weight: 600;
		color: var(--cult-text-secondary);
	}

	.cult-realm-arrow {
		font-size: 12px;
		color: var(--cult-text-muted);
	}

	.cult-realm-next {
		font-size: 13px;
		font-weight: 600;
		color: var(--cult-gold-text);
	}

	.cult-progress-bar {
		width: 100%;
		height: 6px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 3px;
		overflow: hidden;
		margin-bottom: var(--cult-space-3);
	}

	.cult-progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #8b5cf6, #fbbf24);
		border-radius: 3px;
		transition: width 0.5s ease;
		width: 0%;
	}

	.cult-realm-progress-details {
		display: flex;
		justify-content: space-between;
		gap: var(--cult-space-4);
	}

	.cult-progress-detail {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		flex: 1;
	}

	.cult-progress-label {
		font-size: 11px;
		color: var(--cult-text-muted);
	}

	.cult-progress-value {
		font-size: 12px;
		font-weight: 600;
		color: var(--cult-text-secondary);
		font-family: "JetBrains Mono", monospace;
	}

	.cult-realm-max {
		margin-top: var(--cult-space-4);
		text-align: center;
	}

	.cult-realm-max-text {
		font-size: 13px;
		color: var(--cult-gold-text);
		font-weight: 600;
	}

	/* ============================================================
	   可复用组件 - 空状态
	   ============================================================ */
	.cult-empty {
		text-align: center;
		padding: var(--cult-space-8) var(--cult-space-4);
	}

	.cult-empty-icon {
		font-size: 40px;
		margin-bottom: var(--cult-space-3);
		opacity: 0.5;
	}

	.cult-empty-title {
		font-size: 16px;
		font-weight: 600;
		color: var(--cult-text-secondary);
		margin: 0 0 var(--cult-space-1);
	}

	.cult-empty-desc {
		font-size: 13px;
		color: var(--cult-text-muted);
		margin: 0;
	}

	/* ============================================================
	   移动端背景图
	   ============================================================ */
	@media (max-width: 767px) {
		.cult-body {
			background-image: url("/assets/images/cult-bg-mobile.webp");
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			background-attachment: fixed;
		}
	}

	/* ============================================================
	   桌面端背景图（仙侠夜景 · 横版）
	   第一层是暗色蒙版，保证玻璃卡片上的文字对比度
	   ============================================================ */
	@media (min-width: 768px) {
		.cult-body {
			background-image:
				linear-gradient(
					180deg,
					rgba(5, 8, 17, 0.45) 0%,
					rgba(5, 8, 17, 0.38) 45%,
					rgba(5, 8, 17, 0.58) 100%
				),
				url("/assets/images/cult-bg-desktop.webp");
			background-size: cover, cover;
			background-position: center, center;
			background-repeat: no-repeat, no-repeat;
			background-attachment: fixed, fixed;
		}
	}

	/* ============================================================
	   响应式
	   ============================================================ */
	@media (min-width: 768px) {
		.cult-page {
			max-width: 800px;
			padding: var(--cult-space-6) var(--cult-space-5) var(--cult-space-8);
		}

		.cult-stats-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.cult-products-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.cult-page {
			max-width: 900px;
		}

		.cult-products-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/* ============================================================
	   导航栏全局样式（确保Svelte水合异常时样式仍生效）
	   ============================================================ */
	.cult-nav {
		position: sticky;
		top: 0;
		z-index: 500;
		isolation: isolate;
		background: rgba(5, 8, 17, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(139, 92, 246, 0.1);
	}

	.cult-nav-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 20px;
		height: 64px;
		display: flex !important;
		align-items: center;
		gap: 16px;
	}

	.cult-nav-brand {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
		text-decoration: none;
	}

	.cult-nav-back {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		color: rgba(241, 245, 249, 0.6);
		transition: all 0.15s;
		flex-shrink: 0;
		text-decoration: none;
	}

	.cult-nav-back:hover {
		color: #f1f5f9;
		background: rgba(139, 92, 246, 0.12);
	}

	.cult-nav-brand-icon {
		color: #a78bfa;
	}

	.cult-nav-brand-text {
		font-size: 15px;
		font-weight: 600;
		color: #f1f5f9;
		letter-spacing: 0.03em;
	}

	.cult-nav-links {
		display: flex;
		align-items: center;
		gap: 6px;
		flex: 1;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.cult-nav-links::-webkit-scrollbar {
		display: none;
	}

	.cult-nav-link {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		border-radius: 10px;
		color: rgba(241, 245, 249, 0.5);
		font-size: 14px;
		font-weight: 500;
		white-space: nowrap;
		transition: all 0.15s;
		text-decoration: none;
	}

	.cult-nav-link:hover {
		color: #f1f5f9;
		background: rgba(139, 92, 246, 0.08);
	}

	.cult-nav-link.active {
		color: #a78bfa;
		background: rgba(139, 92, 246, 0.12);
	}

	.cult-nav-user {
		flex-shrink: 0;
	}

	.cult-nav-user-info {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.cult-nav-coins {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 14px;
		background: rgba(251, 191, 36, 0.08);
		border: 1px solid rgba(251, 191, 36, 0.15);
		border-radius: 10px;
		color: #fcd34d;
	}

	.cult-nav-coins svg {
		color: #fcd34d;
	}

	.cult-nav-coins-value {
		font-size: 14px;
		font-weight: 600;
	}

	.cult-nav-avatar-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		transition: transform 0.15s;
	}

	.cult-nav-avatar-btn:hover {
		transform: scale(1.1);
	}

	.cult-nav-avatar-btn:active {
		transform: scale(0.95);
	}

	.cult-nav-user-avatar {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: linear-gradient(135deg, #6366f1, #8b5cf6);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		font-weight: 600;
		color: white;
		overflow: hidden;
	}

	.cult-nav-avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	.cult-nav-login-btn {
		padding: 6px 14px;
		background: #8b5cf6;
		border-radius: 8px;
		color: white;
		font-size: 13px;
		font-weight: 500;
		transition: all 0.15s;
		text-decoration: none;
	}

	.cult-nav-login-btn:hover {
		background: #7c3aed;
	}

	.cult-nav-loading {
		font-size: 13px;
		color: rgba(241, 245, 249, 0.4);
	}

	@media (max-width: 640px) {
		.cult-nav-inner {
			padding: 0 12px;
			gap: 10px;
			height: 56px;
		}
		.cult-nav-brand-text {
			display: none;
		}
		.cult-nav-link-label {
			display: none;
		}
		.cult-nav-link {
			padding: 8px 10px;
		}
		.cult-nav-coins {
			padding: 5px 10px;
		}
		.cult-nav-user-avatar {
			width: 30px;
			height: 30px;
		}
	}

	/* ============================================================
	   登录/注册页面全局样式（防止跳转时样式闪烁）
	   ============================================================ */
	.cult-login-page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.cult-login-card {
		width: 100%;
		max-width: 420px;
		padding: 2.5rem 2rem;
		background: rgba(15, 23, 42, 0.9);
		border: 1px solid rgba(99, 102, 241, 0.25);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
	}

	.cult-login-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.cult-login-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #a78bfa;
	}

	.cult-login-header h1 {
		font-size: 1.5rem !important;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: #f1f5f9;
	}

	.cult-login-header p {
		font-size: 0.9rem !important;
		color: #94a3b8;
		margin: 0;
	}

	.cult-form-group {
		margin-bottom: 1.25rem;
	}

	.cult-form-group label {
		display: block;
		font-size: 0.85rem;
		color: #cbd5e1;
		margin-bottom: 0.5rem;
		font-weight: 500;
	}

	.cult-form-group input {
		width: 100%;
		padding: 0.85rem 1rem;
		background: #1e293b;
		border: 1px solid rgba(148, 163, 184, 0.3);
		border-radius: 10px;
		color: #f1f5f9;
		font-size: 0.95rem;
		box-sizing: border-box;
		transition: all 0.2s;
		-webkit-appearance: none;
		appearance: none;
	}

	.cult-form-group input:focus {
		outline: none;
		border-color: #818cf8;
		background: #1e293b;
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
	}

	.cult-form-group input::placeholder {
		color: #64748b;
	}

	.cult-error-message {
		padding: 0.6rem 0.85rem;
		background: rgba(239, 68, 68, 0.15);
		color: #f87171;
		border: 1px solid rgba(239, 68, 68, 0.3);
		border-radius: 8px;
		font-size: 0.85rem;
		margin-bottom: 1rem;
	}

	.cult-login-btn {
		width: 100%;
		padding: 0.9rem;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: white;
		border: none;
		border-radius: 10px;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
		margin-top: 0.5rem;
	}

	.cult-login-btn:hover:not(:disabled) {
		opacity: 0.92;
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);
	}

	.cult-login-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.cult-login-footer {
		text-align: center;
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: #94a3b8;
	}

	.cult-login-footer p {
		margin: 0.5rem 0;
	}

	.cult-login-footer a {
		color: #a78bfa;
		text-decoration: none;
	}

	.cult-login-footer a:hover {
		text-decoration: underline;
	}

	/* 注册页面样式 */
	.cult-register-page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.cult-register-card {
		width: 100%;
		max-width: 440px;
		padding: 2.5rem 2rem;
		background: rgba(15, 23, 42, 0.9);
		border: 1px solid rgba(99, 102, 241, 0.25);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
	}

	.cult-register-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.cult-register-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #a78bfa;
	}

	.cult-register-header h1 {
		font-size: 1.5rem !important;
		font-weight: 600;
		margin: 0 0 0.5rem 0;
		color: #f1f5f9;
	}

